{% comment %}
  Cart drawer + cart page totals: subtotal, purchase discount with its % chip, shipping and total.
  Copy: Theme settings → Zenith · Cart → Cart summary.
  Purchase discount = Shopify's real discount (cart.total_discount) once the Admin automatic discounts
  exist, and its chip reads the % Shopify applied; until then both come from the tier settings, so the
  total here can be lower than what checkout charges. Shipping adds the flat fee below the free-shipping
  goal (zenith-shipping-goal), so Total = what the customer should expect to pay.
  Shipping amount source (Zenith · Cart): "shopify" (default) prints the flat-fee estimate first, then
  assets/zenith-cart-shipping.js swaps in the cheapest rate Shopify Admin → Shipping quotes for this cart
  (Ajax shipping rates API) and fixes Total; "theme" = legacy flat fee only. The free-shipping bar's
  threshold stays a theme setting either way.
{% endcomment %}
{%- capture zcsum_pct -%}{%- render 'zenith-cart-tier-pct' -%}{%- endcapture -%}
{%- capture zcsum_goal -%}{%- render 'zenith-shipping-goal' -%}{%- endcapture -%}
{%- capture zcsum_tiers -%}{%- render 'zenith-cart-tiers-on' -%}{%- endcapture -%}
{%- liquid
  assign zcsum_pct = zcsum_pct | plus: 0
  assign zcsum_goal = zcsum_goal | plus: 0

  assign zcsum_sub = 0
  for item in cart.items
    assign zcsum_sub = zcsum_sub | plus: item.original_line_price
  endfor

  if cart.total_discount > 0
    assign zcsum_disc = cart.total_discount
    # Chip = the biggest % Shopify actually applied, so a 50% discount in Admin reads 50% here.
    assign zcsum_real = 0
    for zcsum_app in cart.discount_applications
      if zcsum_app.value_type == 'percentage' and zcsum_app.total_allocated_amount > 0
        assign zcsum_val = zcsum_app.value | plus: 0
        if zcsum_val > zcsum_real
          assign zcsum_real = zcsum_val
        endif
      endif
    endfor
    assign zcsum_pct = zcsum_real
  else
    assign zcsum_disc = zcsum_sub | times: zcsum_pct | divided_by: 100.0 | round
  endif
  assign zcsum_paid = zcsum_sub | minus: zcsum_disc

  assign zcsum_fee = 0
  assign zcsum_ship_on = false
  if zcsum_goal > 0 and cart.item_count > 0
    if zcsum_paid >= zcsum_goal
      assign zcsum_ship_on = true
    else
      assign zcsum_fee = settings.cart_shipping_fee | times: 100
    endif
  endif
  assign zcsum_total = zcsum_paid | plus: zcsum_fee
  assign zcsum_live = false
  if settings.cart_shipping_source != 'theme' and cart.item_count > 0
    assign zcsum_live = true
  endif
-%}
<div
  class="zenith-cart-sum"
  role="status"
  {%- if zcsum_live %}
    data-zcship="{{ settings.cart_shipping_country | default: 'PH' | escape }}"
    data-zcship-province="{{ settings.cart_shipping_province | escape }}"
    data-zcship-zip="{{ settings.cart_shipping_zip | escape }}"
    data-zcship-key="{{ cart.total_price }}-{{ cart.item_count }}-{{ cart.total_weight }}"
    data-zcship-paid="{{ zcsum_paid }}"
    data-zcship-free="{{ settings.cart_summary_free | escape }}"
    data-zcship-later="{{ settings.cart_summary_ship_later | escape }}"
    data-zcship-format="{{ shop.money_format | strip_html | escape }}"
  {%- endif %}
>
  <div class="zenith-cart-sum__row">
    <span>{{ settings.cart_summary_subtotal | escape }}</span>
    <span>{{ zcsum_sub | money }}</span>
  </div>
  {%- if zcsum_tiers != blank or zcsum_disc > 0 -%}
    <div class="zenith-cart-sum__row">
      <span>
        {{- settings.cart_summary_discount | escape -}}
        {%- if zcsum_pct > 0 -%}
          {%- assign zcsum_num = zcsum_pct | round: 1 | append: '' | remove: '.0' -%}
          {%- assign zcsum_tag = settings.cart_offers_tier_label | default: '[percent]% off' | replace: '[percent]', zcsum_num -%}
          <span class="zenith-cart-sum__tag">{{ zcsum_tag | escape | upcase }}</span>
        {%- endif -%}
      </span>
      <span class="zenith-cart-sum__gold">
        {%- if zcsum_disc > 0 -%}−{{ zcsum_disc | money }}{%- else -%}—{%- endif -%}
      </span>
    </div>
  {%- endif -%}
  {%- if zcsum_goal > 0 or zcsum_live -%}
    <div class="zenith-cart-sum__row">
      <span>{{ settings.cart_summary_shipping | escape }}</span>
      {%- if zcsum_live -%}
        <span data-zcship-value class="zenith-cart-sum__est{% if zcsum_ship_on %} zenith-cart-sum__ok{% endif %}">
          {%- if zcsum_ship_on -%}
            {{ settings.cart_summary_free | escape }}
          {%- elsif zcsum_fee > 0 -%}
            {{ zcsum_fee | money }}
          {%- else -%}
            {{ settings.cart_summary_ship_later | escape }}
          {%- endif -%}
        </span>
      {%- elsif zcsum_ship_on -%}
        <span class="zenith-cart-sum__ok">{{ settings.cart_summary_free | escape }}</span>
      {%- elsif zcsum_fee > 0 -%}
        <span>{{ zcsum_fee | money }}</span>
      {%- else -%}
        <span>{{ settings.cart_summary_ship_later | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="zenith-cart-sum__row zenith-cart-sum__total">
    <span>{{ settings.cart_summary_total | escape }}</span>
    <span{% if zcsum_live %} data-zcship-total class="zenith-cart-sum__est"{% endif %}>{{ zcsum_total | money }}</span>
  </div>
</div>
