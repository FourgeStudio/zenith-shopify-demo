{% comment %}
  Line icon set (1.5px stroke, currentColor).
  Accepts: icon {String}, class {String} optional
  Usage: {% render 'zenith-icon', icon: 'shield' %}
{% endcomment %}
{%- liquid
  assign classes = 'zenith-icon'
  if class != blank
    assign classes = classes | append: ' ' | append: class
  endif
-%}
{%- case icon -%}
  {%- when 'star' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>
  {%- when 'verified_seal' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke-width="3.2" d="M4.1 8.7a3.9 3.9 0 0 1 4.6-4.6 3.9 3.9 0 0 1 6.6 0 3.9 3.9 0 0 1 4.6 4.6 3.9 3.9 0 0 1 0 6.6 3.9 3.9 0 0 1-4.6 4.6 3.9 3.9 0 0 1-6.6 0 3.9 3.9 0 0 1-4.6-4.6 3.9 3.9 0 0 1 0-6.6Z"/><path stroke-width="2.8" d="m8.6 12.1 2.6 2.6 4.4-4.9"/></svg>
