{% comment %}
  Line icon set (1.5px stroke, currentColor).
  Accepts: icon {String}, class {String} optional
  Usage: {% render 'zenith-icon', icon: 'shield' %}
{% endcomment %}
{%- liquid
  assign classes = 'zenith-icon'
  if class != blank
    assign classes = classes | append: ' ' | append: class
  endif
-%}
{%- case icon -%}
  {%- when 'star' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>
  {%- when 'play' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5z"/></svg>
  {%- else -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      {%- case icon -%}
        {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
        {%- when 'check_circle' -%}<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16.5 9.5"/>
        {%- when 'shield' -%}<path d="M12 3l7.5 3v5.5c0 4.5-3.2 8.2-7.5 9.5-4.3-1.3-7.5-5-7.5-9.5V6z"/><path d="M8.8 12.2l2.3 2.3 4.2-4.3"/>
        {%- when 'truck' -%}<path d="M2.5 6.5h11v9.5h-11zM13.5 10h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/>
        {%- when 'cash' -%}<rect x="2.5" y="6" width="19" height="12" rx="1"/><circle cx="12" cy="12" r="2.8"/><path d="M6 9.5v5M18 9.5v5"/>
        {%- when 'certified' -%}<circle cx="12" cy="10" r="6"/><path d="M9.5 10l1.8 1.8 3.2-3.3M8.5 15l-1.5 6 5-2.5 5 2.5-1.5-6"/>
        {%- when 'leaf' -%}<path d="M5 19c0-8 5.5-14 15-14 0 9.5-6 15-14 15"/><path d="M5 19c3-3 6-6 9.5-8.5"/>
        {%- when 'flag' -%}<path d="M5 21V4M5 4.5h12.5l-2.5 4 2.5 4H5"/>
        {%- when 'refresh' -%}<path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v4.5h-4.5"/>
        {%- when 'lock' -%}<rect x="4.5" y="10.5" width="15" height="10" rx="1"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
        {%- when 'box' -%}<path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5zM3.5 7.5L12 12l8.5-4.5M12 12v9"/>
        {%- when 'droplet' -%}<path d="M12 3s6.5 7 6.5 11.5a6.5 6.5 0 0 1-13 0C5.5 10 12 3 12 3z"/>
        {%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>
        {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5.5l3.5 2"/>
        {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1-4.5 4.2-7 8-7s7 2.5 8 7"/>
        {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4z"/>
        {%- when 'gift' -%}<rect x="3.5" y="8" width="17" height="4"/><path d="M5 12v8.5h14V12M12 8v12.5M12 8C10.5 4 7 4 7 6s3 2 5 2zm0 0c1.5-4 5-4 5-2s-3 2-5 2z"/>
        {%- when 'arrow_left' -%}<path d="M19 12H5M11 5.5L4.5 12l6.5 6.5"/>
        {%- when 'arrow_right' -%}<path d="M5 12h14M13 5.5l6.5 6.5-6.5 6.5"/>
        {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
        {%- when 'chevron_right' -%}<path d="M9 5l7 7-7 7"/>
        {%- when 'chevron_left' -%}<path d="M15 5l-7 7 7 7"/>
        {%- when 'mail' -%}<rect x="3" y="5.5" width="18" height="13" rx="1"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>
        {%- else -%}<circle cx="12" cy="12" r="9"/>
      {%- endcase -%}
    </svg>
{%- endcase -%}
