  {%- when 'tiktok_shop' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8.6 7.2V6.4a3.4 3.4 0 0 1 6.8 0v.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M3.8 7.2h16.4l-1 13a1.6 1.6 0 0 1-1.6 1.5H6.4a1.6 1.6 0 0 1-1.6-1.5z" fill="currentColor"/><path d="M12.9 9.6v6.3a1.9 1.9 0 1 1-1.9-1.9M12.9 9.6c.3 1.4 1.3 2.3 2.7 2.4" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--z-icon-cut, #111)"/></svg>
