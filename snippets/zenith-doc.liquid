{%- comment -%}
  Document layout for policies (layout/theme.liquid) and text pages (sections/zenith-main-document.liquid):
  title + "Last updated" band, optional Table of Contents built from the body's headings, styled body text.
  Accepts:
    title {String}, body {String} HTML
    id {String} unique suffix
    show_toc {Boolean}, toc_heading {String}
    titlecase {Boolean} optional: "Privacy policy" → "Privacy Policy" (Shopify's policy titles)
    class {String} optional extra root classes (zenith-doc--center = centred column, color-scheme-x)
    vars {String} optional CSS custom properties for the root (--z-doc-*: see assets/zenith-doc.css)
  Content rules (so the client can paste policy text as is):
    - a first heading that repeats the title (or contains it, e.g. "Zenith Philippines Privacy Policy") is dropped
    - a first paragraph/heading starting "Last updated" / "Effective date" moves under the title (split at a line break)
    - the Table of Contents lists the heading type (h1–h4) with the most non-empty headings; empty headings are skipped
{%- endcomment -%}
{%- liquid
  assign doc_body = body | strip

  # Drop a leading heading that repeats the title
  assign lead = doc_body | slice: 0, 3 | downcase
  if lead == '<h1' or lead == '<h2' or lead == '<h3'
    assign lead_level = doc_body | slice: 2, 1
    assign lead_close = '</h' | append: lead_level | append: '>'
    assign lead_heading = doc_body | split: lead_close | first | append: lead_close
    assign lead_text = lead_heading | strip_html | strip | downcase
    assign title_text = title | strip_html | strip | downcase
    # "Terms of Service" = "Terms of service"; "Zenith Philippines Privacy Policy" contains "privacy policy"
    if lead_text contains title_text or title_text contains lead_text
      assign doc_body = doc_body | remove_first: lead_heading | strip
    endif
  endif

  # Shopify names policies in sentence case ("Privacy policy") → "Privacy Policy" (small words stay lower case)
  assign doc_title = title | strip
  if titlecase
    assign small_words = ' a an and as at by for in of on or the to with '
    assign doc_title = ''
    assign title_words = title | strip | split: ' '
    for word in title_words
      assign probe_word = ' ' | append: word | downcase | append: ' '
      if forloop.first == false and small_words contains probe_word
        assign doc_title = doc_title | append: ' ' | append: word
      else
        assign first_letter = word | slice: 0 | upcase
        assign rest_letters = word | slice: 1, 200
        assign doc_title = doc_title | append: ' ' | append: first_letter | append: rest_letters
      endif
    endfor
    assign doc_title = doc_title | strip
  endif

  # "Last updated …" as the first paragraph or heading → shown under the title.
  # Also handles it sharing a heading with the next title: <h3>Last updated: …<br><br>Introduction</h3>
  assign updated = ''
  assign first_close = ''
  assign lead = doc_body | slice: 0, 2 | downcase
  if lead == '<p'
    assign first_close = '</p>'
  elsif lead == '<h'
    assign lead_level = doc_body | slice: 2, 1
    if '123456' contains lead_level
      assign first_close = '</h' | append: lead_level | append: '>'
    endif
  endif
  if first_close != ''
    assign first_el = doc_body | split: first_close | first | append: first_close
    assign first_text = first_el | strip_html | strip
    assign probe = first_text | slice: 0, 12 | downcase
    if probe == 'last updated' or probe == 'effective da'
      if first_el contains '<br'
        assign br_parts = first_el | split: '<br'
        assign updated = br_parts | first | strip_html | strip
        assign tail = br_parts | last
        assign tail_pre = tail | split: '>' | first
        assign tail = tail | remove_first: tail_pre | remove_first: '>'
        assign open_tag = first_el | split: '>' | first | append: '>'
        assign new_el = open_tag | append: tail
        assign new_text = new_el | strip_html | strip
        if new_text == blank
          assign new_el = ''
        endif
        assign doc_body = doc_body | replace_first: first_el, new_el | strip
      else
        assign updated = first_text
        assign doc_body = doc_body | remove_first: first_el | strip
      endif
    endif
  endif

  # Table of Contents: ids on the headings + the list, rendered here (no layout shift).
  # Level = the heading type (h1–h4) with the most non-empty headings, so a stray empty <h1> doesn't win.
  assign toc_items = ''
  if show_toc
    assign toc_level = ''
    assign toc_best = 0
    for n in (1..4)
      assign h_open = '<h' | append: n
      assign h_close = '</h' | append: n | append: '>'
      unless doc_body contains h_open
        continue
      endunless
      assign level_count = 0
      assign parts = doc_body | split: h_open
      for part in parts
        if forloop.first
          continue
        endif
        assign inner = part | split: h_close | first
        assign text = h_open | append: inner | append: h_close | strip_html | strip
        if text != blank
          assign level_count = level_count | plus: 1
        endif
      endfor
      if level_count > toc_best
        assign toc_best = level_count
        assign toc_level = n
      endif
    endfor
    if toc_level != ''
      assign h_open = '<h' | append: toc_level
      assign h_close = '</h' | append: toc_level | append: '>'
      # split keeps the text before the first heading (empty when the body starts with one) as the first part
      assign parts = doc_body | split: h_open
      assign rebuilt = parts | first
      assign used = ','
      for part in parts
        if forloop.first or part == blank
          continue
        endif
        assign inner = part | split: h_close | first
        assign text = h_open | append: inner | append: h_close | strip_html | strip
        if text == blank
          assign rebuilt = rebuilt | append: h_open | append: part
          continue
        endif
        assign slug = text | handleize | default: 'section'
        assign needle = ',' | append: slug | append: ','
        if used contains needle
          assign slug = slug | append: '-' | append: forloop.index
        endif
        assign used = used | append: slug | append: ','
        assign rebuilt = rebuilt | append: h_open | append: ' id="' | append: slug | append: '"' | append: part
        assign link_class = 'zenith-doc__toc-link'
        if toc_items == blank
          assign link_class = 'zenith-doc__toc-link is-active'
        endif
        capture toc_item
          echo '<li><a class="' | append: link_class | append: '" href="#' | append: slug | append: '">' | append: text | append: '</a></li>'
        endcapture
        assign toc_items = toc_items | append: toc_item
      endfor
      assign doc_body = rebuilt
    endif
  endif
-%}
{{ 'zenith-doc.css' | asset_url | stylesheet_tag }}
<div
  class="zenith-doc{% if toc_items != blank %} zenith-doc--toc{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  id="ZenithDoc-{{ id }}"
  {% if vars != blank %}
    style="{{ vars | strip_newlines }}"
  {% endif %}
>
  <div class="zenith-doc__hero">
    <div class="page-width">
      <div class="zenith-doc__frame">
        <h1 class="zenith-doc__title">{{ doc_title | escape }}</h1>
        {%- if updated != blank -%}
          <p class="zenith-doc__updated">{{ updated | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
  <div class="page-width">
    <div class="zenith-doc__frame zenith-doc__layout">
      {%- if toc_items != blank -%}
        <zenith-doc-toc class="zenith-doc__toc">
          <nav aria-labelledby="ZenithDocToc-{{ id }}">
            <h2 class="zenith-doc__toc-title" id="ZenithDocToc-{{ id }}">{{ toc_heading | default: 'Table of Contents' | escape }}</h2>
            <ol class="zenith-doc__toc-list" role="list">
              {{- toc_items -}}
            </ol>
          </nav>
        </zenith-doc-toc>
      {%- endif -%}
      <div class="zenith-doc__body rte">
        {{- doc_body | replace: '[customers]', settings.customer_count -}}
      </div>
    </div>
  </div>
</div>
{%- if toc_items != blank -%}
  <script src="{{ 'zenith-doc.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
