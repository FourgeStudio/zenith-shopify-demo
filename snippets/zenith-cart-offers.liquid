{% comment %}
  Cart drawer + cart page goal panel: a box (truck, what is unlocked, how far the next goal is) and a
  stepper with one checkpoint per goal — free shipping, then each % off tier.
  Free shipping follows zenith-shipping-goal (₱900 during a promotion, ₱1,200 otherwise). The tiers show
  when zenith-cart-tiers-on says so (Theme settings → Zenith · Cart → Show the % off tiers).
  Checkpoints are evenly spaced; the stretch to the first one is twice as wide. The fill moves in a
  straight line between two checkpoints, so it always meets a dot exactly when its goal is reached.
  Renders nothing when the cart is empty or there is no goal at all.

  DISPLAY ONLY. The theme cannot apply a discount. Each tier needs a matching automatic discount in
  Admin → Discounts (Amount off products, minimum purchase amount, not combinable with other product
  discounts, combinable with shipping discounts). Until those exist the drawer shows the estimate from
  the tier settings and checkout charges full price.
  Dawn re-renders .drawer__inner (drawer) and main-cart-items .js-contents (cart page) on every cart
  change, so this updates with no JS. Accepts: context ('page' = cart page spacing).
{% endcomment %}
{%- capture zco_on -%}{%- render 'zenith-cart-tiers-on' -%}{%- endcapture -%}
{%- capture zco_goal -%}{%- render 'zenith-shipping-goal' -%}{%- endcapture -%}
{%- capture zco_pct -%}{%- render 'zenith-cart-tier-pct' -%}{%- endcapture -%}
{%- capture zco_tiers -%}{%- render 'zenith-cart-tiers' -%}{%- endcapture -%}
{%- liquid
  assign zco_goal = zco_goal | plus: 0
  assign zco_pct = zco_pct | plus: 0
  assign zco_tiers = zco_tiers | strip | split: ','

  # Subtotal before any discount (the tiers are spend goals on the full price).
  assign zco_sub = 0
  for item in cart.items
    assign zco_sub = zco_sub | plus: item.original_line_price
  endfor

  # Free shipping is judged after the discount: Shopify's real one once it exists, the tier estimate until then.
  if cart.total_discount > 0
    assign zco_paid = cart.total_price
  else
    assign zco_off = zco_sub | times: zco_pct | divided_by: 100.0 | round
    assign zco_paid = zco_sub | minus: zco_off
  endif
  assign zco_ship_on = false
  if zco_goal > 0 and zco_paid >= zco_goal
    assign zco_ship_on = true
  endif

  assign zco_ship_label = settings.cart_offers_ship_label | default: 'Free Shipping' | escape
  assign zco_tier_label = settings.cart_offers_tier_label | default: '[percent]% off' | escape

  # Checkpoints as parallel lists: amount (cents) | label | reached. Free shipping first, then each tier.
  assign zco_amts = ''
  assign zco_names = ''
  assign zco_hits = ''
  if zco_goal > 0
    assign zco_amts = zco_goal | append: '|'
    assign zco_names = settings.cart_offers_ship_short | default: zco_ship_label | escape | append: '|'
    assign zco_hits = zco_ship_on | append: '|'
  endif
  if zco_on != blank
    for zco_tier in zco_tiers
      assign zco_parts = zco_tier | split: ':'
      assign zco_tmin = zco_parts[0] | times: 100
      assign zco_tpct = zco_parts[1] | plus: 0
      if zco_tmin > 0 and zco_tpct > 0
        assign zco_hit = false
        if zco_sub >= zco_tmin
          assign zco_hit = true
        endif
        assign zco_amts = zco_amts | append: zco_tmin | append: '|'
        assign zco_names = zco_names | append: zco_tier_label | replace: '[percent]', zco_tpct | append: '|'
        assign zco_hits = zco_hits | append: zco_hit | append: '|'
      endif
    endfor
  endif
  assign zco_amts = zco_amts | split: '|'
  assign zco_names = zco_names | split: '|'
  assign zco_hits = zco_hits | split: '|'
  assign zco_n = zco_amts.size
-%}
{%- if zco_n > 0 -%}
  {%- liquid
    # Nearest goal still ahead: free shipping by what is paid, a tier by the full-price subtotal.
    assign zco_next_left = 0
    assign zco_next_offer = ''
    if zco_goal > 0 and zco_ship_on == false
      assign zco_next_left = zco_goal | minus: zco_paid
      assign zco_next_offer = zco_ship_label
    endif
    if zco_on != blank
      for zco_tier in zco_tiers
        assign zco_parts = zco_tier | split: ':'
        assign zco_tmin = zco_parts[0] | times: 100
        assign zco_tpct = zco_parts[1] | plus: 0
        if zco_tmin > 0 and zco_tpct > zco_pct and zco_sub < zco_tmin
          assign zco_left = zco_tmin | minus: zco_sub
          if zco_next_left == 0 or zco_left < zco_next_left
            assign zco_next_left = zco_left
            assign zco_next_offer = zco_tier_label | replace: '[percent]', zco_tpct
          endif
        endif
      endfor
    endif

    # What is unlocked so far: "Free Shipping + 10% Off".
    assign zco_done = ''
    if zco_ship_on
      assign zco_done = zco_ship_label
    endif
    if zco_pct > 0
      assign zco_tier_now = zco_tier_label | replace: '[percent]', zco_pct
      if zco_done != ''
        assign zco_done = zco_done | append: ' + '
      endif
      assign zco_done = zco_done | append: zco_tier_now
    endif

    if zco_done == ''
      assign zco_title_offer = zco_next_offer
      assign zco_title = settings.cart_offers_title_next | default: 'Unlock [offer]'
    else
      assign zco_title_offer = zco_done
      assign zco_title = settings.cart_offers_title_done | default: '[offer] Unlocked!'
    endif
    # Title case for the headline only ("10% off" → "10% Off").
    capture zco_title_offer
      assign zco_words = zco_title_offer | split: ' '
      for zco_word in zco_words
        echo zco_word | capitalize
        unless forloop.last
          echo ' '
        endunless
      endfor
    endcapture
    assign zco_title = zco_title | escape | replace: '[offer]', zco_title_offer

    # Units: the first stretch is 2 wide, every later one 1, so checkpoint k sits at (k + 1) / (n + 1).
    assign zco_units = zco_n | plus: 1
    assign zco_fill = 0
    assign zco_prev_amt = 0
    assign zco_prev_pos = 0
    for zco_amt_s in zco_amts
      # Shopify ignores reassigning a for-loop variable, so the number goes under a new name.
      assign zco_amt = zco_amt_s | plus: 0
      assign zco_pos = forloop.index | plus: 1 | times: 100.0 | divided_by: zco_units
      if zco_sub >= zco_amt
        assign zco_fill = zco_pos
      else
        if zco_sub > zco_prev_amt
          assign zco_span = zco_amt | minus: zco_prev_amt
          assign zco_part = zco_sub | minus: zco_prev_amt | times: 1.0 | divided_by: zco_span
          assign zco_fill = zco_pos | minus: zco_prev_pos | times: zco_part | plus: zco_prev_pos
        endif
        break
      endif
      assign zco_prev_amt = zco_amt
      assign zco_prev_pos = zco_pos
    endfor
    # The bar always shows a start (10%), empty cart included
    if zco_fill < 10
      assign zco_fill = 10
    endif
    assign zco_fill = zco_fill | round: 1
  -%}
  <div class="zenith-cart-offers{% if context == 'page' %} zenith-cart-offers--page{% endif %}">
    <div class="zenith-cart-offers__box">
      <svg
        class="zenith-cart-offers__van"
        viewBox="0 0 32 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <g><path d="M9 5h13v13H9zM22 9h4.5l3.5 4v5h-8"/><path d="M24 9.5v3.5h5"/></g>
        <g class="zenith-cart-offers__van-speed"><path d="M1 8h5M3 12h4M1 16h5"/></g>
        <circle class="zenith-cart-offers__van-wheel" cx="13" cy="18.5" r="2.2"/>
        <circle class="zenith-cart-offers__van-wheel" cx="26" cy="18.5" r="2.2"/>
      </svg>
      <div class="zenith-cart-offers__box-text">
        <p class="zenith-cart-offers__title">{{ zco_title }}</p>
        <p class="zenith-cart-offers__msg" role="status">
          {%- if zco_next_offer != '' -%}
            {%- capture zco_money -%}<strong>{{ zco_next_left | money }}</strong>{%- endcapture -%}
            {%- capture zco_offer -%}<strong>{{ zco_next_offer }}</strong>{%- endcapture -%}
            {{- settings.cart_offers_next | escape | replace: '[amount]', zco_money | replace: '[offer]', zco_offer -}}
          {%- else -%}
            {{- settings.cart_offers_done | escape -}}
          {%- endif -%}
        </p>
      </div>
    </div>

    {%- assign zco_gap = 100.0 | divided_by: zco_units | round: 2 -%}
    <div class="zenith-cart-offers__steps" style="--zco-gap: {{ zco_gap }}%" aria-hidden="true">
      <div class="zenith-cart-offers__track">
        <div class="zenith-cart-offers__fill" style="width: {{ zco_fill }}%"></div>
      </div>
      {%- for zco_amt in zco_amts -%}
        {%- assign zco_i = forloop.index0 -%}
        {%- assign zco_pos = forloop.index | plus: 1 | times: 100.0 | divided_by: zco_units | round: 1 -%}
        <span
          class="zenith-cart-offers__step{% if zco_hits[zco_i] == 'true' %} is-reached{% endif %}{% if forloop.last %} is-end{% endif %}"
          style="left: {{ zco_pos }}%"
        >
          <span class="zenith-cart-offers__step-label">{{ zco_names[zco_i] }}</span>
          <span class="zenith-cart-offers__step-dot">
            {%- if zco_hits[zco_i] == 'true' -%}
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M2.5 6.2 5 8.5l4.5-5"/></svg>
            {%- endif -%}
          </span>
        </span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
