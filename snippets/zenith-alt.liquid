{%- liquid
  assign za_alt = image.alt
  if za_alt == blank and image != blank
    assign za_file = image | image_url | split: '?' | first | split: '/' | last
    if scope != blank
      assign za_file = scope | append: ':' | append: za_file
    endif
    assign za_lines = za_map | newline_to_br | split: '<br />'
    for za_line in za_lines
      assign za_pair = za_line | strip | split: ' => '
      if za_pair.size == 2 and za_file contains za_pair[0]
        assign za_alt = za_pair[1]
        break
      endif
    endfor
  endif
  echo za_alt | default: fallback
-%}
