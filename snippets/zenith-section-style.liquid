{% comment %}
  Per-instance CSS variables scoped to the section's unique id.
  Any setting listed in `map` that exists on the section becomes a CSS variable,
  so sections only need to add the setting to their schema and use the variable in CSS.
  Accepts: section {Object}, extra {String} optional extra declarations
  Root element must have id="Zenith-{{ section.id }}" and class "zenith-section".

  map entry format: setting_id:css-var-suffix:unit
{% endcomment %}
{%- liquid
  assign map = 'heading_font_size:hfs:px,heading_font_size_mobile:hfs-m:px,subheading_font_size:sfs:px,subheading_font_size_mobile:sfs-m:px,eyebrow_font_size:efs:px,heading_max_width:hmw:px,heading_spacing:hsp:px,heading_spacing_mobile:hsp-m:px,text_font_size:tfs:px,text_font_size_mobile:tfs-m:px,title_font_size:ttfs:px,title_font_size_mobile:ttfs-m:px,price_font_size:pfs:px,price_font_size_mobile:pfs-m:px,gap:gap:px,gap_mobile:gap-m:px,content_max_width:cmw:px,content_gap:cgap:px,content_gap_mobile:cgap-m:px,content_padding:cpd:px,content_padding_mobile:cpd-m:px,icon_size:icon:px,icon_size_mobile:icon-m:px,image_max_width:imw:px,image_max_height:imh:px,image_max_height_mobile:imh-m:px,countdown_font_size:cdfs:px,countdown_font_size_mobile:cdfs-m:px,logo_max_width:lmw:px,logo_width:logow:px,media_width:mw:%,media_width_mobile:mw-m:%,media_min_height:mmh:px,media_height_mobile:mh-m:px,image_padding:ipd:px,item_padding:ipad:px,item_padding_mobile:ipad-m:px' | split: ','
-%}
{%- style -%}
  #Zenith-{{ section.id }} {
    --z-pt: {{ section.settings.padding_top }}px;
    --z-pb: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.padding_top_mobile != blank %}
    --z-pt-m: {{ section.settings.padding_top_mobile }}px;
    --z-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    {%- else %}
    --z-pt-m: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --z-pb-m: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {%- endif %}
    {%- for entry in map -%}
      {%- assign parts = entry | split: ':' -%}
      {%- assign value = section.settings[parts[0]] -%}
      {%- if value != blank %}
    --z-{{ parts[1] }}: {{ value }}{{ parts[2] }};
      {%- endif -%}
    {%- endfor %}
    {{ extra }}
  }
{%- endstyle -%}
