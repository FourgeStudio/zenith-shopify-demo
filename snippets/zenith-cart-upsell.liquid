{% comment %}
  "Best used with" under the cart items (drawer + cart page). Automatic: assets/zenith-cart-upsell.js
  asks Shopify's product recommendations for the newest cart product (then the next ones until the list
  is full) — complementary products from the Search & Discovery app first, then Shopify's automatic
  "related" picks — skips anything already in the cart and shows up to Theme settings → Zenith · Cart →
  Best used with → Products shown. Every cart change re-renders this, so it refills with the next
  product after each add. Answers are cached per product for the page view, so re-renders do not refetch.
  In the drawer it must sit outside #CartDrawer-Form (each row is its own add-to-cart form).
  Accepts: context ('page' = cart page; the rows then post normally and reload /cart).
{% endcomment %}
{%- liquid
  assign zcu_max = settings.cart_upsell_max | default: 2
  assign zcu_ids = cart.items | map: 'product_id' | uniq | join: ','
-%}
{%- if cart == empty and zcu_max > 0 and context != 'page' -%}
  {%- comment -%}
    Empty drawer: nothing to base recommendations on → Theme settings → Zenith · Cart → Suggestions when the cart
    is empty (else the first products of the store), rendered here with the same rows.
  {%- endcomment -%}
  {%- liquid
    assign zcu_list = settings.cart_upsell_empty_products
    if zcu_list == blank or zcu_list.count == 0
      assign zcu_list = collections.all.products
    endif
  -%}
  <div class="zenith-cart-upsell zenith-cart-upsell--empty">
    {%- if settings.cart_upsell_heading != blank -%}
      <p class="zenith-cart-upsell__heading">{{ settings.cart_upsell_heading | escape }}</p>
    {%- endif -%}
    <ul class="zenith-cart-upsell__list" role="list">
      {%- for zcu_product in zcu_list limit: zcu_max -%}
        {%- if zcu_product.available -%}
          {%- render 'zenith-cart-upsell-item', product: zcu_product -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- elsif cart != empty and zcu_max > 0 -%}
  <zenith-cart-upsell
    class="zenith-cart-upsell{% if context == 'page' %} zenith-cart-upsell--page{% endif %}"
    data-product-ids="{{ zcu_ids }}"
    data-max="{{ zcu_max }}"
    {% if context == 'page' %}
      data-context="page"
    {% endif %}
    hidden
  >
    {%- if settings.cart_upsell_heading != blank -%}
      <p class="zenith-cart-upsell__heading">{{ settings.cart_upsell_heading | escape }}</p>
    {%- endif -%}
    <ul class="zenith-cart-upsell__list" role="list"></ul>
  </zenith-cart-upsell>
{%- endif -%}
