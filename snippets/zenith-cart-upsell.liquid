{% comment %}
  "Best used with" under the cart items (drawer + cart page), picked in Liquid so it re-renders with every cart change:
    1. products from the collections of the cart's products (newest cart line first), skipping catch-all collections
       (all / frontpage / a collection holding the whole catalogue);
    2. only when none of those is left: products from the store's other collections (at least 1).
  Skips products already in the cart and sold-out ones; shows up to Theme settings → Zenith · Cart → Most products shown (1–3).
  Empty cart: nothing is shown.
  In the drawer it must sit outside #CartDrawer-Form (each row is its own add-to-cart form).
  Accepts: context ('page' = cart page: rows use Shopify's /cart/add link, because they sit inside form#cart).
{% endcomment %}
{%- liquid
  assign zcu_max = settings.cart_upsell_max | default: 3
  assign zcu_in_cart = cart.items | map: 'product_id' | join: ','
  assign zcu_in_cart = ',' | append: zcu_in_cart | append: ','
  assign zcu_all_count = collections.all.products_count
  assign zcu_picked = ','
  assign zcu_count = 0

  if zcu_max > 0
    if cart.item_count > 0
      # Pass 1: the cart products' own collections, newest line first
      assign zcu_lines = cart.items | reverse
      for line in zcu_lines
        for c in line.product.collections
          if zcu_count >= zcu_max
            break
          endif
          if c.handle == 'all' or c.handle == 'frontpage' or c.products_count >= zcu_all_count
            continue
          endif
          for p in c.products
            if zcu_count >= zcu_max
              break
            endif
            assign zcu_key = ',' | append: p.id | append: ','
            assign zcu_hkey = ',' | append: p.handle | append: ','
            unless zcu_in_cart contains zcu_key or zcu_picked contains zcu_hkey
              if p.available
                assign zcu_picked = zcu_picked | append: p.handle | append: ','
                assign zcu_count = zcu_count | plus: 1
              endif
            endunless
          endfor
        endfor
      endfor

      # Pass 2 (only when nothing related is left): the store's other products, so there is always at least 1
      if zcu_count == 0
        for p in collections.all.products
          if zcu_count >= zcu_max
            break
          endif
          assign zcu_key = ',' | append: p.id | append: ','
          assign zcu_hkey = ',' | append: p.handle | append: ','
          unless zcu_in_cart contains zcu_key or zcu_picked contains zcu_hkey
            if p.available
              assign zcu_picked = zcu_picked | append: p.handle | append: ','
              assign zcu_count = zcu_count | plus: 1
            endif
          endunless
        endfor
      endif
    endif
  endif
-%}
{%- if zcu_count > 0 -%}
  <div class="zenith-cart-upsell{% if context == 'page' %} zenith-cart-upsell--page{% endif %}">
    {%- if settings.cart_upsell_heading != blank -%}
      <p class="zenith-cart-upsell__heading">{{ settings.cart_upsell_heading | escape }}</p>
    {%- endif -%}
    <ul class="zenith-cart-upsell__list" role="list">
      {%- assign zcu_handles = zcu_picked | split: ',' -%}
      {%- for zcu_handle in zcu_handles -%}
        {%- if zcu_handle != blank -%}
          {%- render 'zenith-cart-upsell-item', product: all_products[zcu_handle], context: context -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
