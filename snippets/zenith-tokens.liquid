{% comment %}
  Replaces the store-wide text tokens in a section's captured output, so a number that appears in copy all
  over the store is typed once in Theme settings instead of being retyped into every text field.
    [customers]     → Theme settings → Zenith → Customer count
    [free_shipping] → the threshold that applies right now (snippets/zenith-shipping-goal.liquid), so trust
                      copy follows the promotion figure automatically while a promotion runs
    [shipping_fee]  → Theme settings → Zenith · Cart → Flat shipping fee
  Accepts: body {String} the section's captured markup
  Usage:
    {%- capture zenith_body -%}…{%- endcapture -%}
    {%- render 'zenith-tokens', body: zenith_body -%}
{% endcomment %}
{%- capture zt_goal -%}{%- render 'zenith-shipping-goal' -%}{%- endcapture -%}
{%- liquid
  assign zt = body | replace: '[customers]', settings.customer_count
  assign zt_goal = zt_goal | plus: 0
  if zt_goal > 0
    capture zt_ship
      echo zt_goal | money_without_trailing_zeros
    endcapture
    assign zt = zt | replace: '[free_shipping]', zt_ship
  endif
  if settings.cart_shipping_fee > 0
    capture zt_fee
      echo settings.cart_shipping_fee | times: 100 | money_without_trailing_zeros
    endcapture
    assign zt = zt | replace: '[shipping_fee]', zt_fee
  endif
  echo zt
-%}
