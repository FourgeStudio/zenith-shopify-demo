{% comment %}
  Replaces the store-wide text tokens in a section's captured output, so a number that appears in copy all
  over the store is typed once in Theme settings instead of being retyped into every text field.
    [customers]     → Theme settings → Zenith → Customer count
    [free_shipping] → Theme settings → Zenith · Cart → Free shipping threshold
  Accepts: body {String} the section's captured markup
  Usage:
    {%- capture zenith_body -%}…{%- endcapture -%}
    {%- render 'zenith-tokens', body: zenith_body -%}
{% endcomment %}
{%- liquid
  assign z_tok = body | replace: '[customers]', settings.customer_count
  if settings.cart_free_shipping_threshold > 0
    capture z_tok_ship
      echo settings.cart_free_shipping_threshold | times: 100 | money_without_trailing_zeros
    endcapture
    assign z_tok = z_tok | replace: '[free_shipping]', z_tok_ship
  endif
  echo z_tok
-%}
