{% comment %}
  The "spend more, save more" tier % the cart qualifies for right now. Echoes a whole number, 0 when
  no tier is reached or the tiers are off (zenith-cart-tiers-on). Best tier wins; tiers never add up.
  Tiers: snippets/zenith-cart-tiers.liquid (match Admin → Discounts). Read by cart-drawer (line prices),
  zenith-cart-summary and zenith-cart-offers, so all three agree.
  Usage:
    {%- capture pct -%}{%- render 'zenith-cart-tier-pct' -%}{%- endcapture -%}
    {%- assign pct = pct | plus: 0 -%}
{% endcomment %}
{%- capture zct_on -%}{%- render 'zenith-cart-tiers-on' -%}{%- endcapture -%}
{%- capture zct_tiers -%}{%- render 'zenith-cart-tiers' -%}{%- endcapture -%}
{%- liquid
  assign zct_pct = 0
  assign zct_tiers = zct_tiers | strip | split: ','
  if zct_on != blank
    # Tiers are spend goals on the full price, before any discount.
    assign zct_sub = 0
    for item in cart.items
      assign zct_sub = zct_sub | plus: item.original_line_price
    endfor
    for zct_tier in zct_tiers
      assign zct_parts = zct_tier | split: ':'
      assign zct_tmin = zct_parts[0] | times: 100
      assign zct_tpct = zct_parts[1] | plus: 0
      if zct_tmin > 0 and zct_sub >= zct_tmin and zct_tpct > zct_pct
        assign zct_pct = zct_tpct
      endif
    endfor
  endif
  echo zct_pct
-%}
