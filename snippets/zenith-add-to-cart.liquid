{% comment %}
  AJAX add-to-cart using Dawn's <product-form> (cart drawer / notification aware).
  Section must load product-form.js.
  Accepts: product {Object}, form_id {String} unique, label {String} optional, class {String} optional,
           style {String} optional brand style ('gold'|'dark'|'outline'|'light'; blank = Dawn scheme button),
           icon {String} optional ('arrow_right'|'cart'|'none')
{% endcomment %}
{%- assign variant = product.selected_or_first_available_variant -%}
<product-form data-section-id="{{ section.id }}" data-hide-errors="true" class="zenith-card__form">
  {%- form 'product', product, id: form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
    <input
      type="hidden"
      name="id"
      value="{{ variant.id }}"
      class="product-variant-id"
      {% unless variant.available %}
        disabled
      {% endunless %}
    >
    <button
      id="{{ form_id }}-submit"
      type="submit"
      name="add"
      class="button zenith-atc{% if style != blank and style != 'scheme' %} zenith-btn zenith-btn--{{ style }}{% endif %} {{ class }}"
      aria-haspopup="dialog"
      {% unless variant.available %}
        disabled
      {% endunless %}
    >
      <span>
        {%- if variant.available -%}
          {%- if label != blank -%}{{ label | escape }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
      {%- liquid
        # Add to Cart labels always show the cart icon (client 2026-10-14); other labels keep their icon, arrow not chevron
        assign atc_label_lc = label | default: 'add to cart' | downcase
        assign atc_icon = icon | default: 'cart'
        if atc_label_lc contains 'add to cart'
          assign atc_icon = 'cart'
        elsif atc_icon == 'chevron_right'
          assign atc_icon = 'arrow_right'
        endif
      -%}
      {%- if atc_icon != 'none' and variant.available -%}
        {%- render 'zenith-icon', icon: atc_icon, class: 'zenith-btn__icon' -%}
      {%- endif -%}
      <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
      {%- render 'loading-spinner' -%}
    </button>
  {%- endform -%}
</product-form>
