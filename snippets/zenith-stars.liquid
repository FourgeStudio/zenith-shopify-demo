{% comment %}
  Accepts: rating {Number} 0-5, count {Number} optional
  Each star fills to the exact share of the rating (4.7 → four full stars and 70% of the fifth); see zenith-star-svg.
{% endcomment %}
{%- assign zs_rating = rating | plus: 0 -%}
<span class="zenith-stars">
  <span class="zenith-stars__icons" role="img" aria-label="{{ rating }} out of 5 stars">
    {%- for i in (1..5) -%}
      {%- liquid
        assign zs_fill = zs_rating | minus: forloop.index0 | times: 100 | round | at_least: 0 | at_most: 100
      -%}
      <span>{% render 'zenith-star-svg', fill: zs_fill %}</span>
    {%- endfor -%}
  </span>
  {%- if count != blank -%}
    <span>({{ count }})</span>
  {%- endif -%}
</span>
