{% comment %}
  Brand link button (styles in zenith-base.css → "Brand buttons"). Variants follow Figma "UI Elements → Buttons".
  Accepts:
    label {String}, link {String} optional (blank → disabled link)
    style {String} 'gold' (Primary) | 'secondary' (light gray on light schemes, dark gray on dark) | 'outline'
      | 'text' (text link) | 'dark' | 'light' | 'scheme' (default 'gold')
    icon {String} 'arrow_right' | 'cart' | 'none' (default 'arrow_right')
    icon_position {String} 'right' | 'left' (default 'right')
    icon_only {Boolean} square icon button; label stays as a visually hidden name
    size {String} 'default' | 'small' (default 'default')
    full {Boolean} full width, class {String} optional
  Usage: {% render 'zenith-button', label: section.settings.button_label, link: section.settings.button_link, style: section.settings.button_style %}
{% endcomment %}
{%- if label != blank -%}
  {%- liquid
    assign btn_style = style | default: 'gold'
    assign btn_icon = icon | default: 'arrow_right'
    if icon_only and btn_icon == 'none'
      assign btn_icon = 'arrow_right'
    endif
  -%}
  <a
    {% if link != blank %}
      href="{{ link | escape }}"
    {% else %}
      role="link" aria-disabled="true"
    {% endif %}
    class="button zenith-btn zenith-btn--{{ btn_style }}{% if size == 'small' %} zenith-btn--small{% endif %}{% if icon_only %} zenith-btn--icon-only{% endif %}{% if full %} zenith-btn--full{% endif %} {{ class }}"
  >
    {%- unless icon_only -%}
      {%- if btn_icon != 'none' and icon_position == 'left' -%}
        {%- render 'zenith-icon', icon: btn_icon, class: 'zenith-btn__icon' -%}
      {%- endif -%}
    {%- endunless -%}
    <span{% if icon_only %} class="visually-hidden"{% endif %}>{{ label | escape }}</span>
    {%- if btn_icon != 'none' and icon_position != 'left' or icon_only -%}
      {%- render 'zenith-icon', icon: btn_icon, class: 'zenith-btn__icon' -%}
    {%- endif -%}
  </a>
{%- endif -%}
