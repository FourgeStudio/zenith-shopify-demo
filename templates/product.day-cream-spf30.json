        "question_1": {
          "type": "question",
          "settings": {
            "question": "Will it feel heavy or greasy in our weather?",
            "answer": "<p>No. Zinc PCA and silica keep it matte, and it sets light.</p>",
            "open": false
          }
        },
        "question_2": {
