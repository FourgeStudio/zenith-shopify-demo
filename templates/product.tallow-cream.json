        "question_1": {
          "type": "question",
          "settings": {
            "question": "Is the Zenith Anti-Aging Tallow Cream suitable for all skin types?",
            "answer": "<p>Yes, the Zenith Anti-Aging Tallow Cream is formulated to benefit all skin types, including sensitive skin. The tallow helps buffer potential retinol irritation.<br/><br/>However, as with any skincare product containing active ingredients, we recommend starting with less frequent application (2-3 times weekly) until your skin adjusts.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Can I use the Zenith Anti-Aging Tallow Cream with my other skincare products?",
            "answer": "<p>The Zenith Anti-Aging Tallow Cream works well with most non-active skincare products.<br/><br/>Avoid using other retinol products, strong acids (AHA/BHA), or vitamin C serums at the same time. Apply Zenith Anti-Aging Tallow Cream after cleansing but before thicker moisturizers if needed.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How long will one jar of the Zenith Anti-Aging Tallow Cream last?",
            "answer": "<p>With recommended nightly use, one jar of Zenith Anti-Aging Tallow Cream typically lasts 1 -2 months.<br/><br/>Since you only need a pea-sized amount for the entire face, a little goes a long way.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Should I use the Zenith Anti-Aging Tallow Cream in the morning or evening?",
            "answer": "<p>The Zenith Anti-Aging Tallow Cream is best used in the evening, as retinol can increase sun sensitivity.<br/><br/>Apply to clean, dry skin before bed. We recommend to use sunscreen during daytime hours when using any retinol product, regardless of when you apply it.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Does it contain artificial fragrances?",
            "answer": "<p>No, it has a mild natural scent derived from its ingredients.</p>"
          }
        },
        "question_rcbiaD": {
          "type": "question",
          "settings": {
            "question": "How long will it take for the product to ship to me?",
            "answer": "<p>We ship within 1 business day using GoGoXpress, NinjaVan, and SPX.<br/><br/>Delivery typically takes 3 business days for Metro Manila and 3-7 business days for Visayas and Mindanao regions.</p>"
          }
        }
      },
