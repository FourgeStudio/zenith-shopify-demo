    "ingredients": {
      "type": "zenith-ingredients",
      "blocks": {
        "ingredient-1": {
          "type": "ingredient",
          "settings": {
            "title": "Premium Tallow",
            "text": "<p>Our formula combines time-tested tallow with proven active ingredients, delivering real anti-aging results through nature's closest molecular match to human skin.</p>",
            "title_mobile": "Premium beef tallow rebuilds the barrier",
            "text_mobile": ""
          }
        },
        "ingredient-2": {
          "type": "ingredient",
          "settings": {
            "title": "Stephania Root Extract",
            "text": "<p>A calming botanical used to steady skin that reacts to heat and pollution, so the actives can do their work without the sting.</p>",
            "title_mobile": "",
            "text_mobile": ""
          }
        },
        "ingredient-3": {
          "type": "ingredient",
          "settings": {
            "title": "Retinol (Vitamin A)",
            "text": "<p>The heavy lifter for anti-aging. It smooths out rough texture, evens your skin tone, and reduces the appearance of fine lines over time. Real, visible results without the complicated routine.</p>",
            "title_mobile": "Retinol 0.2% for lines, tone and texture",
            "text_mobile": ""
          }
        },
        "ingredient-4": {
          "type": "ingredient",
          "settings": {
            "title": "Hyaluronate + Ectoin Shield",
            "text": "<p>Your daily defense against the elements. Hyaluronate pulls in moisture to keep your skin hydrated, while Ectoin acts like an invisible shield against heat, dust, and pollution.</p>",
            "title_mobile": "Ectoin and Stephania keep skin calm",
            "text_mobile": ""
          }
        }
      },
