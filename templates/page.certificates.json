    "faq": {
      "type": "zenith-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Different from drugstore brands?",
            "answer": "<p>Drugstore products are built for mass appeal and the lowest possible cost. Zenith formulas are built specifically for the Philippine climate and the realities of men over 35. We use higher-grade ingredients with absolutely zero unnecessary fillers.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Safe for sensitive skin?",
            "answer": "<p>Yes. Every product is tested in tropical humidity and designed to be gentle. We avoid harsh sulfates and synthetic fragrances that cause irritation. If your skin reacts, the Zenith Money-Back Guarantee has you covered.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How to layer with skincare?",
            "answer": "<p>Keep it simple. Cleanse first with the facial cleanser, then apply your tallow cream or serum. The hygiene line clears the canvas so your skincare can do its real work.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "What is coming next?",
            "answer": "<p>We are developing a full body wash, a deodorant that respects your skin, and a shave cream that reduces razor burn. The toothpaste is in final testing. Sign up for notifications on the product page to know the moment they launch.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Why no antiperspirant yet?",
            "answer": "<p>We are taking our time to get it right. A deodorant that performs in this heat without staining shirts or clogging pores requires real testing. It is coming when it is ready, not a moment sooner.</p>"
          }
        }
      },
