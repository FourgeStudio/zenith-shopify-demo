{{ 'zenith-icon-bar.css' | asset_url | stylesheet_tag }}
{%- render 'zenith-section-style', section: section -%}

<div
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-icon-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_border %} zenith-icon-bar--border{% endif %} zenith-icon-bar--icon-{{ section.settings.icon_color }}"
>
  <div class="page-width">
    <ul class="zenith-icon-bar__list zenith-icon-bar__list--{{ section.settings.alignment }} zenith-icon-bar__list--m-{{ section.settings.mobile_layout }}" role="list">
      {%- for block in section.blocks -%}
        <li class="zenith-icon-bar__item" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="zenith-icon-bar__link">{%- endif -%}
          {%- render 'zenith-icon', icon: block.settings.icon -%}
          <span>{{ block.settings.text | escape }}</span>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Zenith · Icon bar",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Desktop alignment",
      "default": "spread",
      "options": [
        {
          "value": "spread",
          "label": "Spread evenly"
        },
        {
          "value": "center",
          "label": "Centered"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show top and bottom border",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between items",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "icon_color",
      "label": "Icon color",
      "default": "accent",
      "options": [
        {
          "value": "accent",
          "label": "Brand gold"
        },
        {
          "value": "text",
          "label": "Text color"
        }
      ]
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "scroll",
      "options": [
        {
          "value": "scroll",
          "label": "Swipe row"
        },
        {
          "value": "grid",
          "label": "2-column grid"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between items",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "refresh",
              "label": "Money back"
            },
            {
              "value": "cash",
              "label": "Cash"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "certified",
              "label": "Certified"
            },
            {
              "value": "leaf",
              "label": "Natural"
            },
            {
              "value": "flag",
              "label": "Flag"
            },
            {
              "value": "sun",
              "label": "Climate"
            },
            {
              "value": "droplet",
              "label": "Droplet"
            },
            {
              "value": "lock",
              "label": "Secure"
            },
            {
              "value": "box",
              "label": "Package"
            },
            {
              "value": "check_circle",
              "label": "Check"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "user",
              "label": "Person"
            },
            {
              "value": "chat",
              "label": "Chat"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "30-Day Money-Back Guarantee"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith · Icon bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "refresh",
            "text": "30-Day Money-Back Guarantee"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "cash",
            "text": "Cash On Delivery"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "certified",
            "text": "FDA-Notified Products"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "leaf",
            "text": "100% Grass-Fed Beef Tallow"
          }
        }
      ]
    }
  ]
}
{% endschema %}
