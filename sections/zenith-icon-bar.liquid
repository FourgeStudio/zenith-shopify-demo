{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-icon-bar.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  --z-ib-speed: {{ section.settings.marquee_speed | default: 25 }}s;
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- liquid
  assign passes = 1
  if section.settings.mobile_layout == 'marquee'
    assign passes = 2
  endif
-%}

<div
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-icon-bar color-{{ section.settings.color_scheme }} gradient zenith-icon-bar--m-{{ section.settings.mobile_layout }} zenith-icon-bar--icon-{{ section.settings.icon_color }}{% if section.settings.show_border %} zenith-icon-bar--border{% endif %}{% if section.settings.hide_on_mobile %} zenith-hide-mobile{% endif %}"
>
  <div class="page-width zenith-icon-bar__viewport">
    <div class="zenith-icon-bar__track">
      {%- for pass in (1..passes) -%}
        {%- liquid
          assign clone = false
          if pass == 2
            assign clone = true
          endif
        -%}
        <ul
          class="zenith-icon-bar__list zenith-icon-bar__list--{{ section.settings.alignment }}{% if clone %} zenith-icon-bar__list--clone{% endif %}"
          role="list"
          {% if clone %}
            aria-hidden="true"
          {% endif %}
        >
          {%- for block in section.blocks -%}
            <li
              class="zenith-icon-bar__item"
              {% unless clone %}
                id="Block-{{ block.id }}" {{ block.shopify_attributes }}
              {% endunless %}
            >
              {%- if block.settings.link != blank -%}
                <a
                  href="{{ block.settings.link | escape }}"
                  class="zenith-icon-bar__link"
                  {% if clone %}
                    tabindex="-1"
                  {% endif %}
                >
              {%- endif -%}
              {%- if block.settings.icon_image != blank -%}
                {{
                  block.settings.icon_image
                  | image_url: width: 96
                  | image_tag: class: 'zenith-icon zenith-icon-bar__img', loading: 'lazy', alt: ''
                }}
              {%- else -%}
                {%- render 'zenith-icon', icon: block.settings.icon -%}
              {%- endif -%}
              <span>{{ block.settings.text | escape | replace: '[customers]', settings.customer_count }}</span>
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
  {%- if passes == 2 -%}
    {%- comment -%} Pause/play for the mobile marquee (WCAG 2.2.2); CSS shows it only while the row moves {%- endcomment -%}
    {%- render 'zenith-pause-button', class: 'zenith-icon-bar__pause', label: 'Pause scrolling', toggle: '.zenith-icon-bar' -%}
  {%- endif -%}
</div>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Icon bar",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Desktop alignment",
      "default": "spread",
      "options": [
        { "value": "spread", "label": "Spread evenly" },
        { "value": "center", "label": "Centered" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show top and bottom border",
      "default": false
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Minimum space between items",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "select",
      "id": "icon_color",
      "label": "Icon color",
      "default": "dawn_gold",
      "options": [
        { "value": "dawn_gold", "label": "Light gold (Dawn Gold)" },
        { "value": "accent", "label": "Brand gold (Summit Gold)" },
        { "value": "text", "label": "Text color" }
      ]
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "marquee",
      "options": [
        { "value": "marquee", "label": "Auto-scrolling row" },
        { "value": "scroll", "label": "Swipe row" },
        { "value": "grid", "label": "2-column grid" }
      ]
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Auto-scroll speed",
      "info": "Seconds for one full loop. Higher = slower. Pauses on hover and for visitors who prefer reduced motion.",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 25
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between items",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            { "value": "thumbs_up", "label": "Thumbs up" },
            { "value": "cash", "label": "Cash" },
            { "value": "certificate", "label": "Certificate" },
            { "value": "farm", "label": "Farm / sunrise" },
            { "value": "dropper", "label": "Dropper" },
            { "value": "shield", "label": "Shield" },
            { "value": "refresh", "label": "Money back" },
            { "value": "truck", "label": "Delivery" },
            { "value": "certified", "label": "Certified" },
            { "value": "badge_check", "label": "Badge check" },
            { "value": "leaf", "label": "Natural" },
            { "value": "flag", "label": "Flag" },
            { "value": "sun", "label": "Climate" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "lock", "label": "Secure" },
            { "value": "box", "label": "Package" },
            { "value": "check_circle", "label": "Check" },
            { "value": "clock", "label": "Clock" },
            { "value": "gift", "label": "Gift" },
            { "value": "user", "label": "Person" },
            { "value": "chat", "label": "Chat" }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon",
          "info": "Optional. Replaces the icon above. Square SVG/PNG, shown at icon size."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Zenith Money-Back Guarantee"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith · Icon bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "thumbs_up", "text": "Zenith Money-Back Guarantee" } },
        { "type": "item", "settings": { "icon": "cash", "text": "Cash On Delivery" } },
        { "type": "item", "settings": { "icon": "certificate", "text": "FDA-Notified Products" } },
        { "type": "item", "settings": { "icon": "farm", "text": "100% Grass-Fed Beef Tallow" } },
        { "type": "item", "settings": { "icon": "dropper", "text": "Formulated For Filipinos" } }
      ]
    }
  ]
}
{% endschema %}
