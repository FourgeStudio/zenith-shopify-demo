{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-compare.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  --z-cmp-zen: {{ section.settings.zenith_column_background }};
  --z-cmp-zenhead: {{ section.settings.zenith_header_background }};
  --z-cmp-row: {{ section.settings.row_background }};
  --z-cmp-row-alt: {{ section.settings.row_background_alt }};
  --z-cmp-div: {{ section.settings.divider_color }};
  --z-cmp-div-m: {{ section.settings.divider_color_mobile }};
  --z-cmp-note: {{ section.settings.note_font_size }}px;
  --z-cmp-note-m: {{ section.settings.note_font_size_mobile }}px;
  --z-cmp-nopa: {{ section.settings.note_opacity | divided_by: 100.0 }};
  --z-cmp-sub: {{ section.settings.subheading_opacity | divided_by: 100.0 }};
  --z-cmp-sub-m: {{ section.settings.subheading_opacity_mobile | divided_by: 100.0 }};
  --z-cmp-hh: {{ section.settings.header_height }}px;
  --z-cmp-hh-m: {{ section.settings.header_height_mobile }}px;
  --z-cmp-rh: {{ section.settings.row_height }}px;
  --z-cmp-rh-m: {{ section.settings.row_height_mobile }}px;
  --z-cmp-cpad: {{ section.settings.cell_padding }}px;
  --z-cmp-cpad-m: {{ section.settings.cell_padding_mobile }}px;
  --z-cmp-lw: {{ section.settings.label_column_width }}%;
  --z-cmp-lw-m: {{ section.settings.label_column_width_mobile }}%;
  --z-cmp-logow-m: {{ section.settings.logo_width_mobile }}px;
  --z-cmp-gap-m: {{ section.settings.table_gap_mobile }}px;
  --z-cmp-tgap-m: {{ section.settings.group_title_gap_mobile }}px;
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}
{%- liquid
  assign zenith_label = section.settings.zenith_label | default: 'Zenith'
  assign table_caption = section.settings.heading | default: 'Product comparison'
-%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-compare zenith-compare--m-{{ section.settings.heading_alignment_mobile }} color-{{ section.settings.color_scheme }} gradient{% if section.index > 2 %} zenith-defer{% endif %}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      uppercase: section.settings.heading_uppercase
    -%}

    {%- capture zenith_head_cell -%}
      {%- if section.settings.zenith_logo != blank -%}
        {{
          section.settings.zenith_logo
          | image_url: width: 480
          | image_tag:
            loading: 'lazy',
            widths: '120, 240, 360, 480',
            sizes: '120px',
            alt: zenith_label,
            class: 'zenith-compare__logo'
        }}
      {%- else -%}
        {%- comment -%} zenith: bundled wordmark until Theme settings → Zenith column logo is set (same fallback as the header) {%- endcomment -%}
        <img
          src="{{ 'header-logo.png' | asset_url }}"
          alt="{{ zenith_label | escape }}"
          width="104"
          height="28"
          loading="lazy"
          class="zenith-compare__logo"
        >
      {%- endif -%}
    {%- endcapture -%}

    <table class="zenith-compare__table zenith-hide-mobile">
      <caption class="visually-hidden">{{ table_caption | escape }}</caption>
      <thead>
        <tr>
          <td class="zenith-compare__corner"></td>
          <th scope="col" class="zenith-compare__head zenith-compare__head--zenith">{{ zenith_head_cell }}</th>
          {%- for i in (1..3) -%}
            {%- liquid
              assign tkey = 'column_' | append: i | append: '_title'
              assign nkey = 'column_' | append: i | append: '_note'
              assign ctitle = section.settings[tkey]
              assign cnote = section.settings[nkey]
            -%}
            {%- if ctitle != blank -%}
              <th scope="col" class="zenith-compare__head">
                <span class="zenith-compare__head-title">{{ ctitle | escape }}</span>
                {%- if cnote != blank -%}
                  <span class="zenith-compare__head-note">{{ cnote | escape }}</span>
                {%- endif -%}
              </th>
            {%- endif -%}
          {%- endfor -%}
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr id="Block-{{ block.id }}-{{ section.id }}" {{ block.shopify_attributes }}>
            <th scope="row" class="zenith-compare__label">{{ block.settings.label | escape }}</th>
            <td class="zenith-compare__value zenith-compare__value--zenith">{{ block.settings.zenith_value | escape }}</td>
            {%- for i in (1..3) -%}
              {%- liquid
                assign tkey = 'column_' | append: i | append: '_title'
                assign vkey = 'value_' | append: i
              -%}
              {%- if section.settings[tkey] != blank -%}
                <td class="zenith-compare__value">{{ block.settings[vkey] | escape }}</td>
              {%- endif -%}
            {%- endfor -%}
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <div class="zenith-compare__mobile zenith-hide-desktop">
      <table class="zenith-compare__table-m zenith-compare__table-m--zenith">
        <caption class="visually-hidden">{{ table_caption | escape }} — {{ zenith_label | escape }}</caption>
        <thead>
          <tr>
            <td class="zenith-compare__corner"></td>
            <th scope="col" class="zenith-compare__head zenith-compare__head--zenith">{{ zenith_head_cell }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr>
              <th scope="row" class="zenith-compare__label">{{ block.settings.label | escape }}</th>
              <td class="zenith-compare__value zenith-compare__value--zenith">{{ block.settings.zenith_value | escape }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      {%- for i in (1..3) -%}
        {%- liquid
          assign tkey = 'column_' | append: i | append: '_title'
          assign nkey = 'column_' | append: i | append: '_note'
          assign vkey = 'value_' | append: i
          assign ctitle = section.settings[tkey]
          assign cnote = section.settings[nkey]
        -%}
        {%- if ctitle != blank -%}
          <div class="zenith-compare__group">
            <h3 class="zenith-compare__group-title">
              {{- ctitle | escape -}}
              {%- if cnote != blank -%}
                <span class="zenith-compare__group-note">{{ cnote | escape }}</span>
              {%- endif -%}
            </h3>
            <table class="zenith-compare__table-m">
              <tbody>
                {%- for block in section.blocks -%}
                  <tr>
                    <th scope="row" class="zenith-compare__label">{{ block.settings.label | escape }}</th>
                    <td class="zenith-compare__value">{{ block.settings[vkey] | escape }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endcapture -%}
{{- zenith_body | replace: '[customers]', settings.customer_count -}}

{% schema %}
