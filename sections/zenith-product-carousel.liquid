{{ 'zenith-product-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cols = section.settings.slides_desktop
  assign gap_count = section.settings.slides_desktop | minus: 1
  if section.settings.show_peek
    assign cols = cols | plus: 0.35
    assign gap_count = gap_count | plus: 1
  endif
  assign pc_collection = section.settings.collection
-%}
{%- capture extra -%}
  --z-slide: calc((100% - {{ gap_count }} * var(--z-gap, 24px)) / {{ cols }});
  --z-slide-m: {{ section.settings.mobile_slide_width }}%;
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-pc zenith-pc--{{ section.settings.image_ratio }} color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    <div class="zenith-pc__header">
      {%- render 'zenith-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        alignment: 'left',
        uppercase: section.settings.heading_uppercase,
        class: 'zenith-pc__heading'
      -%}
      {%- if section.settings.view_all_label != blank -%}
        {%- liquid
          assign view_all_url = section.settings.view_all_link
          if view_all_url == blank and pc_collection != blank
            assign view_all_url = pc_collection.url
          endif
        -%}
        <a
          {% if view_all_url != blank %}href="{{ view_all_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
          class="button zenith-pc__view-all"
        >
          {{- section.settings.view_all_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <zenith-carousel data-autoplay="{{ section.settings.autoplay }}" data-slide-label="Product">
      <ul class="zenith-carousel__track" role="list">
        {%- if pc_collection != blank and pc_collection.products_count > 0 -%}
          {%- for product in pc_collection.products limit: section.settings.products_to_show -%}
            <li class="zenith-carousel__slide">
              {%- render 'zenith-product-card',
                product: product,
                show_rating: section.settings.show_rating,
                button_label: section.settings.button_label
              -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <li class="zenith-carousel__slide">
              {%- render 'zenith-product-card',
                product: blank,
                show_rating: section.settings.show_rating,
                button_label: section.settings.button_label,
                index: forloop.index0
              -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- render 'zenith-carousel-controls',
        show_dots: section.settings.show_dots,
        show_arrows: section.settings.show_arrows,
        label: 'products'
      -%}
    </zenith-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Product carousel",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "All Products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Zenith Grooming Collection"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>The products men come back for. Simple. Effective. Proven.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "info": "Requires a reviews app that sets product ratings",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Card button label",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "info": "Defaults to the collection page"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Products per view on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_peek",
      "label": "Show part of the next product",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Auto-advance",
      "info": "Seconds between slides. 0 turns it off.",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image shape",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "landscape",
          "label": "Landscape 4:3"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Product title size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Price size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_slide_width",
      "label": "Mobile card width",
      "min": 40,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "heading_spacing_mobile",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between cards",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Product title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "price_font_size_mobile",
      "label": "Price size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Zenith · Product carousel"
    }
  ]
}
{% endschema %}
