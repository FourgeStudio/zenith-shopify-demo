{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-product-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cols = section.settings.slides_desktop
  assign gap_count = section.settings.slides_desktop | minus: 1
  assign cols_t = section.settings.slides_desktop | minus: 1 | at_least: 2
  assign gap_count_t = cols_t | minus: 1
  if section.settings.show_peek
    assign cols = cols | plus: 0.35
    assign gap_count = gap_count | plus: 1
    assign cols_t = cols_t | plus: 0.35
    assign gap_count_t = gap_count_t | plus: 1
  endif
  assign pc_collection = section.settings.collection
  assign pc_products = section.settings.product_list
  if pc_products == blank or pc_products.size == 0
    if pc_collection != blank and pc_collection.products_count > 0
      assign pc_products = pc_collection.products
    endif
  endif
  assign mobile_vw = section.settings.mobile_slide_width
  if section.settings.mobile_layout == 'stack'
    assign mobile_vw = 100
  endif
  assign card_sizes = '(min-width: 990px) calc((100vw - 10rem) / ' | append: cols | append: '), (min-width: 750px) calc((100vw - 10rem) / ' | append: cols_t | append: '), ' | append: mobile_vw | append: 'vw'
  assign img_bg = section.settings.card_image_gradient | default: section.settings.card_image_bg
-%}
{%- capture extra -%}
  --z-slide: calc((100% - {{ gap_count }} * var(--z-gap, 24px)) / {{ cols }});
  --z-slide-t: calc((100% - {{ gap_count_t }} * var(--z-gap, 24px)) / {{ cols_t }});
  --z-slide-m: {{ section.settings.mobile_slide_width }}%;
  --z-pc-ebsp: {{ section.settings.eyebrow_spacing }}px;
  --z-pc-txtsp: {{ section.settings.card_text_spacing }}px;
  --z-pc-btnsp: {{ section.settings.card_button_spacing }}px;
  --z-pc-btnh: {{ section.settings.card_button_height }}px;
  --z-pc-btnh-m: {{ section.settings.card_button_height_mobile }}px;
  --z-pc-atcfs: {{ section.settings.card_button_font_size }}px;
  --z-pc-atcfs-m: {{ section.settings.card_button_font_size_mobile }}px;
  --z-pc-ctlsp: {{ section.settings.controls_spacing }}px;
  --z-pc-img-bg: {{ img_bg }};
  --z-pc-fit: {{ section.settings.image_fit }};
  --z-pc-descsp: {{ section.settings.card_desc_spacing }}px;
  --z-pc-stack-gap-m: {{ section.settings.stack_gap_mobile }}px;
  --z-pc-divider: {{ section.settings.divider_color }};
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-pc zenith-pc--{{ section.settings.image_ratio }}{% if section.settings.bleed_right %} zenith-pc--bleed{% endif %}{% if section.settings.mobile_layout == 'stack' %} zenith-pc--stack-m{% if section.settings.show_dividers_mobile %} zenith-pc--dividers-m{% endif %}{% endif %}{% if section.settings.title_font == 'heading' %} zenith-pc--title-heading{% endif %} color-{{ section.settings.color_scheme }} gradient{% if section.index > 2 %} zenith-defer{% endif %}"
>
  <div class="page-width">
    <div class="zenith-pc__header">
      {%- render 'zenith-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        alignment: 'left',
        uppercase: section.settings.heading_uppercase,
        class: 'zenith-pc__heading'
      -%}
      {%- if section.settings.view_all_label != blank -%}
        {%- liquid
          assign view_all_url = section.settings.view_all_link
          if view_all_url == blank and pc_collection != blank
            assign view_all_url = pc_collection.url
          endif
          assign view_all_class = 'zenith-pc__view-all'
          if section.settings.hide_view_all_mobile
            assign view_all_class = 'zenith-pc__view-all zenith-hide-mobile'
          endif
        -%}
        {%- render 'zenith-button',
          label: section.settings.view_all_label,
          link: view_all_url,
          style: section.settings.button_style,
          class: view_all_class
        -%}
      {%- endif -%}
    </div>

    <zenith-carousel data-autoplay="{{ section.settings.autoplay }}" data-slide-label="Product">
      <ul class="zenith-carousel__track" role="list">
        {%- if pc_products != blank -%}
          {%- for product in pc_products limit: section.settings.products_to_show -%}
            {%- liquid
              assign card_desc = blank
              if section.settings.show_description
                assign card_desc = product.metafields.custom.short_description | metafield_text | strip
                if card_desc == blank
                  assign card_desc = product.description | strip_html | strip | truncatewords: section.settings.description_words
                endif
              endif
              assign card_img = blank
              if section.settings.image_source == 'metafield'
                assign card_img = product.metafields.custom.card_image.value
              endif
            -%}
            <li class="zenith-carousel__slide">
              {%- render 'zenith-product-card',
                product: product,
                show_rating: section.settings.show_rating,
                button_label: section.settings.button_label,
                button_style: section.settings.card_button_style,
                button_icon: section.settings.card_button_icon,
                button_action: section.settings.card_button_action,
                show_price: section.settings.show_price,
                description: card_desc,
                image: card_img,
                image_sizes: card_sizes
              -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- liquid
            assign placeholder_desc = blank
            if section.settings.show_description
              assign placeholder_desc = 'A short line about the product appears here.'
            endif
          -%}
          {%- for i in (1..6) -%}
            <li class="zenith-carousel__slide">
              {%- render 'zenith-product-card',
                product: blank,
                show_rating: section.settings.show_rating,
                button_label: section.settings.button_label,
                button_style: section.settings.card_button_style,
                button_icon: section.settings.card_button_icon,
                show_price: section.settings.show_price,
                description: placeholder_desc,
                index: forloop.index0
              -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- comment -%} Stacked mobile layout hides these below 750px (CSS) {%- endcomment -%}
      {%- render 'zenith-carousel-controls',
        show_dots: section.settings.show_dots,
        show_arrows: section.settings.show_arrows,
        label: 'products'
      -%}
    </zenith-carousel>
  </div>
</section>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Product carousel",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "All Products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Zenith Grooming Collection"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>The products men come back for. Simple. Effective. Proven.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "info": "Pick products in the order to show. Replaces the collection when set.",
      "limit": 24
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 10
    },
    {
      "type": "select",
      "id": "image_source",
      "label": "Product image",
      "info": "Card image uses the product metafield custom.card_image (e.g. a transparent cut-out). Products without it show their featured image.",
      "default": "featured",
      "options": [
        { "value": "featured", "label": "Featured image" },
        { "value": "metafield", "label": "Card image metafield" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "info": "Requires a reviews app that sets product ratings",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "info": "Uses the product metafield custom.short_description, or the start of the product description.",
      "default": false
    },
    {
      "type": "range",
      "id": "description_words",
      "label": "Description length (words)",
      "info": "Only when the product has no short description metafield.",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "select",
      "id": "card_button_action",
      "label": "Card button action",
      "default": "cart",
      "options": [
        { "value": "cart", "label": "Add to cart" },
        { "value": "link", "label": "View product" }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Card button label",
      "default": "Add to Cart"
    },
    {
      "type": "select",
      "id": "card_button_icon",
      "label": "Card button icon",
      "default": "arrow_right",
      "options": [
        { "value": "arrow_right", "label": "Arrow" },
        { "value": "cart", "label": "Cart" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "info": "Defaults to the collection page"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Products per view on desktop",
      "info": "Tablet shows one less.",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "bleed_right",
      "label": "Extend carousel to the right screen edge",
      "info": "Shows part of the next product outside the page width.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_peek",
      "label": "Show part of the next product inside the page width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay",
