{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-product-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cols = section.settings.slides_desktop
  assign gap_count = section.settings.slides_desktop | minus: 1
  assign cols_t = section.settings.slides_desktop | minus: 1 | at_least: 2
  assign gap_count_t = cols_t | minus: 1
  if section.settings.show_peek
    assign cols = cols | plus: 0.35
    assign gap_count = gap_count | plus: 1
    assign cols_t = cols_t | plus: 0.35
    assign gap_count_t = gap_count_t | plus: 1
  endif
  assign pc_collection = section.settings.collection
  assign card_sizes = '(min-width: 990px) calc((100vw - 10rem) / ' | append: cols | append: '), (min-width: 750px) calc((100vw - 10rem) / ' | append: cols_t | append: '), ' | append: section.settings.mobile_slide_width | append: 'vw'
-%}
{%- capture extra -%}
  --z-slide: calc((100% - {{ gap_count }} * var(--z-gap, 24px)) / {{ cols }});
  --z-slide-t: calc((100% - {{ gap_count_t }} * var(--z-gap, 24px)) / {{ cols_t }});
  --z-slide-m: {{ section.settings.mobile_slide_width }}%;
  --z-pc-ebsp: {{ section.settings.eyebrow_spacing }}px;
  --z-pc-txtsp: {{ section.settings.card_text_spacing }}px;
  --z-pc-btnsp: {{ section.settings.card_button_spacing }}px;
  --z-pc-btnh: {{ section.settings.card_button_height }}px;
  --z-pc-btnh-m: {{ section.settings.card_button_height_mobile }}px;
  --z-pc-atcfs: {{ section.settings.card_button_font_size }}px;
  --z-pc-atcfs-m: {{ section.settings.card_button_font_size_mobile }}px;
  --z-pc-ctlsp: {{ section.settings.controls_spacing }}px;
  --z-pc-img-bg: {{ section.settings.card_image_bg }};
  --z-pc-fit: {{ section.settings.image_fit }};
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-pc zenith-pc--{{ section.settings.image_ratio }}{% if section.settings.bleed_right %} zenith-pc--bleed{% endif %} color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    <div class="zenith-pc__header">
      {%- render 'zenith-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        alignment: 'left',
        uppercase: section.settings.heading_uppercase,
        class: 'zenith-pc__heading'
      -%}
      {%- if section.settings.view_all_label != blank -%}
        {%- liquid
          assign view_all_url = section.settings.view_all_link
          if view_all_url == blank and pc_collection != blank
            assign view_all_url = pc_collection.url
          endif
        -%}
        {%- render 'zenith-button',
          label: section.settings.view_all_label,
          link: view_all_url,
          style: section.settings.button_style,
          class: 'zenith-pc__view-all'
        -%}
      {%- endif -%}
    </div>

    <zenith-carousel data-autoplay="{{ section.settings.autoplay }}" data-slide-label="Product">
      <ul class="zenith-carousel__track" role="list">
        {%- if pc_collection != blank and pc_collection.products_count > 0 -%}
          {%- for product in pc_collection.products limit: section.settings.products_to_show -%}
            <li class="zenith-carousel__slide">
              {%- render 'zenith-product-card',
                product: product,
                show_rating: section.settings.show_rating,
                button_label: section.settings.button_label,
                button_style: section.settings.card_button_style,
                button_icon: section.settings.card_button_icon,
                image_sizes: card_sizes
              -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <li class="zenith-carousel__slide">
              {%- render 'zenith-product-card',
                product: blank,
                show_rating: section.settings.show_rating,
                button_label: section.settings.button_label,
                button_style: section.settings.card_button_style,
                button_icon: section.settings.card_button_icon,
                index: forloop.index0
              -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- render 'zenith-carousel-controls',
        show_dots: section.settings.show_dots,
        show_arrows: section.settings.show_arrows,
        label: 'products'
      -%}
    </zenith-carousel>
  </div>
</section>
{%- endcapture -%}
{{- zenith_body | replace: '[customers]', settings.customer_count -}}

{% schema %}
{
  "name": "Zenith · Product carousel",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "All Products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Zenith Grooming Collection"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>The products men come back for. Simple. Effective. Proven.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "info": "Requires a reviews app that sets product ratings",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Card button label",
      "default": "Add to Cart"
    },
    {
      "type": "select",
      "id": "card_button_icon",
      "label": "Card button icon",
      "default": "arrow_right",
      "options": [
        { "value": "arrow_right", "label": "Arrow" },
        { "value": "cart", "label": "Cart" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "info": "Defaults to the collection page"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Products per view on desktop",
      "info": "Tablet shows one less.",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "bleed_right",
      "label": "Extend carousel to the right screen edge",
      "info": "Shows part of the next product outside the page width.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_peek",
      "label": "Show part of the next product inside the page width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Auto-advance",
      "info": "Seconds between slides. 0 turns it off.",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "eyebrow_spacing",
      "label": "Space below eyebrow",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image shape",
      "default": "square",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait 4:5" },
        { "value": "landscape", "label": "Landscape 4:3" }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Product image fit",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Fill (crop)" },
        { "value": "contain", "label": "Fit (no crop)" }
      ]
    },
    {
      "type": "range",
      "id": "image_padding",
      "label": "Product image padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_text_spacing",
      "label": "Space between image and title",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_button_spacing",
      "label": "Space above card button",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "card_button_height",
      "label": "Card button height",
      "min": 32,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "controls_spacing",
      "label": "Space above dots and arrows",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "View all button style",
      "default": "outline",
      "options": [
        { "value": "gold", "label": "Gold gradient" },
        { "value": "dark", "label": "Dark" },
        { "value": "outline", "label": "Outline" },
        { "value": "light", "label": "Light" },
        { "value": "scheme", "label": "Color scheme button" }
      ]
    },
    {
      "type": "select",
      "id": "card_button_style",
      "label": "Card button style",
      "default": "gold",
      "options": [
        { "value": "gold", "label": "Gold gradient" },
        { "value": "dark", "label": "Dark" },
        { "value": "outline", "label": "Outline" },
        { "value": "light", "label": "Light" },
        { "value": "scheme", "label": "Color scheme button" }
      ]
    },
    {
      "type": "color",
      "id": "card_image_bg",
      "label": "Product image background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Product title size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Price size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "View all button text size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_button_font_size",
      "label": "Card button text size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 23
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_slide_width",
      "label": "Card width",
      "info": "Percent of the page width",
      "min": 40,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 83
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
