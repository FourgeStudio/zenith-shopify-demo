{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-routine.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign step_count = section.blocks.size | at_least: 1
  assign step_sizes = '(min-width: 750px) calc(' | append: s.content_max_width | append: 'px / ' | append: step_count | append: '), ' | append: s.image_width_mobile | append: 'px'

  # "Used …" line: own text, or "Used " + the product names
  assign used_text = s.used_text
  if used_text == blank and s.products != blank
    assign used_names = s.products | map: 'title' | join: ' and '
    assign used_text = 'Used ' | append: used_names
  endif
-%}

{%- capture extra -%}
  --z-rt-ratio: {{ s.image_ratio }};
  --z-rt-tsp: {{ s.step_title_spacing }}px;
  --z-rt-title: {{ s.title_color }};
  --z-rt-text-o: {{ s.text_opacity | divided_by: 100.0 }};
  --z-rt-imgw-m: {{ s.image_width_mobile }}px;
  --z-rt-imgw: {{ s.image_width }}px;
  --z-rt-num-bg: {{ s.number_background }};
  --z-rt-num-fg: {{ s.number_color }};
  --z-rt-num: {{ s.number_size }}px;
  --z-rt-num-m: {{ s.number_size_mobile }}px;
  --z-rt-numfs: {{ s.number_font_size }}px;
  --z-rt-numfs-m: {{ s.number_font_size_mobile }}px;
  --z-rt-usp: {{ s.used_spacing }}px;
  --z-rt-usp-m: {{ s.used_spacing_mobile }}px;
  --z-rt-uw: {{ s.used_width }}px;
  --z-rt-ufs: {{ s.used_font_size }}px;
  --z-rt-ufs-m: {{ s.used_font_size_mobile }}px;
  --z-rt-bar: {{ s.bar_color }};
  --z-rt-bar-fg: {{ s.bar_text_color }};
  --z-rt-thumb: {{ s.thumb_size }}px;
  --z-rt-thumb-m: {{ s.thumb_size_mobile }}px;
  --z-rt-thumb-bg: {{ s.thumb_background }};
  --z-rt-dsp: {{ s.divider_spacing }}px;
  --z-rt-dsp-m: {{ s.divider_spacing_mobile }}px;
  --z-rt-divider: {{ s.divider_color }};
  --z-rt-tlh: {{ s.text_line_height | default: 160 | divided_by: 100.0 }};
  --z-rt-tlh-m: {{ s.text_line_height_mobile | default: 160 | divided_by: 100.0 }};
  --z-rt-nfs: {{ s.note_font_size | default: 14 }}px;
  --z-rt-nfs-m: {{ s.note_font_size_mobile | default: 13 }}px;
  --z-rt-nsp: {{ s.note_spacing | default: 24 }}px;
  --z-rt-nsp-m: {{ s.note_spacing_mobile | default: 20 }}px;
  {%- if s.heading_max_width_mobile < 800 %}
  --z-rt-hmw-m: {{ s.heading_max_width_mobile }}px;
  {%- endif %}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-rt zenith-rt--m-{{ s.heading_alignment_mobile }} zenith-rt--d-{{ s.step_layout | default: 'stacked' }} zenith-rt--div-{{ s.divider_breakpoint | default: 'all' }}{% if s.show_note_desktop %} zenith-rt--note-d{% endif %}{% if s.title_heading_font %} zenith-rt--title-heading{% endif %} color-{{ s.color_scheme }} gradient{% if section.index > 2 %} zenith-defer{% endif %}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: s.eyebrow,
      heading: s.heading,
      subheading: s.subheading,
      alignment: s.heading_alignment,
      uppercase: s.heading_uppercase,
      class: 'zenith-rt__heading'
    -%}

    <ol class="zenith-rt__steps" role="list">
      {%- for block in section.blocks -%}
        <li class="zenith-rt__step" {{ block.shopify_attributes }}>
          <div class="zenith-media zenith-rt__image">
            {%- if block.settings.image != blank -%}
              {%- assign step_alt = block.settings.image.alt | default: block.settings.title -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '200, 300, 450, 600, 900', sizes: step_sizes, alt: step_alt
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="zenith-rt__body">
            {%- if s.show_number -%}
              <span class="zenith-rt__num" aria-hidden="true">{{ forloop.index }}</span>
            {%- endif -%}
            {%- if s.step_label != blank -%}
              <p class="zenith-eyebrow zenith-rt__label">{{ s.step_label | escape }} {{ forloop.index }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="zenith-rt__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="zenith-rt__text">{{ block.settings.text | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- comment -%} zenith: Liquid reads and/or right to left → show_used and (text or products) {%- endcomment -%}
    {%- if s.show_used != false and used_text != blank or s.products != blank -%}
      <div class="zenith-rt__used">
        {%- if used_text != blank -%}
          <p class="zenith-rt__used-text">{{ used_text | escape }}</p>
        {%- endif -%}
        {%- if s.products != blank -%}
          <ul class="zenith-rt__used-products" role="list">
            {%- for p in s.products -%}
              <li>
                <a href="{{ p.url }}" class="zenith-rt__thumb" title="{{ p.title | escape }}">
                  {%- if p.featured_media -%}
                    {{
                      p.featured_media
                      | image_url: width: 240
                      | image_tag: loading: 'lazy', widths: '120, 240', sizes: '80px', alt: p.title
                    }}
                  {%- else -%}
                    <span class="visually-hidden">{{ p.title | escape }}</span>
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- elsif request.design_mode -%}
          <ul class="zenith-rt__used-products" role="list">
            <li><span class="zenith-rt__thumb">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span></li>
            <li><span class="zenith-rt__thumb">{{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}</span></li>
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.note != blank -%}
      <div class="zenith-rt__note zenith-rte">{{ s.note }}</div>
    {%- endif -%}

    {%- if s.show_divider -%}
      <hr class="zenith-rt__divider">
    {%- endif -%}
  </div>
</section>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Routine steps",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Day Routine"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Matte & Protected"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Get Complete Protection + Anti-Aging + Brightening In 3 Steps</p>"
    },
    {
      "type": "checkbox",
      "id": "show_used",
      "label": "Show the note under the steps",
      "info": "The \"Used …\" bar with the product thumbnails, on desktop and phones.",
      "default": true
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products used",
      "info": "Shown as linked thumbnails in the bar under the steps.",
      "limit": 4
    },
    {
      "type": "text",
      "id": "used_text",
      "label": "Products used text",
      "visible_if": "{{ section.settings.show_used }}",
      "info": "Leave empty for \"Used\" + the product names.",
      "default": "Used Zenith Anti-Aging Tallow Cleanser and Day Cream"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note below the steps",
      "info": "Centred line under the steps. Shows on phones; turn on \"Show note on desktop\" to show it on larger screens too."
    },
    {
      "type": "checkbox",
      "id": "show_number",
      "label": "Number the steps",
      "info": "Gold circle with 1, 2, 3 … above the step text.",
      "default": false
    },
    {
      "type": "text",
      "id": "step_label",
      "label": "Step label",
      "info": "e.g. Step → STEP 1, STEP 2 … above each title in the universal eyebrow style (Verify page step cards). Empty = none."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider line below",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "divider_breakpoint",
      "label": "Show the divider on",
      "visible_if": "{{ section.settings.show_divider }}",
      "default": "all",
      "options": [
        { "value": "all", "label": "Desktop and phones" },
        { "value": "mobile", "label": "Phones only" },
        { "value": "desktop", "label": "Desktop only" }
      ]
    },
    {
      "type": "select",
      "id": "step_layout",
      "label": "Step layout (desktop)",
      "info": "Phones always put the photo beside the text.",
      "default": "stacked",
      "options": [
        { "value": "stacked", "label": "Photo above the text" },
        { "value": "beside", "label": "Photo beside the text" }
      ]
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Photo width (photo beside the text)",
      "visible_if": "{{ section.settings.step_layout == 'beside' }}",
      "min": 80,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 152
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Steps width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1020
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space above steps",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between steps",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Photo shape",
      "default": "0.75",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "0.8", "label": "Portrait 4:5" },
        { "value": "0.75", "label": "Portrait 3:4" },
        { "value": "0.667", "label": "Portrait 2:3" }
      ]
    },
    {
      "type": "range",
      "id": "step_title_spacing",
      "label": "Space between photo and title",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "used_spacing",
      "label": "Space above products used",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "used_width",
      "label": "Products used bar width",
      "min": 320,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "checkbox",
      "id": "show_note_desktop",
      "label": "Show note on desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "note_spacing",
      "label": "Space above note",
      "visible_if": "{{ section.settings.show_note_desktop }}",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Space above divider",
      "visible_if": "{{ section.settings.show_divider }}",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Step title",
      "default": "#D6B356"
    },
    {
      "type": "checkbox",
      "id": "title_heading_font",
      "label": "Step title in the heading font",
      "info": "Verify page step card style.",
      "default": false
    },
    {
      "type": "color",
      "id": "number_background",
      "label": "Step number circle",
      "visible_if": "{{ section.settings.show_number }}",
      "default": "#C5930E"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Step number text",
      "visible_if": "{{ section.settings.show_number }}",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "text_opacity",
      "label": "Step text opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Products used bar",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "bar_text_color",
      "label": "Products used text",
      "default": "#D6B356"
    },
    {
      "type": "color",
      "id": "thumb_background",
      "label": "Product thumbnail background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "visible_if": "{{ section.settings.show_divider }}",
      "default": "#3E3E3E"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow size",
      "info": "No longer applies: eyebrows use the universal style (.zenith-eyebrow in zenith-base.css, 16px).",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Step title size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "number_size",
