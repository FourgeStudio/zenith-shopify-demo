{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-before-after.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign cols = s.columns_desktop
  assign cols_t = cols | at_most: 2
  assign cols_m = s.columns_mobile
  assign pair_sizes = '(min-width: 990px) calc((100vw - 10rem) / ' | append: cols | append: ' / 2), (min-width: 750px) calc((100vw - 10rem) / ' | append: cols_t | append: ' / 2), calc((100vw - 5rem) / ' | append: cols_m | append: ' / 2)'
-%}

{%- capture extra -%}
  --z-ba-cols: {{ cols }};
  --z-ba-cols-t: {{ cols_t }};
  --z-ba-cols-m: {{ cols_m }};
  --z-ba-ratio: {{ s.image_ratio }};
  --z-ba-ratio-m: {{ s.image_ratio_mobile }};
  --z-ba-inset: {{ s.card_inset }}px;
  --z-ba-card: {{ s.card_color }};
  --z-ba-label: {{ s.label_color }};
  --z-ba-lfs: {{ s.label_font_size }}px;
  --z-ba-lfs-m: {{ s.label_font_size_mobile }}px;
  --z-ba-cfs: {{ s.caption_font_size }}px;
  --z-ba-cfs-m: {{ s.caption_font_size_mobile }}px;
  --z-ba-cap-o: {{ s.caption_opacity | divided_by: 100.0 }};
  --z-ba-ffs: {{ s.footnote_font_size }}px;
  --z-ba-fcolor: {{ s.footnote_color }};
  --z-ba-fsp: {{ s.footnote_spacing }}px;
  --z-ba-tsp: {{ s.text_spacing }}px;
  --z-ba-capw: {{ s.caption_max_width }}px;
  {%- render 'zenith-overlay-vars', settings: s -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-ba zenith-ba--m-{{ s.heading_alignment_mobile }} color-{{ s.color_scheme }} gradient{% if section.index > 2 %} zenith-defer{% endif %}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: s.eyebrow,
      heading: s.heading,
      subheading: s.subheading,
      alignment: s.heading_alignment,
      uppercase: s.heading_uppercase,
      class: 'zenith-ba__heading'
    -%}
    {%- if s.text != blank -%}
      <div class="zenith-ba__text zenith-ba__text--{{ s.heading_alignment }}">{{ s.text }}</div>
    {%- endif -%}

    <ul class="zenith-ba__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="zenith-ba__card" {{ block.shopify_attributes }}>
          <div class="zenith-ba__pair">
            {%- for side in (1..2) -%}
              {%- liquid
                if side == 1
                  assign side_image = block.settings.before_image
                  assign side_label = block.settings.before_label
                else
                  assign side_image = block.settings.after_image
                  assign side_label = block.settings.after_label
                endif
                assign side_alt = side_image.alt | default: side_label
              -%}
              <figure class="zenith-media zenith-ba__photo">
                {%- if side_image != blank -%}
                  {{
                    side_image
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', widths: '240, 360, 480, 640, 800', sizes: pair_sizes, alt: side_alt
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                {%- render 'zenith-overlay', style: s.overlay_style -%}
                {%- if side_label != blank -%}
                  <figcaption class="zenith-ba__label">{{ side_label | escape }}</figcaption>
                {%- endif -%}
              </figure>
            {%- endfor -%}
          </div>
          {%- if block.settings.caption != blank -%}
            <p class="zenith-ba__caption">{{ block.settings.caption | escape | newline_to_br }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.footnote != blank -%}
      <p class="zenith-ba__footnote">{{ s.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>
{%- endcapture -%}
{{- zenith_body | replace: '[customers]', settings.customer_count -}}

{% schema %}
{
