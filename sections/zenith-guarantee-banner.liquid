{{ 'zenith-guarantee-banner.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  --z-badge-w: {{ section.settings.image_width }}px;
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-guarantee color-{{ section.settings.color_scheme }} gradient{% if section.settings.image_position == 'left' %} zenith-guarantee--image-left{% endif %}"
>
  <div class="page-width">
    <div class="zenith-guarantee__inner">
      <div class="zenith-guarantee__content">
        {%- render 'zenith-section-heading',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          subheading: blank,
          alignment: 'left',
          size: section.settings.heading_size,
          class: 'zenith-guarantee__heading'
        -%}
        {%- if section.settings.text != blank -%}
          <div class="zenith-guarantee__text zenith-rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
            class="button"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <div class="zenith-guarantee__badge">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', sizes: '(min-width: 750px) 320px, 200px'
          }}
        {%- else -%}
          <div class="zenith-guarantee__badge-placeholder" aria-hidden="true">
            <span>30-Day</span>
            <strong>Zenith</strong>
            <span>Guarantee</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Guarantee banner",
  "tag": "div",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Zenith Money-Back Guarantee" },
    {
      "type": "richtext", "id": "text", "label": "Text",
      "default": "<p>We stand behind every Zenith formula with complete confidence. We know different issues take different times to fix, which is why we give you 30 days for skincare and 60 days for hair care to see real changes.</p><p>If you don't see visible improvements by then, simply contact us. We'll refund your purchase, just show us proof. Because real results speak louder than promises.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Badge image", "info": "Transparent PNG of the guarantee seal" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "image_position", "label": "Desktop badge position", "default": "right",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ]
    },
    { "type": "range", "id": "image_width", "label": "Badge width", "min": 120, "max": 400, "step": 10, "unit": "px", "default": 260 },

    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },

    { "type": "header", "content": "Typography" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "lg",
      "options": [ { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }, { "value": "xl", "label": "Extra large" } ]
    },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "Zenith · Guarantee banner" } ]
}
{% endschema %}
