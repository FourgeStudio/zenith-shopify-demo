{% comment %}
  Not placed on any page. assets/zenith-cart-upsell.js fetches it through Shopify's product
  recommendations endpoint (/recommendations/products?product_id=…&intent=…&section_id=zenith-cart-upsell),
  which is the only place the `recommendations` object is filled. Shopify picks the products
  automatically ("related"); "complementary" returns the ones set in the Search & Discovery app.
  Available products only; the script drops anything already in the cart.
{% endcomment %}
<ul class="zenith-cart-upsell__source" role="list">
  {%- for product in recommendations.products -%}
    {%- if product.available -%}
      {%- render 'zenith-cart-upsell-item', product: product -%}
    {%- endif -%}
  {%- endfor -%}
</ul>

{% schema %}
{
  "name": "Zenith · Cart upsell",
  "class": "zenith-cart-upsell-source",
  "settings": []
}
{% endschema %}
