{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{%- liquid
  assign s = section.settings

  # Source: the picked blog, else the blog of the article being viewed
  assign source = s.blog
  if source == blank and article
    assign source = blog
  endif

  assign card_share = 100 | divided_by: s.columns
  assign card_sizes = '(min-width: 990px) ' | append: card_share | append: 'vw, (min-width: 750px) 50vw, 100vw'
-%}

{%- capture cards -%}
  {%- assign shown = 0 -%}
  {%- if source != blank -%}
    {%- for a in source.articles -%}
      {%- if article and a.id == article.id -%}
        {%- continue -%}
      {%- endif -%}
      <li>
        {%- render 'zenith-article-card',
          article: a,
          sizes: card_sizes,
          heading_tag: s.card_heading_tag,
          link_label: s.link_label,
          show_excerpt: s.show_excerpt,
          excerpt_words: s.excerpt_words,
          show_date: s.show_date,
          date_format: s.date_format
        -%}
      </li>
      {%- assign shown = shown | plus: 1 -%}
      {%- if shown >= s.count -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if shown > 0 or request.design_mode -%}
  {{ 'zenith-blog.css' | asset_url | stylesheet_tag }}
  {%- capture extra -%}
    --z-bl-cols: {{ s.columns }};
    --z-bl-ggap: {{ s.gap }}px;
    --z-bl-grgap: {{ s.row_gap }}px;
    --z-ac-ih: {{ s.card_image_height }};
    --z-ac-ih-m: {{ s.card_image_height_mobile }};
    --z-ac-tsp: {{ s.title_spacing }}px;
    --z-ac-tsp-m: {{ s.title_spacing_mobile }}px;
    --z-ac-lsp: {{ s.link_spacing }}px;
    --z-ac-lfs: {{ s.link_font_size }}px;
    --z-ac-lfs-m: {{ s.link_font_size_mobile }}px;
    --z-ac-link: {{ s.link_color }};
    --z-ac-exo: {{ s.excerpt_opacity | divided_by: 100.0 }};
  {%- endcapture -%}
  {%- render 'zenith-section-style', section: section, extra: extra -%}

  <section
    id="Zenith-{{ section.id }}"
    class="zenith-section zenith-acards color-{{ s.color_scheme }} gradient{% if section.index > 2 %} zenith-defer{% endif %}{% if s.hide_on_mobile %} zenith-hide-mobile{% endif %}"
  >
    <div class="page-width">
      {%- render 'zenith-section-heading',
        heading: s.heading,
        alignment: s.heading_alignment,
        tag: s.heading_tag,
        class: 'zenith-acards__heading'
      -%}
      {%- if shown > 0 -%}
        <ul class="zenith-blog__grid" role="list">
          {{- cards -}}
        </ul>
      {%- else -%}
        <p class="zenith-acards__empty">Pick a blog with at least one other article (Blog setting), or view this section on an article page.</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}
{%- endcapture -%}
{{- zenith_body | replace: '[customers]', settings.customer_count -}}

{% schema %}
{
  "name": "Zenith · Article cards",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Articles"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Empty = the blog of the article being viewed. The current article is always left out."
    },
    {
      "type": "range",
      "id": "count",
      "label": "Articles to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Article link",
      "default": "Read More"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpts",
      "default": false
    },
    {
      "type": "range",
      "id": "excerpt_words",
      "label": "Excerpt length",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "wds",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show dates",
      "default": false
    },
    {
      "type": "select",
      "id": "date_format",
      "label": "Date format",
      "default": "%-d %b %Y",
      "options": [
        { "value": "%-d %b %Y", "label": "11 Jan 2022" },
        { "value": "%-d %B %Y", "label": "11 January 2022" },
        { "value": "%b %-d, %Y", "label": "Jan 11, 2022" },
        { "value": "%B %-d, %Y", "label": "January 11, 2022" },
        { "value": "%d/%m/%Y", "label": "11/01/2022" },
        { "value": "%m/%d/%Y", "label": "01/11/2022" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "info": "Tablets show 2.",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between columns",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Space between rows",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "card_image_height",
      "label": "Photo height",
      "info": "Percent of the photo's width.",
      "min": 30,
      "max": 120,
      "step": 1,
      "unit": "%",
      "default": 56
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Space between photo and title",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "link_spacing",
      "label": "Space above link",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Article links",
      "default": "#EABE5F"
    },
    {
      "type": "range",
      "id": "excerpt_opacity",
      "label": "Excerpt and date opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "card_heading_tag",
      "label": "Article title tag",
      "default": "h3",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ]
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Article title size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Excerpt size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "link_font_size",
      "label": "Link size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size",
      "min": 20,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_spacing_mobile",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between articles",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_image_height_mobile",
      "label": "Photo height",
      "min": 30,
      "max": 120,
      "step": 1,
      "unit": "%",
      "default": 56
    },
    {
      "type": "range",
      "id": "title_spacing_mobile",
      "label": "Space between photo and title",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Article title size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Excerpt size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "link_font_size_mobile",
      "label": "Link size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Zenith · Article cards"
    }
  ]
}
{% endschema %}
