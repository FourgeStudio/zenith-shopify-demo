{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-newsletter.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- render 'zenith-section-style', section: section -%}

<div
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-newsletter color-{{ s.color_scheme }} gradient{% if s.hide_on_mobile %} zenith-hide-mobile{% endif %}"
>
  <div class="page-width">
    {%- render 'zenith-newsletter-form', s: s, id: section.id -%}
  </div>
</div>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Newsletter",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join The Zenith Tribe"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "info": "For search engines. Use H2 unless this is the page's main heading.",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Get high-performance grooming protocols, exclusive early access to product drops, and unadvertised VIP offers delivered straight to your inbox.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email field placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "richtext",
      "id": "legal",
      "label": "Small print",
      "default": "<p>By clicking Subscribe Now, you agree to our <a href=\"/policies/terms-of-service\" title=\"Terms and Conditions\">Terms and Conditions</a> and <a href=\"/policies/privacy-policy\" title=\"Privacy Policy\">Privacy Policy</a>.</p>"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message after signing up",
      "default": "Thanks for subscribing. Welcome to the tribe."
    },
    {
      "type": "url",
      "id": "redirect_url",
      "label": "Page to open after signing up",
      "info": "Optional, e.g. a \"Thanks for subscribing\" page. Empty = stay here and show the message above."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Box width",
      "min": 400,
      "max": 1440,
      "step": 16,
      "unit": "px",
      "default": 1024
    },
    {
      "type": "range",
      "id": "form_width",
      "label": "Form width (desktop)",
      "min": 240,
      "max": 600,
      "step": 4,
      "unit": "px",
      "default": 384
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Text max width",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between text and form (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Box padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space between heading and text",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "field_height",
      "label": "Email field height",
      "min": 32,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "field_gap",
      "label": "Space between field and button",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Button height",
      "min": 32,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "legal_spacing",
      "label": "Space above small print",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "legal_max_width",
      "label": "Small print max width",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "box_color",
      "label": "Box background",
      "default": "#203940"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Box border",
      "default": "#364C53"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Box text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "text_opacity",
      "label": "Text and small print opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "gold",
      "options": [
        { "value": "gold", "label": "Gold" },
        { "value": "light", "label": "White" },
        { "value": "dark", "label": "Dark blue" },
        { "value": "outline", "label": "Outline" },
        { "value": "scheme", "label": "Color scheme button" }
      ]
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "input_font_size",
      "label": "Email field text size",
      "info": "16px or more stops iPhones zooming in on tap.",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button text size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "legal_font_size",
      "label": "Small print size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "label": "Box padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "form_spacing_mobile",
      "label": "Space above the email field",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_height_mobile",
      "label": "Button height",
      "min": 32,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "label": "Button text size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Zenith · Newsletter"
    }
  ]
}
{% endschema %}
