      "id": "price_font_size",
      "label": "Price size",
      "min": 12,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Benefit text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "badge_font_size",
