{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-featured-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'zenith-featured-product.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign s = section.settings
  # zenith: content is global (Theme settings → Zenith · Featured product), so every page shows the same block;
  # the section only sets layout, colours and spacing. Badge only with "Show badge" on (off by default).
  assign fp_product = settings.zfp_product
  assign fp_badge = ''
  if settings.zfp_show_badge
    assign fp_badge = settings.zfp_badge
  endif
  assign fp_image = settings.zfp_image
  assign fp_image_mobile = settings.zfp_image_mobile
  assign btn_style = s.button_style | default: 'gold'
  assign btn_icon = settings.zfp_button_icon | default: 'cart'
  assign use_slides = false
  assign single = fp_image
  if single == blank and fp_product != blank
    assign product_images = fp_product.media | where: 'media_type', 'image'
    if settings.zfp_show_media_pager and product_images.size > 1
      assign use_slides = true
    else
      assign single = fp_product.featured_media.preview_image
    endif
  endif
  assign media_sizes = '(min-width: 750px) ' | append: s.media_width | append: 'vw, 100vw'
-%}
{%- if use_slides -%}
  <script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- capture extra -%}
  --z-bfs: {{ s.badge_font_size }}px;
  --z-bfs-m: {{ s.badge_font_size_mobile }}px;
  --z-trfs: {{ s.trust_font_size }}px;
  --z-trfs-m: {{ s.trust_font_size_mobile }}px;
  {%- if s.section_background != blank %}
  --z-sec-bg: {{ s.section_background }};
  {%- endif -%}
  {%- if s.section_background_mobile != blank %}
  --z-sec-bg-m: {{ s.section_background_mobile }};
  {%- endif -%}
  {%- if s.panel_background != blank %}
  --z-panel: {{ s.panel_background }};
  {%- endif -%}
  {%- if s.panel_background_mobile != blank %}
  --z-panel-m: {{ s.panel_background_mobile }};
  {%- endif -%}
  {%- if s.badge_background != blank %}
  --z-badge-bg: {{ s.badge_background }};
  {%- endif -%}
  {%- if s.badge_text_color != blank %}
  --z-badge-fg: {{ s.badge_text_color }};
  {%- endif -%}
  {%- if s.price_color != blank %}
  --z-price: {{ s.price_color }};
  {%- endif -%}
  {%- if s.check_color != blank %}
  --z-check: {{ s.check_color }};
  {%- endif -%}
  {%- if s.icon_color != blank %}
  --z-trust-icon: {{ s.icon_color }};
  {%- endif -%}
  {%- if s.pager_color != blank %}
  --z-pager-rgb: {{ s.pager_color.red }}, {{ s.pager_color.green }}, {{ s.pager_color.blue }};
  --z-fp-border: {% if s.border_color != blank and s.border_width > 0 %}{{ s.border_width }}px solid {{ s.border_color }}{% else %}0{% endif %};
  {%- endif %}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-fp zenith-fp--fit-{{ s.image_fit }} zenith-fp--d-{{ s.media_ratio | default: 'fill' }} zenith-fp--m-{{ s.media_ratio_mobile }}{% if s.image_position == 'left' %} zenith-fp--image-left{% endif %}{% if s.mobile_image_first %} zenith-fp--m-image-first{% endif %}"
>
  <div class="{% unless s.full_width %}page-width{% endunless %}">
    <div class="zenith-fp__grid">
      <div class="zenith-fp__content color-{{ s.color_scheme }} gradient">
        <div class="zenith-fp__content-inner">
          {%- if fp_badge != blank -%}
            {%- if s.badge_style == 'pill' -%}
              <span class="zenith-fp__badge{% if s.badge_position_mobile == 'image' %} zenith-hide-mobile{% endif %}">
                {{- fp_badge | escape -}}
              </span>
            {%- else -%}
              <p class="zenith-eyebrow zenith-fp__eyebrow">{{ fp_badge | escape | replace: '[customers]', settings.customer_count }}</p>
            {%- endif -%}
          {%- endif -%}

          <h2 class="zenith-fp__title{% if s.heading_uppercase %} zenith-fp__title--uppercase{% endif %}">
            {%- if fp_product != blank -%}<a href="{{ fp_product.url }}" class="zenith-fp__title-link">{{ fp_product.title | escape }}</a>{%- else -%}{{ 'Zenith Anti-Aging Tallow Cream' }}{%- endif -%}
          </h2>

          {%- if fp_product != blank and settings.zfp_show_rating and fp_product.metafields.reviews.rating.value != blank -%}
            {%- render 'zenith-stars',
              rating: fp_product.metafields.reviews.rating.value.rating,
              count: fp_product.metafields.reviews.rating_count
            -%}
          {%- endif -%}

          <p class="zenith-fp__price">
            {%- if fp_product != blank -%}
              {{ fp_product.price | money_without_trailing_zeros }}
              {%- if fp_product.compare_at_price > fp_product.price and settings.show_compare_price -%}
                <s>{{ fp_product.compare_at_price | money_without_trailing_zeros }}</s>
              {%- endif -%}
            {%- else -%}
              {{ 89900 | money_without_trailing_zeros }}
            {%- endif -%}
          </p>

          {%- liquid
            # Benefits = product metafield custom.benefits (list of single-line text; a multi-line text field works too, one per line)
            assign below = settings.zfp_below_price | default: 'description'
            assign benefit_list = fp_product.metafields.custom.benefits.value
            if benefit_list != blank and benefit_list.first == nil
              assign benefit_list = benefit_list | newline_to_br | split: '<br />'
            endif
            assign show_benefits = false
            if below != 'description' and below != 'page' and benefit_list != blank
              assign show_benefits = true
            endif
            assign show_desc = true
            if below == 'benefits' and show_benefits
              assign show_desc = false
            endif
          -%}
          {%- if below == 'page' and fp_product != blank -%}
            {%- comment -%}
              Same checklist as the product's own page (its Zenith · Product page "Checklist item" blocks), loaded
              from that page by assets/zenith-featured-product.js. A skeleton holds the space while it
              loads; the description shows only if the page has no checklist or can't be loaded.
            {%- endcomment -%}
            <zenith-fp-checks data-url="{{ fp_product.url }}" aria-busy="true">
              <ul class="zenith-fp__benefits zenith-fp__skeleton" role="list" aria-hidden="true">
                {%- for i in (1..6) -%}
                  <li class="zenith-fp__benefit"><span class="zenith-fp__skel-check"></span><span class="zenith-fp__skel-bar"></span></li>
                {%- endfor -%}
              </ul>
              {%- if fp_product.description != blank -%}
                <div class="zenith-fp__desc rte" hidden>{{ fp_product.description }}</div>
              {%- endif -%}
              <noscript><style>.zenith-fp__skeleton { display: none; }</style></noscript>
            </zenith-fp-checks>
          {%- elsif show_desc and fp_product.description != blank -%}
            <div class="zenith-fp__desc rte">{{ fp_product.description }}</div>
          {%- endif -%}
          {%- if show_benefits -%}
            <ul class="zenith-fp__benefits" role="list">
              {%- for benefit in benefit_list -%}
                {%- assign benefit_text = benefit | strip -%}
                {%- if benefit_text != blank -%}
                  <li class="zenith-fp__benefit">
                    <svg class="zenith-fp__check" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <circle cx="12" cy="12" r="12" fill="currentColor"/>
                      <path d="M7.4 12.4l3.1 3.1 6.1-6.3" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>{{ benefit_text | escape | replace: '[customers]', settings.customer_count }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="zenith-fp__actions">
            {%- if fp_product != blank -%}
              {%- assign form_id = 'ZenithFeatured-' | append: section.id -%}
              {%- render 'zenith-add-to-cart',
                product: fp_product,
                form_id: form_id,
                label: settings.zfp_button_label,
                style: btn_style,
                icon: btn_icon,
                class: 'zenith-fp__atc'
              -%}
            {%- else -%}
              <button
                type="button"
                class="button zenith-atc{% unless btn_style == 'scheme' %} zenith-btn zenith-btn--{{ btn_style }}{% endunless %} zenith-fp__atc"
                disabled
              >
                <span>
                  {%- if settings.zfp_button_label != blank -%}{{ settings.zfp_button_label | escape }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
                </span>
                {%- if btn_icon != 'none' and btn_style != 'scheme' -%}
                  {%- render 'zenith-icon', icon: btn_icon, class: 'zenith-btn__icon' -%}
                {%- endif -%}
              </button>
            {%- endif -%}
          </div>

          {%- capture trust_items -%}
            {%- for n in (1..4) -%}
              {%- assign t_text_key = 'zfp_trust_' | append: n | append: '_text' -%}
              {%- assign t_icon_key = 'zfp_trust_' | append: n | append: '_icon' -%}
              {%- liquid
                assign t_text = settings[t_text_key] | downcase
                assign t_show = true
                if settings[t_text_key] == blank
                  assign t_show = false
                elsif settings.zfp_show_money_back == false
                  if t_text contains 'money-back' or t_text contains 'money back'
                    assign t_show = false
                  endif
                endif
              -%}
              {%- if t_show -%}
                <li>
                  {%- render 'zenith-icon', icon: settings[t_icon_key] -%}
                  <span>{{ settings[t_text_key] | escape | replace: '[customers]', settings.customer_count }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if trust_items != blank -%}
            <ul class="zenith-fp__trust zenith-fp__trust--{{ s.trust_alignment }} zenith-fp__trust--m-{{ s.trust_alignment_mobile }}" role="list">
              {{- trust_items -}}
            </ul>
          {%- endif -%}
        </div>
      </div>

      <div class="zenith-fp__media-wrap color-{{ s.media_color_scheme }} gradient">
        {%- if fp_badge != blank and s.badge_style == 'pill' and s.badge_position_mobile == 'image' -%}
          <span class="zenith-fp__badge zenith-fp__badge--media zenith-hide-desktop">{{ fp_badge | escape }}</span>
        {%- endif -%}

        {%- if use_slides -%}
          <zenith-carousel class="zenith-fp__carousel" data-slide-label="Image" data-loop{% if s.slide_autoplay > 0 %} data-autoplay="{{ s.slide_autoplay }}" data-pause-button="false"{% endif %}>
            <ul class="zenith-carousel__track zenith-fp__track" role="list">
              {%- for media in product_images -%}
                {%- capture media_alt -%}{%- render 'zenith-alt', image: media.preview_image, scope: fp_product.handle, fallback: fp_product.title -%}{%- endcapture -%}
                {%- assign fp_focus = '' -%}
                {%- if media.preview_image.presentation.focal_point != blank -%}
                  {%- assign fp_focus = 'object-position: ' | append: media.preview_image.presentation.focal_point -%}
                {%- endif -%}
                <li class="zenith-carousel__slide zenith-fp__slide">
                  <div class="zenith-media zenith-fp__media">
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag: loading: 'lazy', widths: '400, 600, 800, 1100, 1600', sizes: media_sizes, alt: media_alt, style: fp_focus
                    }}
                  </div>
                </li>
              {%- endfor -%}
            </ul>
            {%- render 'zenith-carousel-controls', show_dots: true, show_arrows: false, label: 'image' -%}
          </zenith-carousel>
        {%- else -%}
          {%- comment -%} zenith: the image links to the selected product {%- endcomment -%}
          {%- if fp_product != blank -%}
            <a href="{{ fp_product.url }}" class="zenith-media zenith-fp__media zenith-fp__media--link" aria-label="{{ fp_product.title | escape }}">
          {%- else -%}
            <div class="zenith-media zenith-fp__media">
          {%- endif -%}
            {%- if fp_image != blank and fp_image_mobile != blank -%}
              {%- render 'zenith-responsive-image',
                image: fp_image,
                mobile_image: fp_image_mobile,
                widths: '400, 600, 800, 1100, 1600',
                sizes: media_sizes
              -%}
            {%- elsif single != blank -%}
              {%- assign fp_focus = '' -%}
              {%- if single.presentation.focal_point != blank -%}
                {%- assign fp_focus = 'object-position: ' | append: single.presentation.focal_point -%}
              {%- endif -%}
              {{
                single
                | image_url: width: 1600
                | image_tag: loading: 'lazy', widths: '400, 600, 800, 1100, 1600', sizes: media_sizes, style: fp_focus
              }}
            {%- else -%}
              {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          {%- if fp_product != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Featured product",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "paragraph",
      "content": "Product, badge, button, text under the price, image and trust row: Theme settings → Zenith · Featured product (the same on every page)."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Image column width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 48
    },
    {
      "type": "range",
      "id": "slide_autoplay",
      "label": "Image slides: auto-advance",
      "info": "Seconds per image, endless loop. 0 = off. Pauses on hover/focus.",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image shape (desktop)",
      "info": "Fill the row = the image is as tall as the text panel (it gets cropped). Square / Portrait / Landscape keep that shape, so a photo with text or labels on it shows whole.",
      "default": "fill",
      "options": [
        { "value": "fill", "label": "Fill the row" },
        { "value": "square", "label": "Square 1:1" },
        { "value": "portrait", "label": "Portrait 4:5" },
        { "value": "landscape", "label": "Landscape 4:3" }
      ]
    },
    {
      "type": "range",
      "id": "media_min_height",
      "visible_if": "{{ section.settings.media_ratio == 'fill' or section.settings.media_ratio == blank }}",
      "label": "Minimum height",
      "info": "Desktop. The image grows to match the text panel when that is taller.",
      "min": 240,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 540
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 320,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between content items",
      "min": 4,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill area (crops around the image's focal point)"
        },
        {
          "value": "contain",
          "label": "Show whole image"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_padding",
      "visible_if": "{{ section.settings.image_fit == 'contain' }}",
      "label": "Image padding",
      "info": "Used when Image fit is Show whole image",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "trust_alignment",
      "label": "Trust items alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Content color scheme",
      "default": "scheme-6"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Content panel background",
      "info": "Clear to use the color scheme background",
      "default": "#203940"
    },
    {
      "type": "color_scheme",
      "id": "media_color_scheme",
      "label": "Image background scheme",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "info": "Behind the panel and image. Leave empty to show the page background."
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "gold",
      "options": [
        {
          "value": "gold",
          "label": "Gold gradient"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "scheme",
          "label": "Color scheme button"
        },
        {
          "value": "secondary",
          "label": "Secondary (gray)"
        }
      ]
    },
    {
      "type": "select",
      "id": "badge_style",
      "label": "Badge style",
      "default": "eyebrow",
      "options": [
        { "value": "eyebrow", "label": "Eyebrow text (gold, uppercase)" },
        { "value": "pill", "label": "Pill" }
      ]
    },
    {
      "type": "color",
      "id": "badge_background",
      "visible_if": "{{ section.settings.badge_style == 'pill' }}",
      "label": "Badge background",
      "default": "#EABE5F"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "visible_if": "{{ section.settings.badge_style == 'pill' }}",
      "label": "Badge text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "info": "Empty = text colour at 70% (same as subheadings)."
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Benefit check icons",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Trust icons",
      "default": "#EABE5F"
    },
    { "type": "color", "id": "border_color", "label": "Border color", "info": "Frame around the whole block (text panel + image). Empty = no border." },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 12, "step": 1, "unit": "px", "default": 0 },
    {
      "type": "color",
      "id": "pager_color",
      "label": "Image slider dots",
      "default": "#C5930E"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Title size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase title",
      "default": false
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Price size",
      "min": 12,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Benefit text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "visible_if": "{{ section.settings.badge_style == 'pill' }}",
      "label": "Badge text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "trust_font_size",
      "label": "Trust item text size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_font_size",
      "visible_if": "{{ section.settings.button_style != 'scheme' }}",
      "label": "Button text size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Show image above text on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "badge_position_mobile",
      "visible_if": "{{ section.settings.badge_style == 'pill' }}",
      "label": "Badge position",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "On the image"
        },
        {
          "value": "content",
          "label": "Above the title"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_ratio_mobile",
      "label": "Image shape",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "landscape",
