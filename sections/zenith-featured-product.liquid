{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-featured-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign s = section.settings
  assign fp_product = s.product
  assign btn_style = s.button_style | default: 'gold'
  assign btn_icon = s.button_icon | default: 'cart'
  assign use_slides = false
  assign single = s.image
  if single == blank and fp_product != blank
    assign product_images = fp_product.media | where: 'media_type', 'image'
    if s.show_media_pager and product_images.size > 1
      assign use_slides = true
    else
      assign single = fp_product.featured_media.preview_image
    endif
  endif
  assign media_sizes = '(min-width: 750px) ' | append: s.media_width | append: 'vw, 100vw'
-%}
{%- if use_slides -%}
  <script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- capture extra -%}
  --z-bfs: {{ s.badge_font_size }}px;
  --z-bfs-m: {{ s.badge_font_size_mobile }}px;
  --z-trfs: {{ s.trust_font_size }}px;
  --z-trfs-m: {{ s.trust_font_size_mobile }}px;
  {%- if s.section_background != blank %}
  --z-sec-bg: {{ s.section_background }};
  {%- endif -%}
  {%- if s.section_background_mobile != blank %}
  --z-sec-bg-m: {{ s.section_background_mobile }};
  {%- endif -%}
  {%- if s.panel_background != blank %}
  --z-panel: {{ s.panel_background }};
  {%- endif -%}
  {%- if s.panel_background_mobile != blank %}
  --z-panel-m: {{ s.panel_background_mobile }};
  {%- endif -%}
  {%- if s.badge_background != blank %}
  --z-badge-bg: {{ s.badge_background }};
  {%- endif -%}
  {%- if s.badge_text_color != blank %}
  --z-badge-fg: {{ s.badge_text_color }};
  {%- endif -%}
  {%- if s.price_color != blank %}
  --z-price: {{ s.price_color }};
  {%- endif -%}
  {%- if s.check_color != blank %}
  --z-check: {{ s.check_color }};
  {%- endif -%}
  {%- if s.icon_color != blank %}
  --z-trust-icon: {{ s.icon_color }};
  {%- endif -%}
  {%- if s.pager_color != blank %}
  --z-pager-rgb: {{ s.pager_color.red }}, {{ s.pager_color.green }}, {{ s.pager_color.blue }};
  {%- endif %}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-fp zenith-fp--fit-{{ s.image_fit }} zenith-fp--m-{{ s.media_ratio_mobile }}{% if s.image_position == 'left' %} zenith-fp--image-left{% endif %}{% if s.mobile_image_first %} zenith-fp--m-image-first{% endif %}"
>
  <div class="{% unless s.full_width %}page-width{% endunless %}">
    <div class="zenith-fp__grid">
      <div class="zenith-fp__content color-{{ s.color_scheme }} gradient">
        <div class="zenith-fp__content-inner">
          {%- if s.badge != blank -%}
            <span class="zenith-fp__badge{% if s.badge_position_mobile == 'image' %} zenith-hide-mobile{% endif %}">
              {{- s.badge | escape -}}
            </span>
          {%- endif -%}

          <h2 class="zenith-fp__title{% if s.heading_uppercase %} zenith-fp__title--uppercase{% endif %}">
            {%- if fp_product != blank -%}{{ fp_product.title | escape }}{%- else -%}{{ s.placeholder_title | escape }}{%- endif -%}
          </h2>

          {%- if fp_product != blank and s.show_rating and fp_product.metafields.reviews.rating.value != blank -%}
            {%- render 'zenith-stars',
              rating: fp_product.metafields.reviews.rating.value.rating,
              count: fp_product.metafields.reviews.rating_count
            -%}
          {%- endif -%}

          <p class="zenith-fp__price">
            {%- if fp_product != blank -%}
              {{ fp_product.price | money_without_trailing_zeros }}
              {%- if fp_product.compare_at_price > fp_product.price -%}
                <s>{{ fp_product.compare_at_price | money_without_trailing_zeros }}</s>
              {%- endif -%}
            {%- else -%}
              {{ 89900 | money_without_trailing_zeros }}
            {%- endif -%}
          </p>

          {%- assign benefits = section.blocks | where: 'type', 'benefit' -%}
          {%- if benefits.size > 0 -%}
            <ul class="zenith-fp__benefits" role="list">
              {%- for block in benefits -%}
                <li class="zenith-fp__benefit" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
                  <svg class="zenith-fp__check" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="12" fill="currentColor"/>
                    <path d="M7.4 12.4l3.1 3.1 6.1-6.3" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>{{ block.settings.text | escape | replace: '[customers]', settings.customer_count }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="zenith-fp__actions">
            {%- if fp_product != blank -%}
              {%- assign form_id = 'ZenithFeatured-' | append: section.id -%}
              {%- render 'zenith-add-to-cart',
                product: fp_product,
                form_id: form_id,
                label: s.button_label,
                style: btn_style,
                icon: btn_icon,
                class: 'zenith-fp__atc'
              -%}
            {%- else -%}
              <button
                type="button"
                class="button zenith-atc{% unless btn_style == 'scheme' %} zenith-btn zenith-btn--{{ btn_style }}{% endunless %} zenith-fp__atc"
                disabled
              >
                <span>
                  {%- if s.button_label != blank -%}{{ s.button_label | escape }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
                </span>
                {%- if btn_icon != 'none' and btn_style != 'scheme' -%}
                  {%- render 'zenith-icon', icon: btn_icon, class: 'zenith-btn__icon' -%}
                {%- endif -%}
              </button>
            {%- endif -%}
          </div>

          {%- assign trust_items = section.blocks | where: 'type', 'trust' -%}
          {%- if trust_items.size > 0 -%}
            <ul class="zenith-fp__trust zenith-fp__trust--{{ s.trust_alignment }} zenith-fp__trust--m-{{ s.trust_alignment_mobile }}" role="list">
              {%- for block in trust_items -%}
                <li id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
                  {%- render 'zenith-icon', icon: block.settings.icon -%}
                  <span>{{ block.settings.text | escape | replace: '[customers]', settings.customer_count }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      <div class="zenith-fp__media-wrap color-{{ s.media_color_scheme }} gradient">
        {%- if s.badge != blank and s.badge_position_mobile == 'image' -%}
          <span class="zenith-fp__badge zenith-fp__badge--media zenith-hide-desktop">{{ s.badge | escape }}</span>
        {%- endif -%}

        {%- if use_slides -%}
          <zenith-carousel class="zenith-fp__carousel" data-slide-label="Image">
            <ul class="zenith-carousel__track zenith-fp__track" role="list">
              {%- for media in product_images -%}
                {%- assign media_alt = media.alt | default: fp_product.title -%}
                {%- assign fp_focus = '' -%}
                {%- if media.preview_image.presentation.focal_point != blank -%}
                  {%- assign fp_focus = 'object-position: ' | append: media.preview_image.presentation.focal_point -%}
                {%- endif -%}
                <li class="zenith-carousel__slide zenith-fp__slide">
                  <div class="zenith-media zenith-fp__media">
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag: loading: 'lazy', widths: '400, 600, 800, 1100, 1600', sizes: media_sizes, alt: media_alt, style: fp_focus
                    }}
                  </div>
                </li>
              {%- endfor -%}
            </ul>
            {%- render 'zenith-carousel-controls', show_dots: true, show_arrows: false, label: 'image' -%}
          </zenith-carousel>
        {%- else -%}
          {%- comment -%} zenith: the image links to the selected product {%- endcomment -%}
          {%- if fp_product != blank -%}
            <a href="{{ fp_product.url }}" class="zenith-media zenith-fp__media zenith-fp__media--link" aria-label="{{ fp_product.title | escape }}">
          {%- else -%}
            <div class="zenith-media zenith-fp__media">
          {%- endif -%}
            {%- if s.image != blank and s.image_mobile != blank -%}
              {%- render 'zenith-responsive-image',
                image: s.image,
                mobile_image: s.image_mobile,
                widths: '400, 600, 800, 1100, 1600',
                sizes: media_sizes
              -%}
            {%- elsif single != blank -%}
              {%- assign fp_focus = '' -%}
              {%- if single.presentation.focal_point != blank -%}
                {%- assign fp_focus = 'object-position: ' | append: single.presentation.focal_point -%}
              {%- endif -%}
              {{
                single
                | image_url: width: 1600
                | image_tag: loading: 'lazy', widths: '400, 600, 800, 1100, 1600', sizes: media_sizes, style: fp_focus
              }}
            {%- else -%}
              {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          {%- if fp_product != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Featured product",
  "tag": "div",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "placeholder_title",
      "label": "Title shown when no product is selected",
      "default": "Zenith Anti-Aging Tallow Cream"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Featured Product"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to Cart"
    },
    {
      "type": "select",
      "id": "button_icon",
      "label": "Button icon",
      "default": "cart",
      "options": [
        {
          "value": "cart",
          "label": "Cart"
        },
        {
          "value": "arrow_right",
          "label": "Arrow"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Defaults to the product's images. Best size 1216 × 1076 px (square also works); keep text and the product in the middle, phones crop it square. Tall graphics lose their top and bottom — set a focal point on the image to choose what stays."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional, used with the image above: a different crop for phones (square works best)."
    },
    {
      "type": "checkbox",
      "id": "show_media_pager",
      "label": "Show all product images as a slider",
      "info": "Off = only the product's main image, linked to the product page. Used when no image is selected above and the product has more than one image",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Image column width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 48
    },
    {
      "type": "range",
      "id": "media_min_height",
      "label": "Minimum height",
      "min": 240,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 540
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 320,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between content items",
      "min": 4,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill area (crops around the image's focal point)"
        },
        {
          "value": "contain",
          "label": "Show whole image"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_padding",
      "label": "Image padding",
      "info": "Used when Image fit is Show whole image",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "trust_alignment",
      "label": "Trust items alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Content color scheme",
      "default": "scheme-6"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Content panel background",
      "info": "Clear to use the color scheme background",
      "default": "#203940"
    },
    {
      "type": "color_scheme",
      "id": "media_color_scheme",
      "label": "Image background scheme",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "info": "Behind the panel and image. Leave empty to show the page background."
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "gold",
      "options": [
        {
          "value": "gold",
          "label": "Gold gradient"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "scheme",
          "label": "Color scheme button"
        }
      ]
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#EABE5F"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "default": "#EABE5F"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Benefit check icons",
      "default": "#EABE5F"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Trust icons",
      "default": "#EABE5F"
    },
    {
      "type": "color",
      "id": "pager_color",
      "label": "Image slider dots",
      "default": "#294850"
    },
    {
