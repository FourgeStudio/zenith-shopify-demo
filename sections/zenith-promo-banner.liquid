{{ 'zenith-promo-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  # Content + countdown come from Theme settings → Zenith · Promo unless this section is set to its own content.
  if s.content_source == 'custom'
    assign p_heading = s.heading
    assign p_text = s.text
    assign p_button_label = s.button_label
    assign p_button_link = s.button_link
    assign p_background = s.background_image
    assign p_image = s.image
    assign p_cd_label = s.countdown_label
    assign p_end_date = s.end_date
    assign p_end_time = s.end_time
    assign p_timezone = s.timezone
    assign p_hide_expired = s.hide_when_expired
  else
    assign p_heading = settings.promo_heading
    assign p_text = settings.promo_text
    assign p_button_label = settings.promo_button_label
    assign p_button_link = settings.promo_button_link
    assign p_background = settings.promo_background_image
    assign p_image = settings.promo_image
    assign p_cd_label = settings.promo_countdown_label
    assign p_end_date = settings.promo_end_date
    assign p_end_time = settings.promo_end_time
    assign p_timezone = settings.promo_timezone
    assign p_hide_expired = settings.promo_hide_when_expired
  endif

  assign show_countdown = false
  if p_end_date != blank
    assign show_countdown = true
  endif
-%}

{%- if show_countdown -%}
  {{ 'zenith-countdown.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'zenith-countdown.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- capture extra -%}
  --z-promo-inset: {{ s.card_inset }}px;
  --z-promo-inset-m: {{ s.card_inset_mobile }}px;
  --z-promo-mh: {{ s.card_min_height }}px;
  --z-promo-tg: {{ s.text_spacing }}px;
  --z-promo-bgpos: {{ s.background_position }};
  {%- if s.countdown_background != blank %}
  --z-cd-strip-bg: {{ s.countdown_background }};
  {%- endif %}
  --z-cd-strip-fg: {{ s.countdown_text_color }};
  --z-cd-box: {{ s.countdown_box_color }};
  --z-cd-digit: {{ s.countdown_digit_color }};
  {%- render 'zenith-overlay-vars', settings: s -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<div
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-promo color-{{ s.color_scheme }} gradient zenith-promo--{{ s.card_width }}{% if s.hide_on_mobile %} zenith-hide-mobile{% endif %}{% if s.hide_on_desktop %} zenith-hide-desktop{% endif %}"
>
  <div class="zenith-promo__container{% if s.card_width == 'page' %} page-width{% endif %}">
    <div class="zenith-promo__card color-{{ s.card_color_scheme }} gradient{% if s.image_position == 'left' %} zenith-promo__card--image-left{% endif %}{% if s.mobile_image_first %} zenith-promo__card--m-image-first{% endif %}">
      <div class="zenith-promo__body">
        {%- if p_background != blank -%}
          <div class="zenith-media zenith-promo__bg" aria-hidden="true">
            {{
              p_background
              | image_url: width: 2800
              | image_tag:
                loading: 'lazy',
                widths: '750, 1100, 1500, 2000, 2800',
                sizes: '100vw',
                alt: ''
            }}
            {%- render 'zenith-overlay', style: s.overlay_style -%}
          </div>
        {%- endif -%}

        <div class="zenith-promo__content">
          {%- render 'zenith-section-heading',
            heading: p_heading,
            subheading: p_text,
            alignment: 'left',
            uppercase: s.heading_uppercase,
            tag: 'h2',
            class: 'zenith-promo__heading'
          -%}
          {%- render 'zenith-button',
            label: p_button_label,
            link: p_button_link,
            style: s.button_style,
            class: 'zenith-promo__button'
          -%}
        </div>

        {%- if p_image != blank -%}
          <div class="zenith-promo__image">
            {{
              p_image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 45vw, 90vw'
            }}
          </div>
        {%- elsif p_background == blank -%}
          <div class="zenith-promo__image">
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if show_countdown -%}
        <div class="zenith-promo__countdown" data-countdown-wrapper>
          {%- if p_cd_label != blank -%}
            <p class="zenith-promo__countdown-label">
              {{- p_cd_label | escape | replace: '[customers]', settings.customer_count -}}
            </p>
          {%- endif -%}
          {%- render 'zenith-countdown',
            end_date: p_end_date,
            end_time: p_end_time,
            timezone: p_timezone,
            hide_expired: p_hide_expired,
            show_labels: s.countdown_show_labels
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Zenith · Promo banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "Promo content",
      "default": "global",
      "options": [
        { "value": "global", "label": "Global promo (Theme settings → Zenith · Promo)" },
        { "value": "custom", "label": "This section only" }
      ],
      "info": "Global: edit the promo once in Theme settings → Zenith · Promo and every banner set to Global updates. The content and countdown fields below are only used with \"This section only\"."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Exclusive Offers for this Season"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Bundles and deals built for value. Here for a moment, then gone.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get This Exclusive Offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Fills the banner, e.g. gold confetti + product photo with a light left side for the text. Recommended 2752 × 640px."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Optional. Transparent PNG shown beside the text. Leave empty when the background image already shows the products."
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "This Exclusive Offer Ends In"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date",
      "info": "Format YYYY-MM-DD, e.g. 2026-12-31. Leave empty to hide the countdown.",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time",
      "info": "24-hour HH:MM",
      "default": "23:59"
    },
    {
      "type": "select",
      "id": "timezone",
      "label": "Timezone",
      "default": "+08:00",
      "options": [
        { "value": "+08:00", "label": "Philippines (UTC+8)" },
        { "value": "Z", "label": "UTC" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_when_expired",
      "label": "Hide countdown when it ends",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "countdown_show_labels",
      "label": "Show unit labels (Days, Hrs, Min, Sec)",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "card_width",
      "label": "Banner width",
      "default": "inset",
      "options": [
        { "value": "inset", "label": "Full width with side margin" },
        { "value": "page", "label": "Page width" }
      ]
    },
    {
      "type": "range",
      "id": "card_inset",
      "label": "Side margin",
      "info": "Used with \"Full width with side margin\"",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_min_height",
      "label": "Banner min height (desktop)",
      "info": "Height of the image area, excluding the countdown bar",
      "min": 0,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop product image position",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background image focus",
      "info": "Part of the background kept in view on narrower screens",
      "default": "right center",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Space between heading and text",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space above button",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Banner inner padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Product image max width",
      "min": 120,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "image_max_height",
      "label": "Product image max height",
      "min": 120,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Banner color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "dark",
      "options": [
        { "value": "gold", "label": "Gold gradient" },
        { "value": "dark", "label": "Dark" },
        { "value": "outline", "label": "Outline" },
        { "value": "light", "label": "Light" },
        { "value": "scheme", "label": "Color scheme button" }
      ]
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Background overlay",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "bottom", "label": "Gradient from bottom" },
        { "value": "top", "label": "Gradient from top" },
        { "value": "left", "label": "Gradient from left" },
        { "value": "right", "label": "Gradient from right" }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Gradient length",
      "info": "How far the gradient reaches across the image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color_background",
      "id": "countdown_background",
      "label": "Countdown bar background",
      "default": "linear-gradient(90deg, rgba(214, 179, 86, 1) 50%, rgba(197, 147, 0, 1) 100%)"
    },
    {
      "type": "color",
      "id": "countdown_text_color",
      "label": "Countdown bar text",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "countdown_box_color",
      "label": "Countdown number boxes",
      "default": "#4E3A05"
    },
    {
      "type": "color",
      "id": "countdown_digit_color",
      "label": "Countdown numbers",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Text size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button text size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Countdown label size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "countdown_font_size",
      "label": "Countdown number size",
      "min": 14,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Show product image above text",
      "default": false
    },
    {
      "type": "range",
      "id": "card_inset_mobile",
      "label": "Side margin",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "label": "Button text size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "label": "Space above button",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "label": "Banner inner padding",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_max_height_mobile",
      "label": "Product image max height",
      "min": 120,
      "max": 500,
      "step": 20,
      "unit": "px",
      "default": 240
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Countdown label size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "countdown_font_size_mobile",
      "label": "Countdown number size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
