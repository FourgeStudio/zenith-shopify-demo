{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-promo-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  # Content + countdown come from Theme settings → Zenith · Promo unless this section is set to its own content.
  if s.content_source == 'custom'
    assign p_heading = s.heading
    assign p_text = s.text
    assign p_button_label = s.button_label
    assign p_button_link = s.button_link
    assign p_background = s.background_image
    assign p_image = s.image
    assign p_cd_label = s.countdown_label
    assign p_end_date = s.end_date
    assign p_end_time = s.end_time
    assign p_timezone = s.timezone
    assign p_hide_expired = s.hide_when_expired
  else
    assign p_heading = settings.promo_heading
    assign p_text = settings.promo_text
    assign p_button_label = settings.promo_button_label
    assign p_button_link = settings.promo_button_link
    # Photos picked on this section win over the global ones (the fields show either way, so a pick must work).
    assign p_background = s.background_image | default: settings.promo_background_image
    assign p_image = s.image | default: settings.promo_image
    assign p_cd_label = settings.promo_countdown_label
    assign p_end_date = settings.promo_end_date
    assign p_end_time = settings.promo_end_time
    assign p_timezone = settings.promo_timezone
    assign p_hide_expired = settings.promo_hide_when_expired
  endif

  # Button product: a pick on this section wins over the global one (shown in both modes, like the photos).
  assign p_product = s.button_product
  assign p_action = s.button_action
  if p_product == blank and s.content_source != 'custom'
    assign p_product = settings.promo_button_product
    assign p_action = settings.promo_button_action
  endif
  if p_product != blank and p_action == 'product'
    assign p_button_link = p_product.url
  endif

  assign show_countdown = false
  if p_end_date != blank
    assign show_countdown = true
  endif

  # Split layout: colour panel with the text + photo filling the other half (Product image, else Background image).
  assign is_split = false
  if s.layout_style == 'split'
    assign is_split = true
    assign split_photo = p_image | default: p_background
    # No photo on the live store: drop the empty half, the text panel takes the full width.
    if split_photo == blank and request.design_mode == false
      assign is_split = false
    endif
  endif

  # Store-wide promotion switch (Theme settings → Zenith · Promo → "Promotion is running").
  capture promo_class
    render 'zenith-promo-state', visibility: s.promo_visibility
  endcapture

  # Hidden by the switch → no countdown (and no countdown CSS/JS ticking in a display: none section)
  if promo_class != blank
    assign show_countdown = false
  endif

  # A visible banner at the top of the page (in the hero's place) loads its photo eagerly.
  assign img_loading = 'lazy'
  assign img_priority = 'auto'
  if section.index <= 2 and promo_class == blank
    assign img_loading = 'eager'
    assign img_priority = 'high'
  endif
-%}

{%- if s.promo_visibility != 'always' -%}
  <script src="{{ 'zenith-promo-state.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if show_countdown -%}
  {{ 'zenith-countdown.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'zenith-countdown.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if p_product != blank and p_action != 'product' -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- capture extra -%}
  --z-promo-inset: {{ s.card_inset }}px;
  --z-promo-inset-m: {{ s.card_inset_mobile }}px;
  {%- if s.height_mode == 'screen' %}
  --z-promo-mh: {{ s.card_min_height_screen }}svh;
  --z-promo-mh-m: {{ s.card_min_height_mobile_screen | default: 0 }}svh;
  {%- else %}
  --z-promo-mh: {{ s.card_min_height }}px;
  --z-promo-mh-m: {{ s.card_min_height_mobile | default: 0 }}px;
  {%- endif %}
  --z-promo-tg: {{ s.text_spacing }}px;
  --z-promo-bgpos: {{ s.background_position }};
  --z-promo-ta: {{ s.text_opacity | divided_by: 100.0 }};
  --z-promo-iw: {{ s.split_image_width }}%;
  --z-promo-ih-m: {{ s.split_image_height_mobile }}px;
  --z-promo-pym: {{ s.content_padding_y_mobile }}px;
  --z-promo-cdx-m: {{ s.countdown_inset_mobile }}px;
  {%- if s.heading_max_width_mobile > 0 %}
  --z-promo-hmw-m: {{ s.heading_max_width_mobile }}px;
  {%- endif %}
  {%- if s.text_max_width_mobile > 0 %}
  --z-promo-tmw-m: {{ s.text_max_width_mobile }}px;
  {%- endif %}
  {%- if s.panel_color != blank %}
  --z-promo-panel: {{ s.panel_color }};
  {%- endif %}
  {%- if s.countdown_background != blank %}
  --z-cd-strip-bg: {{ s.countdown_background }};
  {%- endif %}
  --z-cd-strip-fg: {{ s.countdown_text_color }};
  --z-cd-box: {{ s.countdown_box_color }};
  --z-cd-digit: {{ s.countdown_digit_color }};
  --z-cdlfs: {{ s.countdown_label_font_size }}px;
  --z-cdlfs-m: {{ s.countdown_label_font_size_mobile }}px;
  {%- render 'zenith-overlay-vars', settings: s -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<div
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-promo color-{{ s.color_scheme }} gradient zenith-promo--{{ s.card_width }} zenith-promo--{{ s.layout_style }}{% if is_split and s.panel_color != blank %} zenith-promo--panel{% endif %}{% if s.full_width_mobile %} zenith-promo--m-full{% endif %}{% if s.button_full_mobile %} zenith-promo--m-btn-full{% endif %}{% if s.hide_on_mobile %} zenith-hide-mobile{% endif %}{% if s.hide_on_desktop %} zenith-hide-desktop{% endif %}{{ promo_class }}"
  {%- render 'zenith-promo-state', visibility: s.promo_visibility, output: 'attrs' %}
>
  <div class="zenith-promo__container{% if s.card_width == 'page' %} page-width{% endif %}">
    <div class="zenith-promo__card color-{{ s.card_color_scheme }} gradient{% if s.image_position == 'left' %} zenith-promo__card--image-left{% endif %}{% if s.mobile_image_first %} zenith-promo__card--m-image-first{% endif %}">
      <div class="zenith-promo__body">
        {%- if is_split == false and p_background != blank -%}
          <div class="zenith-media zenith-promo__bg" aria-hidden="true">
            {{
              p_background
              | image_url: width: 2800
              | image_tag:
                loading: img_loading,
                fetchpriority: img_priority,
                widths: '750, 1100, 1500, 2000, 2800',
                sizes: '100vw',
                alt: ''
            }}
            {%- render 'zenith-overlay', style: s.overlay_style -%}
          </div>
        {%- endif -%}
        {%- render 'zenith-confetti', settings: s -%}

        <div class="zenith-promo__content">
          {%- assign p_tag = s.heading_tag | default: 'h2' -%}
          {%- render 'zenith-section-heading',
            heading: p_heading,
            subheading: p_text,
            alignment: 'left',
            uppercase: s.heading_uppercase,
            tag: p_tag,
            class: 'zenith-promo__heading'
          -%}
          {%- if p_product != blank and p_action != 'product' and p_button_label != blank -%}
            {%- assign form_id = 'ZenithPromoATC-' | append: section.id -%}
            {%- render 'zenith-add-to-cart',
              product: p_product,
              form_id: form_id,
              label: p_button_label,
              style: s.button_style,
              icon: 'arrow_right',
              class: 'zenith-promo__button'
            -%}
          {%- else -%}
            {%- render 'zenith-button',
              label: p_button_label,
              link: p_button_link,
              style: s.button_style,
              class: 'zenith-promo__button'
            -%}
          {%- endif -%}
        </div>

        {%- if is_split -%}
          <div class="zenith-media zenith-promo__photo">
            {%- if split_photo != blank -%}
              {{
                split_photo
                | image_url: width: 1600
                | image_tag:
                  loading: img_loading,
                  fetchpriority: img_priority,
                  widths: '400, 600, 800, 1100, 1600',
                  sizes: '(min-width: 750px) 50vw, 100vw'
              }}
            {%- elsif request.design_mode -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- elsif p_image != blank -%}
          <div class="zenith-promo__image">
            {{
              p_image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 45vw, 90vw'
            }}
          </div>
        {%- elsif p_background == blank and request.design_mode -%}
          <div class="zenith-promo__image">
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if show_countdown -%}
        <div class="zenith-promo__countdown" data-countdown-wrapper>
          {%- if p_cd_label != blank -%}
            <p class="zenith-promo__countdown-label">
              {{- p_cd_label | escape | replace: '[customers]', settings.customer_count -}}
            </p>
          {%- endif -%}
          {%- render 'zenith-countdown',
            end_date: p_end_date,
            end_time: p_end_time,
            timezone: p_timezone,
            hide_expired: p_hide_expired,
            show_labels: s.countdown_show_labels
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Promo banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "Promo content",
      "default": "global",
      "options": [
        { "value": "global", "label": "Global promo (Theme settings → Zenith · Promo)" },
        { "value": "custom", "label": "This section only" }
      ],
      "info": "Global: edit the promo once in Theme settings → Zenith · Promo and every banner set to Global updates. The text and countdown fields below are only used with \"This section only\"; a Background or Product image picked here is used either way (instead of the global one)."
    },
    {
      "type": "text",
      "id": "heading",
      "visible_if": "{{ section.settings.content_source == 'custom' }}",
      "label": "Heading",
      "default": "Exclusive Offers for this Season"
    },
    {
      "type": "richtext",
      "id": "text",
      "visible_if": "{{ section.settings.content_source == 'custom' }}",
      "label": "Text",
      "default": "<p>Bundles and deals built for value. Here for a moment, then gone.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "visible_if": "{{ section.settings.content_source == 'custom' }}",
      "label": "Button label",
      "default": "Get This Exclusive Offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "visible_if": "{{ section.settings.content_source == 'custom' }}",
      "label": "Button link"
    },
    {
      "type": "product",
      "id": "button_product",
      "label": "Button product",
      "info": "Optional. Used with Global content too (instead of the global product). When set, the button adds this product to the cart or opens its page, instead of the Button link."
    },
    {
      "type": "select",
      "id": "button_action",
      "label": "Button product action",
      "default": "cart",
      "options": [
        { "value": "cart", "label": "Add to cart" },
        { "value": "product", "label": "Open product page" }
      ]
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Fills the banner, e.g. gold confetti + product photo with a light left side for the text. Recommended 2752 × 640px."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Optional. Transparent PNG shown beside the text. Leave empty when the background image already shows the products."
    },
    {
      "type": "checkbox",
      "id": "show_confetti",
      "label": "Show gold confetti",
      "default": false,
      "info": "Gold confetti across the top of the banner (earlier white banner design). Upload background images without confetti."
    },
    {
      "type": "image_picker",
      "id": "confetti_image",
      "visible_if": "{{ section.settings.show_confetti }}",
      "label": "Custom confetti image",
      "info": "Optional transparent PNG. Leave empty for the built-in gold confetti."
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "text",
      "id": "countdown_label",
      "visible_if": "{{ section.settings.content_source == 'custom' }}",
      "label": "Countdown label",
      "default": "This Exclusive Offer Ends In"
    },
    {
      "type": "text",
      "id": "end_date",
      "visible_if": "{{ section.settings.content_source == 'custom' }}",
      "label": "End date",
      "info": "Format YYYY-MM-DD, e.g. 2026-12-31. Leave empty to hide the countdown.",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "end_time",
      "visible_if": "{{ section.settings.content_source == 'custom' }}",
      "label": "End time",
      "info": "24-hour HH:MM",
      "default": "23:59"
    },
    {
      "type": "select",
      "id": "timezone",
      "visible_if": "{{ section.settings.content_source == 'custom' }}",
      "label": "Timezone",
      "default": "+08:00",
      "options": [
        { "value": "+08:00", "label": "Philippines (UTC+8)" },
        { "value": "Z", "label": "UTC" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_when_expired",
      "visible_if": "{{ section.settings.content_source == 'custom' }}",
      "label": "Hide countdown when it ends",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "countdown_show_labels",
      "label": "Show unit labels (Days, Hours, Minutes, Seconds)",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "promo_visibility",
      "label": "Show",
      "default": "promo_on",
      "options": [
        { "value": "promo_on", "label": "Only while the promotion runs" },
        { "value": "promo_off", "label": "Only when no promotion runs" },
        { "value": "always", "label": "Always" }
      ],
      "info": "Follows Theme settings → Zenith · Promo → \"Promotion is running\". Hidden sections stay in the page code for search engines."
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Banner layout",
      "default": "split",
      "options": [
        { "value": "split", "label": "Split: colour panel + photo" },
        { "value": "background", "label": "Background image" }
      ],
      "info": "Split uses the Product image as the photo (Background image if empty)."
    },
    {
      "type": "range",
      "id": "split_image_width",
      "visible_if": "{{ section.settings.layout_style == 'split' }}",
      "label": "Photo width (split, desktop)",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "card_width",
      "label": "Banner width",
      "default": "inset",
      "options": [
        { "value": "inset", "label": "Full width with side margin" },
        { "value": "page", "label": "Page width" }
      ]
    },
    {
      "type": "range",
      "id": "card_inset",
      "visible_if": "{{ section.settings.card_width == 'inset' }}",
      "label": "Side margin",
      "info": "Used with \"Full width with side margin\"",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Banner height",
      "info": "% of screen height suits a promo in the hero spot. Mobile heights are under Mobile (split layout: Mobile → Photo height).",
      "default": "px",
      "options": [
        { "value": "px", "label": "Fixed (px)" },
        { "value": "screen", "label": "% of screen height" }
      ]
    },
    {
      "type": "range",
      "id": "card_min_height_screen",
      "visible_if": "{{ section.settings.height_mode == 'screen' }}",
      "label": "Banner min height (desktop, % of screen)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 65
    },
    {
      "type": "range",
      "id": "card_min_height",
      "visible_if": "{{ section.settings.height_mode == 'px' }}",
      "label": "Banner min height (desktop, fixed)",
      "info": "Height of the image area, excluding the countdown bar",
      "min": 0,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop product image position",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "background_position",
      "visible_if": "{{ section.settings.layout_style == 'background' }}",
      "label": "Background image focus",
      "info": "Part of the background kept in view on narrower screens",
      "default": "right center",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "visible_if": "{{ section.settings.layout_style == 'background' }}",
      "label": "Content max width",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Space between heading and text",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space above button",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Banner inner padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "image_max_width",
      "visible_if": "{{ section.settings.layout_style == 'background' }}",
      "label": "Product image max width",
      "min": 120,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "image_max_height",
      "visible_if": "{{ section.settings.layout_style == 'background' }}",
      "label": "Product image max height",
      "min": 120,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "select",
      "id": "confetti_align",
      "visible_if": "{{ section.settings.show_confetti }}",
      "label": "Confetti position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Top left"
        },
        {
          "value": "center",
          "label": "Top center"
        },
        {
          "value": "right",
          "label": "Top right"
        },
        {
          "value": "stretch",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "confetti_width",
      "visible_if": "{{ section.settings.show_confetti and section.settings.confetti_align != 'stretch' }}",
      "label": "Confetti width (desktop)",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "default": 970
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Banner color scheme",
      "default": "scheme-6"
    },
    {
      "type": "color",
      "id": "panel_color",
      "visible_if": "{{ section.settings.layout_style == 'split' }}",
      "label": "Panel colour",
      "info": "Optional flat colour behind the text (split layout), instead of the banner color scheme background.",
      "default": "#112328"
    },
    {
      "type": "range",
      "id": "text_opacity",
      "label": "Text opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "gold",
      "options": [
        { "value": "gold", "label": "Gold gradient" },
        { "value": "dark", "label": "Dark" },
        { "value": "outline", "label": "Outline" },
        { "value": "light", "label": "Light" },
        { "value": "scheme", "label": "Color scheme button" }
      ]
    },
    {
      "type": "select",
      "id": "overlay_style",
      "visible_if": "{{ section.settings.layout_style == 'background' }}",
      "label": "Background overlay",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "bottom", "label": "Gradient from bottom" },
        { "value": "top", "label": "Gradient from top" },
        { "value": "left", "label": "Gradient from left" },
        { "value": "right", "label": "Gradient from right" }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "visible_if": "{{ section.settings.layout_style == 'background' and section.settings.overlay_style != 'none' }}",
      "label": "Overlay color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "visible_if": "{{ section.settings.layout_style == 'background' and section.settings.overlay_style != 'none' }}",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "visible_if": "{{ section.settings.layout_style == 'background' and section.settings.overlay_style != 'none' and section.settings.overlay_style != 'solid' }}",
