{{ 'zenith-promo-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zenith-countdown.js' | asset_url }}" defer="defer"></script>
{%- capture extra -%}
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- liquid
  assign show_countdown = false
  if section.settings.end_date != blank
    assign show_countdown = true
    assign end_time = section.settings.end_time | default: '23:59'
    assign end_iso = section.settings.end_date | append: 'T' | append: end_time | append: ':00' | append: section.settings.timezone
  endif
-%}

<div
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-promo color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    <div class="zenith-promo__card color-{{ section.settings.card_color_scheme }} gradient{% if section.settings.image_position == 'left' %} zenith-promo__card--image-left{% endif %}{% if section.settings.mobile_image_first %} zenith-promo__card--m-image-first{% endif %}">
      {%- if section.settings.background_image != blank -%}
        <div class="zenith-media zenith-promo__bg" aria-hidden="true">
          {{
            section.settings.background_image
            | image_url: width: 2400
            | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: ''
          }}
          {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
        </div>
      {%- endif -%}

      <div class="zenith-promo__body">
        <div class="zenith-promo__content">
          {%- render 'zenith-section-heading',
            heading: section.settings.heading,
            subheading: section.settings.text,
            alignment: 'left',
            uppercase: section.settings.heading_uppercase,
            tag: 'h2',
            class: 'zenith-promo__heading'
          -%}
          {%- if section.settings.button_label != blank -%}
            <a
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>

        <div class="zenith-promo__image">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 45vw, 90vw'
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      {%- if show_countdown -%}
        <div class="zenith-promo__countdown color-{{ section.settings.countdown_color_scheme }} gradient" data-countdown-wrapper>
          {%- if section.settings.countdown_label != blank -%}
            <span class="zenith-promo__countdown-label">{{ section.settings.countdown_label | escape }}</span>
          {%- endif -%}
          <zenith-countdown
            class="zenith-countdown"
            data-end="{{ end_iso | escape }}"
            data-hide-expired="{{ section.settings.hide_when_expired }}"
            role="timer"
          >
            {%- assign units = 'days,hours,minutes,seconds' | split: ',' -%}
            {%- assign unit_labels = 'Days,Hrs,Min,Sec' | split: ',' -%}
            {%- for unit in units -%}
              <span class="zenith-countdown__unit">
                <span class="zenith-countdown__value" data-unit="{{ unit }}">00</span>
                <span class="zenith-countdown__label">{{ unit_labels[forloop.index0] }}</span>
              </span>
            {%- endfor -%}
          </zenith-countdown>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Zenith · Promo banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Exclusive Offers for this Season"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Bundles and deals built for value. Here for a moment, then gone.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get This Exclusive Offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Transparent PNG recommended"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional texture, e.g. gold confetti"
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "This Exclusive Offer Ends in"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date",
      "info": "Format YYYY-MM-DD, e.g. 2026-12-31. Leave empty to hide the countdown.",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time",
      "info": "24-hour HH:MM",
      "default": "23:59"
    },
    {
      "type": "select",
      "id": "timezone",
      "label": "Timezone",
      "default": "+08:00",
      "options": [
        {
          "value": "+08:00",
          "label": "Philippines (UTC+8)"
        },
        {
          "value": "Z",
          "label": "UTC"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_when_expired",
      "label": "Hide countdown when it ends",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between heading and button",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Banner inner padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image max width",
      "min": 120,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "image_max_height",
      "label": "Image max height",
      "min": 120,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Banner color scheme",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "countdown_color_scheme",
      "label": "Countdown bar color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Image overlay",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "bottom",
          "label": "Gradient from bottom"
        },
        {
          "value": "top",
          "label": "Gradient from top"
        },
        {
          "value": "left",
          "label": "Gradient from left"
        },
        {
          "value": "right",
          "label": "Gradient from right"
        }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Gradient length",
      "info": "How far the gradient reaches across the image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "checkbox",
