{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-category-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.mobile_layout == 'carousel' -%}
  <script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- liquid
  assign needs_bg_video = false
  for b in section.blocks
    if b.settings.media_type == 'video' and b.settings.video != blank
      assign needs_bg_video = true
    elsif b.settings.media_type == 'youtube' and b.settings.youtube_url != blank
      assign needs_bg_video = true
    endif
  endfor
-%}
{%- if needs_bg_video -%}
  <script src="{{ 'zenith-bg-video.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- capture extra -%}
  --z-cols: {{ section.settings.columns_desktop }};
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
  --z-ov-solid: {{ section.settings.overlay_solid }}%;
  --z-slide-m: {{ section.settings.mobile_card_width }}%;
  --z-card-h: {{ section.settings.card_height }}px;
  --z-card-h-m: {{ section.settings.card_height_mobile }}px;
  --z-sub-a: {{ section.settings.subheading_opacity | divided_by: 100.0 }};
  --z-smw-m: {{ section.settings.subheading_max_width_mobile }}px;
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- liquid
  assign heading_class = 'zenith-cats__heading zenith-cats__heading--m-' | append: section.settings.heading_alignment_mobile
  assign btn_style = section.settings.button_style | default: 'gold'
  assign btn_icon = section.settings.button_icon | default: 'arrow_right'
-%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-cats color-{{ section.settings.color_scheme }} gradient zenith-cats--{{ section.settings.aspect_ratio }} zenith-cats--m-{{ section.settings.mobile_layout }}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      uppercase: section.settings.heading_uppercase,
      class: heading_class
    -%}

    <zenith-carousel class="zenith-cats__carousel">
      <ul class="zenith-cats__grid zenith-carousel__track" role="list">
        {%- for block in section.blocks -%}
          <li
            class="zenith-cats__item zenith-carousel__slide{% if block.settings.hide_on_mobile %} zenith-hide-mobile{% endif %}"
            id="Block-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {%- liquid
              # Media: the linked collection's featured image (or the add-to-cart product's), a custom image/GIF,
              # an uploaded video or a YouTube link. Videos keep an image underneath as the poster.
              assign media_type = block.settings.media_type | default: 'featured'
              assign featured_img = block.settings.collection.featured_image | default: block.settings.product.featured_image
              assign has_video = false
              if media_type == 'video' and block.settings.video != blank
                assign has_video = true
              endif
              assign has_youtube = false
              if media_type == 'youtube' and block.settings.youtube_url != blank
                assign has_youtube = true
              endif
              case media_type
                when 'image', 'youtube'
                  assign card_img = block.settings.image | default: featured_img
                when 'video'
                  assign card_img = block.settings.image | default: block.settings.video.preview_image | default: featured_img
                else
                  assign card_img = featured_img | default: block.settings.image
              endcase
              assign yt_thumb = false
              if card_img == blank
                assign yt_thumb = true
              endif
              assign card_link = block.settings.link | default: block.settings.collection.url
            -%}
            <div class="zenith-cats__card color-{{ section.settings.card_color_scheme }}">
              <div class="zenith-media zenith-cats__media">
                {%- if card_img != blank -%}
                  {{
                    card_img
                    | image_url: width: 1000
                    | image_tag: loading: 'lazy', widths: '375, 550, 750, 1000', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw'
                  }}
                {%- elsif has_youtube == false -%}
                  {%- assign placeholder = forloop.index0 | modulo: 6 | plus: 1 | prepend: 'collection-' -%}
                  {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                {%- if has_video -%}
                  {%- render 'zenith-bg-video', video: block.settings.video, title: block.settings.title -%}
                {%- elsif has_youtube -%}
                  {%- render 'zenith-bg-video', youtube: block.settings.youtube_url, title: block.settings.title, thumbnail: yt_thumb -%}
                {%- endif -%}
                {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
              </div>
              <div class="zenith-cats__content">
                {%- if block.settings.title != blank -%}
                  <h3 class="zenith-cats__title">{{ block.settings.title | escape | replace: '[customers]', settings.customer_count }}</h3>
                {%- endif -%}
                {%- liquid
                  assign use_atc = false
                  if block.settings.product != blank and card_link == blank
                    assign use_atc = true
                  endif
                -%}
                {%- if use_atc or block.settings.button_label != blank -%}
                  <div class="zenith-cats__actions{% if block.settings.button_full_width %} zenith-cats__actions--full{% endif %}">
                    {%- if use_atc -%}
                      {%- assign form_id = 'ZenithCat-' | append: block.id -%}
                      {%- render 'zenith-add-to-cart',
                        product: block.settings.product,
                        form_id: form_id,
                        label: block.settings.button_label,
                        style: btn_style,
                        icon: btn_icon,
                        class: 'zenith-cats__button'
                      -%}
                    {%- else -%}
                      {%- render 'zenith-button',
                        label: block.settings.button_label,
                        link: card_link,
                        style: btn_style,
                        icon: btn_icon,
                        class: 'zenith-cats__button'
                      -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              {%- if card_link != blank -%}
                <a href="{{ card_link | escape }}" class="zenith-cats__overlay-link" tabindex="-1" aria-hidden="true"></a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </zenith-carousel>
  </div>
</section>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Category cards",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products formulated for the Philippine Climate"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Honest gear for your skin, your hair, and the man wearing it.</p>"
    },
    {
      "type": "select",
      "id": "button_icon",
      "label": "Button icon",
      "default": "arrow_right",
      "options": [
        {
          "value": "arrow_right",
          "label": "Arrow"
        },
        {
          "value": "cart",
          "label": "Cart"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Card shape",
      "default": "fixed",
      "options": [
        {
          "value": "fixed",
          "label": "Fixed height"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "tall",
          "label": "Tall 3:4"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height",
      "info": "Used when Card shape is Fixed height",
      "min": 240,
      "max": 800,
      "step": 8,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Card text padding",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between title and button",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card text scheme",
      "info": "Text sits on the image, so pick a scheme with light text",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "gold",
      "options": [
        {
          "value": "gold",
          "label": "Gold gradient"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "scheme",
          "label": "Color scheme button"
        }
      ]
    },
    {
      "type": "range",
      "id": "subheading_opacity",
      "label": "Subheading opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Image overlay",
      "default": "bottom",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "bottom",
          "label": "Gradient from bottom"
        },
        {
          "value": "top",
          "label": "Gradient from top"
        },
        {
          "value": "left",
          "label": "Gradient from left"
        },
        {
          "value": "right",
          "label": "Gradient from right"
        }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#294850"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Gradient length",
      "info": "How far the gradient reaches across the image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "overlay_solid",
      "label": "Solid part of gradient",
      "info": "Area at the gradient's edge that stays fully covered (bottom gradient)",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Card title size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button text size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "heading_alignment_mobile",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "stack",
      "options": [
        {
          "value": "carousel",
          "label": "Swipe carousel"
        },
        {
          "value": "grid",
          "label": "2-column grid"
        },
        {
          "value": "stack",
          "label": "Stacked"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Mobile card width (carousel)",
      "min": 50,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "label": "Card height",
      "info": "Used when Card shape is Fixed height",
      "min": 200,
      "max": 720,
      "step": 8,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "subheading_max_width_mobile",
      "label": "Subheading max width",
      "min": 160,
      "max": 400,
      "step": 8,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "heading_spacing_mobile",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between cards",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Card title size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
