      "type": "range",
      "id": "button_font_size_mobile",
      "label": "Button text size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "label": "Card text padding",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
