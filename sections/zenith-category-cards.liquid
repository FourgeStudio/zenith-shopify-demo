{{ 'zenith-category-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.mobile_layout == 'carousel' -%}
  <script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- capture extra -%}
  --z-cols: {{ section.settings.columns_desktop }};
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
  --z-slide-m: {{ section.settings.mobile_card_width }}%;
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-cats color-{{ section.settings.color_scheme }} gradient zenith-cats--{{ section.settings.aspect_ratio }} zenith-cats--m-{{ section.settings.mobile_layout }}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      size: section.settings.heading_size
    -%}

    <zenith-carousel class="zenith-cats__carousel">
      <ul class="zenith-cats__grid zenith-carousel__track" role="list">
        {%- for block in section.blocks -%}
          <li class="zenith-cats__item zenith-carousel__slide" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="zenith-cats__card color-{{ section.settings.card_color_scheme }}">
              <div class="zenith-media zenith-cats__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1000
                    | image_tag: loading: 'lazy', widths: '375, 550, 750, 1000', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 80vw'
                  }}
                {%- else -%}
                  {%- assign placeholder = forloop.index0 | modulo: 6 | plus: 1 | prepend: 'collection-' -%}
                  {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
              </div>
              <div class="zenith-cats__content">
                {%- if block.settings.title != blank -%}
                  <h3 class="zenith-cats__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.product != blank and block.settings.link == blank -%}
                  {%- assign form_id = 'ZenithCat-' | append: block.id -%}
                  {%- render 'zenith-add-to-cart',
                    product: block.settings.product,
                    form_id: form_id,
                    label: block.settings.button_label,
                    class: 'zenith-cats__button'
                  -%}
                {%- elsif block.settings.button_label != blank -%}
                  <a
                    {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                    class="button zenith-cats__button"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="zenith-cats__overlay-link" tabindex="-1" aria-hidden="true"></a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </zenith-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Category cards",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products formulated for the Philippine Climate"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Honest gear for your skin, your hair, and the men wearing it.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Card shape",
      "default": "portrait",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "tall",
          "label": "Tall 3:4"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card text and button scheme",
      "info": "Text sits on the image, so pick a scheme with light text",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Image overlay",
      "default": "bottom",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "bottom",
          "label": "Gradient from bottom"
        },
        {
          "value": "top",
          "label": "Gradient from top"
        },
        {
          "value": "left",
          "label": "Gradient from left"
        },
        {
          "value": "right",
          "label": "Gradient from right"
        }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Gradient length",
      "info": "How far the gradient reaches across the image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "lg",
      "options": [
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ]
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "carousel",
      "options": [
        {
          "value": "carousel",
          "label": "Swipe carousel"
        },
        {
          "value": "grid",
          "label": "2-column grid"
        },
        {
          "value": "stack",
          "label": "Stacked"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Mobile card width (carousel)",
      "min": 50,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Built for humid days and long commutes"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Add-to-cart product",
          "info": "Used only when Link is empty. The button adds this product to the cart."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith · Category cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "The tallow cream that repairs and restores your skin",
            "button_label": "Shop Skin Products"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Thin density sprays built for the dryness on your scalp",
            "button_label": "Shop Hair Products"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Full body care for the hard-working man",
            "button_label": "Add to Cart"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Personal care to complete your routine",
            "button_label": "Add to Cart"
          }
        }
      ]
    }
  ]
}
{% endschema %}
