      "info": "How far the gradient reaches across the image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "color",
      "id": "ribbon_color",
      "label": "Ribbon background",
      "default": "#F6233B"
    },
    {
      "type": "color",
      "id": "ribbon_text_color",
      "label": "Ribbon text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "highlight_color",
