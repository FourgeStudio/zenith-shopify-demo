{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign has_promo = false
  if s.ribbon_text != blank or s.highlight_title != blank or s.badge_text != blank
    assign has_promo = true
  endif

  # Countdown strip: own dates, or the store-wide promo from Theme settings → Zenith · Promo.
  if s.countdown_source == 'global'
    assign cd_label = s.countdown_label | default: settings.promo_countdown_label
    assign cd_end_date = settings.promo_end_date
    assign cd_end_time = settings.promo_end_time
    assign cd_timezone = settings.promo_timezone
    assign cd_hide_expired = settings.promo_hide_when_expired
  else
    assign cd_label = s.countdown_label
    assign cd_end_date = s.countdown_end_date
    assign cd_end_time = s.countdown_end_time
    assign cd_timezone = s.countdown_timezone
    assign cd_hide_expired = s.countdown_hide_expired
  endif

  assign show_countdown = false
  if cd_end_date != blank and s.countdown_source != 'off'
    assign show_countdown = true
  endif

  assign btn_style = s.button_style | default: 'gold'
  assign btn_icon = s.button_icon | default: 'arrow_right'
  # Empty link on a collection page → that collection (e.g. "Shop Skin Care Products" on the Skin page)
  assign btn_link = s.button_link
  if btn_link == blank and collection != blank
    assign btn_link = collection.url
  endif
  assign mobile_label = s.button_label_mobile | default: s.button_label
  assign mobile_link = s.button_link_mobile | default: btn_link
  assign split_buttons = false
  if s.button_label_mobile != blank or s.button_link_mobile != blank
    assign split_buttons = true
  endif

  # Collection pages can take the heading/text from the collection being viewed (default collection template).
  assign hero_heading = s.heading
  assign hero_heading_mobile = s.heading_mobile
  assign hero_text = s.text
  if s.use_collection_content and collection != blank
    assign hero_heading = collection.title
    assign hero_heading_mobile = blank
    if collection.description != blank
      assign hero_text = collection.description
    endif
  endif

  # Store-wide promotion switch (Theme settings → Zenith · Promo) can hide this hero, e.g. while a promo banner takes its place.
  capture promo_class
    render 'zenith-promo-state', visibility: s.promo_visibility
  endcapture

  # Only a visible hero at the top of the page loads its image eagerly with high priority.
  assign img_loading = 'lazy'
  assign img_priority = 'auto'
  if section.index <= 2 and promo_class == blank
    assign img_loading = 'eager'
    assign img_priority = 'high'
  endif
-%}

{%- if s.promo_visibility != 'always' -%}
  <script src="{{ 'zenith-promo-state.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if show_countdown -%}
  {{ 'zenith-countdown.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'zenith-countdown.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if s.button_product != blank -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- capture extra -%}
  {%- comment -%} svh = height with the phone's browser bars showing, so the hero doesn't jump while scrolling {%- endcomment -%}
  {%- if s.height_mode == 'px' %}
  --z-hero-h: {{ s.height }}px;
  --z-hero-h-m: {{ s.mobile_height }}px;
  {%- else %}
  --z-hero-h: {{ s.height_screen }}svh;
  --z-hero-h-m: {{ s.mobile_height_screen }}svh;
  {%- endif %}
  --z-hero-py: {{ s.vertical_padding }}px;
  --z-hero-btn-minw: {{ s.button_min_width | default: 0 }}px;
  --z-hero-py-m: {{ s.vertical_padding_mobile }}px;
  --z-hero-eg: {{ s.eyebrow_spacing }}px;
  --z-hero-tg: {{ s.text_spacing }}px;
  --z-ov-cover-m: {{ s.mobile_overlay_coverage }}%;
  --z-ov-solid: {{ s.overlay_solid | default: 0 }}%;
  --z-ov-solid-m: {{ s.mobile_overlay_solid | default: 0 }}%;
  --z-hl-fs: {{ s.highlight_font_size }}px;
  --z-hl-fs-m: {{ s.highlight_font_size_mobile }}px;
  --z-rib-fs: {{ s.ribbon_font_size }}px;
  --z-rib-fs-m: {{ s.ribbon_font_size_mobile }}px;
  --z-badge-fs: {{ s.badge_font_size }}px;
  --z-badge-fs-m: {{ s.badge_font_size_mobile }}px;
  --z-rib-bg: {{ s.ribbon_color }};
  --z-rib-fg: {{ s.ribbon_text_color }};
  --z-hl-color: {{ s.highlight_color }};
  --z-badge-bg: {{ s.badge_color }};
  --z-badge-fg: {{ s.badge_text_color }};
  --z-cd-strip-bg: {{ s.countdown_background_color }};
  --z-cd-strip-fg: {{ s.countdown_text_color }};
  --z-cd-box: {{ s.countdown_box_color }};
  --z-cd-digit: {{ s.countdown_digit_color }};
  --z-cdlfs: {{ s.countdown_label_font_size }}px;
  --z-cdlfs-m: {{ s.countdown_label_font_size_mobile }}px;
  --z-hero-pg: {{ s.paragraph_spacing | default: 0 }}px;
  --z-hero-tmw: {{ s.text_max_width | default: 1000 }}px;
  --z-hero-text-o: {{ s.text_opacity | default: 100 | divided_by: 100.0 }};
  {%- if s.content_max_width_mobile < 1000 -%}
    --z-hero-cmw-m: {{ s.content_max_width_mobile }}px;
  {%- endif -%}
  --z-hero-tsp: {{ s.trust_spacing }}px;
  --z-hero-trw: {{ s.trust_max_width }}px;
  --z-hero-tr-fs: {{ s.trust_font_size }}px;
  --z-hero-tr-fs-m: {{ s.trust_font_size_mobile }}px;
  --z-hero-tr-icon: {{ s.trust_icon_size }}px;
  --z-hero-tr-icon-m: {{ s.trust_icon_size_mobile }}px;
  --z-hero-tr-color: {{ s.trust_icon_color }};
  --z-hero-icon-sp: {{ s.icon_spacing }}px;
  --z-hero-icon-sp-m: {{ s.icon_spacing_mobile }}px;
  --z-hero-icon-color: {{ s.icon_color }};
  {%- if s.display_text != blank -%}
    --z-hero-dfs: {{ s.display_font_size }}px;
    --z-hero-dfs-m: {{ s.display_font_size_mobile }}px;
    --z-hero-dsp: {{ s.display_spacing }}px;
    --z-hero-dsp-m: {{ s.display_spacing_mobile }}px;
    --z-hero-d1: {{ s.display_color }};
    --z-hero-d2: {{ s.display_color_2 }};
  {%- endif -%}
  {%- render 'zenith-overlay-vars', settings: s -%}
  --z-hero-sih-m: {{ s.mobile_image_height | default: 300 }}px;
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-hero color-{{ s.color_scheme }} gradient zenith-hero--{{ s.content_position }} zenith-hero--v-{{ s.content_vertical }} zenith-hero--m-{{ s.mobile_alignment }} zenith-hero--m-text-{{ s.mobile_text_alignment }}{% if s.mobile_button_bottom %} zenith-hero--m-pin{% endif %}{% if s.mobile_button_full %} zenith-hero--m-full{% endif %}{% if s.desktop_layout == 'image_beside' %} zenith-hero--split{% endif %}{% if s.panel_width == 'page' %} zenith-hero--framed{% endif %}{% if s.button_full %} zenith-hero--btn-full{% endif %}{% if s.mobile_layout == 'stacked' %} zenith-hero--m-stacked{% endif %}{{ promo_class }}"
  {%- render 'zenith-promo-state', visibility: s.promo_visibility, output: 'attrs' %}
>
  <div class="zenith-hero__inner">
    {%- unless s.show_image == false -%}
      <div class="zenith-media zenith-hero__media">
        {%- if s.image != blank or s.mobile_image != blank -%}
          {%- comment -%} Desktop + mobile image: the device downloads only the one it shows {%- endcomment -%}
          {%- render 'zenith-responsive-image',
            image: s.image,
            mobile_image: s.mobile_image,
            loading: img_loading,
            fetchpriority: img_priority
          -%}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    {%- endunless -%}
    {%- render 'zenith-overlay', style: s.overlay_style, mobile_style: s.mobile_overlay_style -%}
    {%- render 'zenith-confetti', settings: s -%}

    <div class="page-width zenith-hero__content-wrap">
      <div class="zenith-hero__content">
        {%- if s.icon_image != blank -%}
          <div class="zenith-hero__icon">
            {{- s.icon_image | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '200px', alt: s.icon_image.alt -}}
          </div>
        {%- elsif s.icon != blank and s.icon != 'none' -%}
          <div class="zenith-hero__icon">{%- render 'zenith-icon', icon: s.icon -%}</div>
        {%- endif -%}
        {%- if s.display_text != blank -%}
          <p class="zenith-hero__display">{{ s.display_text | escape }}</p>
        {%- endif -%}
        {%- if has_promo -%}
          <div class="zenith-hero__promo">
            {%- if s.ribbon_text != blank -%}
              <p class="zenith-hero__ribbon">
                {{- s.ribbon_text | escape | replace: '[customers]', settings.customer_count -}}
              </p>
            {%- endif -%}
            {%- if s.highlight_title != blank -%}
              <p class="zenith-hero__highlight">
                {{- s.highlight_title | escape | replace: '[customers]', settings.customer_count -}}
              </p>
            {%- endif -%}
            {%- if s.badge_text != blank -%}
              <p class="zenith-hero__badge">
                {{- s.badge_text | escape | replace: '[customers]', settings.customer_count -}}
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if hero_heading_mobile != blank -%}
          {%- render 'zenith-section-heading',
            eyebrow: s.eyebrow,
            heading: hero_heading,
            subheading: hero_text,
            alignment: s.content_position,
            uppercase: s.heading_uppercase,
            tag: s.heading_tag,
            class: 'zenith-hero__heading zenith-hide-mobile'
          -%}
          {%- render 'zenith-section-heading',
            eyebrow: s.eyebrow,
            heading: hero_heading_mobile,
            subheading: hero_text,
            alignment: s.content_position,
            uppercase: s.heading_uppercase,
            tag: s.heading_tag,
            class: 'zenith-hero__heading zenith-hide-desktop'
          -%}
        {%- else -%}
          {%- render 'zenith-section-heading',
            eyebrow: s.eyebrow,
            heading: hero_heading,
            subheading: hero_text,
            alignment: s.content_position,
            uppercase: s.heading_uppercase,
            tag: s.heading_tag,
            class: 'zenith-hero__heading'
          -%}
        {%- endif -%}

        {%- if s.button_label != blank or mobile_label != blank -%}
          <div class="zenith-hero__actions{% if s.mobile_hide_button %} zenith-hide-mobile{% endif %}">
            {%- liquid
              assign desktop_hide = ''
              if split_buttons
                assign desktop_hide = ' zenith-hide-mobile'
              endif
            -%}
            {%- if s.button_label != blank -%}
              {%- if s.button_product != blank -%}
                {%- assign form_id = 'ZenithHeroATC-' | append: section.id -%}
                <div class="zenith-hero__atc{{ desktop_hide }}">
                  {%- comment -%} zenith-btn: keeps the brand button font/size for "Color scheme button" too, like the link button {%- endcomment -%}
                  {%- render 'zenith-add-to-cart',
                    product: s.button_product,
                    form_id: form_id,
                    label: s.button_label,
                    style: btn_style,
                    icon: btn_icon,
                    class: 'zenith-hero__button zenith-btn'
                  -%}
                </div>
              {%- else -%}
                {%- assign btn_class = 'zenith-hero__button' | append: desktop_hide -%}
                {%- render 'zenith-button',
                  label: s.button_label,
                  link: btn_link,
                  style: btn_style,
                  icon: btn_icon,
                  class: btn_class
                -%}
              {%- endif -%}
            {%- endif -%}
            {%- if split_buttons -%}
              {%- render 'zenith-button',
                label: mobile_label,
                link: mobile_link,
                style: btn_style,
                icon: btn_icon,
                class: 'zenith-hero__button zenith-hide-desktop'
              -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- assign trust_items = section.blocks | where: 'type', 'trust' -%}
        {%- capture hero_trust -%}
          {%- for block in trust_items -%}
            {%- liquid
                assign mbg_text = block.settings.text | downcase
                if section.settings.show_money_back == false
                  if mbg_text contains 'money-back' or mbg_text contains 'money back'
                    continue
                  endif
                endif
              -%}
            <li id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}
                {%- render 'zenith-icon', icon: block.settings.icon -%}
              {%- endif -%}
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        {%- endcapture -%}
        {%- if hero_trust != blank -%}
          <ul class="zenith-hero__trust" role="list">{{ hero_trust }}</ul>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if show_countdown -%}
    <div class="zenith-hero__countdown" data-countdown-wrapper>
      <div class="page-width zenith-hero__countdown-inner">
        {%- if cd_label != blank -%}
          <p class="zenith-hero__countdown-label">
            {{- cd_label | escape | replace: '[customers]', settings.customer_count -}}
          </p>
        {%- endif -%}
        {%- render 'zenith-countdown',
          end_date: cd_end_date,
          end_time: cd_end_time,
          timezone: cd_timezone,
          hide_expired: cd_hide_expired,
          show_labels: s.countdown_show_labels
        -%}
      </div>
    </div>
  {%- endif -%}
</section>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Hero",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_money_back",
      "label": "Show Money-Back Guarantee",
      "info": "Off hides any trust item that mentions the Zenith Money-Back Guarantee (it stays in the announcement bar and the guarantee sections).",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted by [customers] Filipino men",
      "info": "[customers] shows the number set in Theme settings → Zenith → Customer count."
    },
    {
      "type": "checkbox",
      "id": "use_collection_content",
      "label": "Use collection title/description on collection pages",
      "info": "Replaces the heading (and text, when the collection has a description) with the collection being viewed.",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Maintenance System Built for Filipino Men"
    },
    {
      "type": "text",
      "id": "heading_mobile",
      "label": "Mobile heading",
      "info": "Optional. Leave blank to use the heading above."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Everything you need to stay in your prime.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to Cart"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty on a collection page = that collection."
    },
    {
      "type": "product",
      "id": "button_product",
      "label": "Add product to cart",
      "info": "Optional. When set, the desktop button adds this product to the cart instead of following the link."
    },
    {
      "type": "text",
      "id": "button_label_mobile",
      "label": "Mobile button label",
      "default": "Shop Zenith Products",
      "info": "Optional. Leave this and the mobile link blank to use the same button as desktop."
    },
    {
      "type": "url",
      "id": "button_link_mobile",
      "label": "Mobile button link",
      "info": "Optional. Blank = button link above."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Recommended 2880 × 1080px"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Recommended 1206 × 1620px"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show background image",
      "default": true,
      "info": "Off = plain background (color scheme + overlay), e.g. thank-you pages."
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon above heading",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "mail_open", "label": "Envelope" },
        { "value": "check_circle", "label": "Check" },
        { "value": "badge_check", "label": "Badge" },
        { "value": "gift", "label": "Gift" },
        { "value": "box", "label": "Box" },
        { "value": "shield", "label": "Shield" }
      ]
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Custom icon image",
      "info": "Replaces the icon above."
    },
    {
      "type": "text",
      "id": "display_text",
      "label": "Big display text",
      "info": "Large gold number or word above the heading, e.g. 404."
    },
    {
      "type": "checkbox",
      "id": "show_confetti",
      "label": "Show gold confetti",
      "default": false,
      "info": "For sale campaigns (design: 9.9 sale hero). Shows across the top of the hero."
    },
    {
      "type": "image_picker",
      "id": "confetti_image",
      "visible_if": "{{ section.settings.show_confetti }}",
      "label": "Custom confetti image",
      "info": "Optional transparent PNG. Leave empty for the built-in gold confetti."
    },
    {
      "type": "header",
      "content": "Sale extras (optional)"
    },
    {
      "type": "paragraph",
      "content": "Ribbon, highlight title and badge show above the eyebrow for sale campaigns. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "ribbon_text",
      "label": "Ribbon text",
      "placeholder": "GET UP TO 50% OFF SELECT PRODUCTS"
    },
    {
      "type": "text",
      "id": "highlight_title",
      "label": "Highlight title",
      "placeholder": "9.9 SALE IS HERE"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "placeholder": "Philippine FDA Notified"
    },
    {
      "type": "header",
      "content": "Countdown strip (optional)"
    },
    {
      "type": "select",
      "id": "countdown_source",
      "label": "Countdown dates",
      "default": "custom",
      "options": [
        { "value": "custom", "label": "This section (fields below)" },
        { "value": "global", "label": "Global promo (Theme settings → Zenith · Promo)" },
        { "value": "off", "label": "Off" }
      ],
      "info": "Global uses the promo end date/time from Theme settings, so the strip ends together with every promo banner. Countdown text below overrides the global label."
    },
    {
      "type": "text",
      "id": "countdown_label",
      "visible_if": "{{ section.settings.countdown_source != 'off' }}",
      "label": "Countdown text",
      "placeholder": "Payday Sale for Aug 13–15 Only. End in"
    },
    {
      "type": "text",
      "id": "countdown_end_date",
      "visible_if": "{{ section.settings.countdown_source == 'custom' }}",
      "label": "End date",
      "placeholder": "2026-09-15",
      "info": "Format YYYY-MM-DD. Leave empty to hide the strip."
    },
    {
      "type": "text",
      "id": "countdown_end_time",
      "visible_if": "{{ section.settings.countdown_source == 'custom' }}",
      "label": "End time",
      "default": "23:59",
      "info": "24-hour HH:MM"
    },
    {
      "type": "select",
      "id": "countdown_timezone",
      "visible_if": "{{ section.settings.countdown_source == 'custom' }}",
      "label": "Timezone",
      "default": "+08:00",
      "options": [
        { "value": "+08:00", "label": "Philippines (UTC+8)" },
        { "value": "Z", "label": "UTC" }
      ]
    },
    {
      "type": "checkbox",
      "id": "countdown_hide_expired",
      "visible_if": "{{ section.settings.countdown_source == 'custom' }}",
      "label": "Hide strip when the countdown ends",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "countdown_show_labels",
      "visible_if": "{{ section.settings.countdown_source != 'off' }}",
      "label": "Show unit labels (Days, Hours, Minutes, Seconds)",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "promo_visibility",
      "label": "Show",
      "default": "always",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "promo_off", "label": "Only when no promotion runs" },
        { "value": "promo_on", "label": "Only while the promotion runs" }
      ],
      "info": "Follows Theme settings → Zenith · Promo → \"Promotion is running\". Hidden sections stay in the page code for search engines."
    },
            {
      "type": "checkbox",
      "id": "button_full",
      "label": "Full-width button (desktop)",
      "default": false
    },
    {
      "type": "range",
      "id": "button_min_width",
      "label": "Button minimum width (desktop)",
      "info": "0 = fits the label.",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 0
    },
{
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "default": "image_behind",
      "options": [
        { "value": "image_behind", "label": "Image behind the text" },
        { "value": "image_beside", "label": "Image beside the text" }
      ]
    },
    {
      "type": "select",
      "id": "panel_width",
      "label": "Width (desktop)",
      "default": "full",
      "options": [
        { "value": "full", "label": "Edge to edge" },
        { "value": "page", "label": "Inside the page margins" }
      ]
    },
    {
      "type": "range",
      "id": "media_width",
      "visible_if": "{{ section.settings.desktop_layout == 'image_beside' }}",
      "label": "Image width (image beside the text)",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
{
      "type": "select",
      "id": "content_position",
      "label": "Desktop content alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Desktop content vertical position",
