{{ 'zenith-hero.css' | asset_url | stylesheet_tag }}

{%- capture extra -%}
  --z-hero-h: {{ section.settings.height }}px;
  --z-hero-h-m: {{ section.settings.mobile_height }}px;
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-hero color-{{ section.settings.color_scheme }} gradient zenith-hero--{{ section.settings.content_position }} zenith-hero--v-{{ section.settings.content_vertical }} zenith-hero--m-{{ section.settings.mobile_alignment }}"
>
  <div class="zenith-hero__inner">
    <div class="zenith-media zenith-hero__media">
      {%- if section.settings.image != blank -%}
        {%- assign desktop_class = '' -%}
        {%- if section.settings.mobile_image != blank -%}
          {%- assign desktop_class = 'zenith-hide-mobile' -%}
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2400',
            sizes: '100vw',
            fetchpriority: 'high',
            loading: 'eager',
            class: desktop_class
        }}
        {%- if section.settings.mobile_image != blank -%}
          {{
            section.settings.mobile_image
            | image_url: width: 1500
            | image_tag:
              widths: '375, 550, 750, 1100, 1500',
              sizes: '100vw',
              fetchpriority: 'high',
              loading: 'eager',
              class: 'zenith-hide-desktop'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    {%- render 'zenith-overlay', style: section.settings.overlay_style, mobile_style: section.settings.mobile_overlay_style -%}

    <div class="page-width zenith-hero__content-wrap">
      <div class="zenith-hero__content">
        {%- render 'zenith-section-heading',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          subheading: section.settings.text,
          alignment: section.settings.content_position,
          uppercase: section.settings.heading_uppercase,
          tag: section.settings.heading_tag,
          class: 'zenith-hero__heading'
        -%}
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="button zenith-hero__button"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Hero",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted by 100,000+ Filipino men"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Maintenance System Built for Filipino Men"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Everything you need to stay in your prime.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to Cart"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Recommended 2880 × 1120px"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Recommended 1125 × 1500px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Content vertical position",
      "default": "middle",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
