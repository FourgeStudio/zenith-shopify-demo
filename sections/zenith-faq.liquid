{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{%- comment -%} No questions → skip the section on the storefront (a lone heading over nothing); the editor keeps it {%- endcomment -%}
{%- liquid
  assign faq_shared = false
  if section.settings.content_source == 'global'
    assign faq_shared = true
  endif
  assign faq_has_items = false
  if faq_shared
    for i in (1..15)
      assign q_key = 'faq' | append: i | append: '_question'
      if settings[q_key] != blank
        assign faq_has_items = true
        break
      endif
    endfor
  elsif section.blocks.size > 0
    assign faq_has_items = true
  endif
-%}
{%- if faq_has_items or request.design_mode -%}
{{ 'zenith-faq.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  --z-faq-w: {{ section.settings.max_width }}px;
  --z-faq-icon: {{ section.settings.icon_color }};
  --z-faq-ans: {{ section.settings.answer_opacity | divided_by: 100.0 }};
  --z-faq-div: {{ section.settings.divider_opacity | divided_by: 100.0 }};
  --z-sub-a: {{ section.settings.subheading_opacity | divided_by: 100.0 }};
  --z-sub-a-m: {{ section.settings.subheading_opacity_mobile | divided_by: 100.0 }};
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-faq zenith-faq--m-{{ section.settings.heading_alignment_mobile }} color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    <div class="zenith-faq__inner">
      {%- render 'zenith-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        alignment: section.settings.heading_alignment,
        uppercase: section.settings.heading_uppercase
      -%}

      <div class="zenith-faq__list">
        {%- render 'zenith-faq-items',
          blocks: section.blocks,
          open_first: section.settings.open_first,
          open_all: section.settings.open_all,
          schema: section.settings.enable_schema,
          section_id: section.id,
          shared: faq_shared
        -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

