{{ 'zenith-faq.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  --z-faq-w: {{ section.settings.max_width }}px;
  --z-faq-icon: {{ section.settings.icon_color }};
  --z-faq-ans: {{ section.settings.answer_opacity | divided_by: 100.0 }};
  --z-faq-div: {{ section.settings.divider_opacity | divided_by: 100.0 }};
  --z-sub-a: {{ section.settings.subheading_opacity | divided_by: 100.0 }};
  --z-sub-a-m: {{ section.settings.subheading_opacity_mobile | divided_by: 100.0 }};
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-faq zenith-faq--m-{{ section.settings.heading_alignment_mobile }} color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    <div class="zenith-faq__inner">
      {%- render 'zenith-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        alignment: section.settings.heading_alignment,
        uppercase: section.settings.heading_uppercase
      -%}

      <div class="zenith-faq__list">
        {%- for block in section.blocks -%}
          <details
            class="zenith-faq__item"
            id="Block-{{ block.id }}"
            {% if forloop.first and section.settings.open_first %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="zenith-faq__question" id="FaqQuestion-{{ block.id }}-{{ section.id }}">
              <span class="zenith-faq__question-text">
                {{- block.settings.question | escape | replace: '[customers]', settings.customer_count -}}
              </span>
              <span class="zenith-faq__icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false">
                  <path d="M10 1v18M1 10h18"/>
                </svg>
              </span>
            </summary>
            <div
              class="zenith-faq__answer zenith-rte"
              role="region"
              aria-labelledby="FaqQuestion-{{ block.id }}-{{ section.id }}"
            >
              {{ block.settings.answer | replace: '[customers]', settings.customer_count }}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.enable_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | replace: '[customers]', settings.customer_count | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | replace: '[customers]', settings.customer_count | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Zenith · FAQ",
  "tag": "div",
  "class": "section",
  "max_blocks": 30,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>No-nonsense answers about your daily essentials.</p>"
    },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Add FAQ structured data for search engines",
      "info": "Use on only one FAQ section per page",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Question padding",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space below answer",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Plus / close icon",
      "default": "#EABE5F"
    },
    {
      "type": "range",
      "id": "divider_opacity",
      "label": "Divider opacity",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 10
    },
    {
      "type": "range",
      "id": "answer_opacity",
      "label": "Answer text opacity",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
