{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{% comment %}
  Zenith · Store links — "Our Official Stores": marketplace cards (glyph · handle · stat).
  Desktop: cards in one row, content inline + centred. Mobile: 2-column grid, glyph left, handle over stat.
  A store without its own link falls back to Theme settings → Zenith → Marketplaces (Lazada, Shopee) or Social media (TikTok).
{% endcomment %}
{{ 'zenith-store-links.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
-%}
{%- capture extra -%}
  --z-sl-cols: {{ s.columns_desktop }};
  --z-sl-cols-m: {{ s.columns_mobile }};
  --z-sl-h: {{ s.card_min_height }}px;
  --z-sl-h-m: {{ s.card_min_height_mobile }}px;
  --z-sl-ggap: {{ s.glyph_gap }}px;
  --z-sl-ggap-m: {{ s.glyph_gap_mobile }}px;
  --z-sl-tgap: {{ s.text_gap }}px;
  --z-sl-tgap-m: {{ s.text_gap_mobile }}px;
  --z-sl-bg: {{ s.card_background }};
  --z-sl-border: {{ s.card_border_color }};
  --z-sl-bw: {{ s.card_border_width }}px;
  --z-sl-glyph: {{ s.glyph_color }};
  --z-sl-handle: {{ s.handle_color }};
  --z-sl-handle-a: {{ s.handle_opacity | divided_by: 100.0 }};
  --z-sl-stat: {{ s.stat_color }};
  --z-sl-lh: {{ s.line_height | default: 130 | divided_by: 100.0 }};
  --z-sl-lh-m: {{ s.line_height_mobile | default: 130 | divided_by: 100.0 }};
  --z-sl-radius: {{ s.card_radius | default: 0 }}px;
  {%- if s.card_width > 0 %}
  --z-sl-cw: {{ s.card_width }}px;
  --z-sl-justify: {% if s.heading_alignment == 'left' %}flex-start{% else %}center{% endif %};
  --z-sl-ml: {% if s.heading_alignment == 'left' %}0{% else %}auto{% endif %};
  {%- endif %}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-store-links color-{{ s.color_scheme }} gradient zenith-store-links--{{ s.card_layout }} zenith-store-links--align-{{ s.card_alignment }} zenith-store-links--m-{{ s.card_layout_mobile }} zenith-store-links--m-align-{{ s.card_alignment_mobile }} zenith-store-links--m-heading-{{ s.heading_alignment_mobile }}{% if s.card_width > 0 %} zenith-store-links--fixed{% endif %}{% if s.hover_effect == false %} zenith-store-links--no-hover{% endif %}"
>
  <div class="page-width">
    {%- liquid
      # Desktop shows only the heading (mobile heading + text are mobile only): no heading → hide the wrapper so its margin leaves no gap
      assign heading_class = 'zenith-store-links__heading'
      if s.heading == blank
        assign heading_class = heading_class | append: ' zenith-hide-desktop'
      endif
    -%}
    {%- render 'zenith-section-heading',
      eyebrow: blank,
      heading: s.heading,
      heading_mobile: s.heading_mobile,
      subheading: s.text_mobile,
      alignment: s.heading_alignment,
      class: heading_class
    -%}

    {%- liquid
      # Cards: Theme settings → Zenith · Official pages (slots op1–op8, same on every page) or this section's blocks
      assign use_global = false
      if section.settings.content_source == 'global'
        assign use_global = true
        assign item_max = 8
      else
        assign item_max = section.blocks.size
      endif
      assign item_total = 0
      if use_global
        for n in (1..item_max)
          assign k = 'op' | append: n | append: '_link'
          assign k2 = 'op' | append: n | append: '_handle'
          if settings[k] != blank or settings[k2] != blank
            assign item_total = item_total | plus: 1
          endif
        endfor
      else
        assign item_total = item_max
      endif
    -%}
    {%- if item_total > 0 -%}
      <ul class="zenith-store-links__grid" role="list">
        {%- for n in (1..item_max) -%}
          {%- liquid
            if use_global
              assign p = 'op' | append: n | append: '_'
              assign k = p | append: 'icon'
              assign s_icon = settings[k]
              assign k = p | append: 'custom_icon'
              assign s_custom_icon = settings[k]
              assign k = p | append: 'handle'
              assign s_handle = settings[k]
              assign k = p | append: 'stat'
              assign s_stat = settings[k]
              assign k = p | append: 'link'
              assign s_link = settings[k]
              assign k = p | append: 'store_name'
              assign s_store_name = settings[k]
              assign s_new_tab = settings.op_new_tab
              assign s_attrs = ''
              if s_link == blank and s_handle == blank
                continue
              endif
            else
              assign block = section.blocks[forloop.index0]
              assign s_icon = block.settings.icon
              assign s_custom_icon = block.settings.custom_icon
              assign s_handle = block.settings.handle
              assign s_stat = block.settings.stat
              assign s_link = block.settings.link
              assign s_store_name = block.settings.store_name
              assign s_new_tab = block.settings.new_tab
              assign s_attrs = 'id="Block-' | append: block.id | append: '" ' | append: block.shopify_attributes
            endif
            assign link = s_link
            assign store_name = s_store_name
            case s_icon
              when 'lazada'
                if link == blank
                  assign link = settings.social_lazada_link
                endif
                assign store_name = store_name | default: 'Lazada'
              when 'shopee'
                if link == blank
                  assign link = settings.social_shopee_link
                endif
                assign store_name = store_name | default: 'Shopee'
              when 'tiktok_shop'
                if link == blank
                  assign link = settings.social_tiktok_link
                endif
                assign store_name = store_name | default: 'TikTok Shop'
              when 'facebook'
                if link == blank
                  assign link = settings.social_facebook_link
                endif
                assign store_name = store_name | default: 'Facebook'
              when 'instagram'
                if link == blank
                  assign link = settings.social_instagram_link
                endif
                assign store_name = store_name | default: 'Instagram'
            endcase
            if s_icon == 'custom' and s_custom_icon != blank and store_name == blank
              assign store_name = s_custom_icon.alt
            endif
            assign card_tag = 'div'
            if link != blank
              assign card_tag = 'a'
            endif
          -%}
          <li class="zenith-store-links__item" {{ s_attrs }}>
            <{{ card_tag }}
              class="zenith-store-links__card{% if link != blank %} zenith-store-links__card--link{% endif %}"
              {% if link != blank %}
                href="{{ link | escape }}"
                {% if s_new_tab %}
                  target="_blank" rel="noopener"
                {% endif %}
              {% endif %}
            >
            {%- comment -%} "Custom" with no image uploaded: no glyph box, so the text doesn't sit after an empty gap {%- endcomment -%}
            {%- unless s_icon == 'custom' and s_custom_icon == blank -%}
            <span class="zenith-store-links__glyph" aria-hidden="true">
              {%- if s_icon == 'custom' -%}
                {{
                  s_custom_icon
                  | image_url: width: 160
                  | image_tag: loading: 'lazy', widths: '48, 80, 120, 160', sizes: '48px', alt: ''
                }}
              {%- else -%}
                {%- render 'zenith-icon', icon: s_icon, class: 'zenith-store-links__icon' -%}
              {%- endif -%}
            </span>
            {%- endunless -%}
            {%- if store_name != blank -%}
              <span class="visually-hidden">{{ store_name | escape }}</span>
            {%- endif -%}
            <span class="zenith-store-links__text">
              {%- if s_handle != blank -%}
                <span class="zenith-store-links__handle">{{ s_handle | escape }}</span>
              {%- endif -%}
              {%- if s_stat != blank -%}
                <span class="zenith-store-links__stat">{{ s_stat | escape | replace: '[customers]', settings.customer_count }}</span>
              {%- endif -%}
            </span>
            {%- if link != blank and s_new_tab -%}
              <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
            {%- endif -%}
            </{{ card_tag }}>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Store links",
  "tag": "div",
  "class": "section",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "Cards",
      "info": "Official pages = Theme settings → Zenith · Official pages (edit once, same on every page). This section's cards = the Store blocks below.",
      "default": "custom",
      "options": [
        { "value": "global", "label": "Official pages (Theme settings)" },
        { "value": "custom", "label": "This section's cards" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Official Stores"
    },
    {
      "type": "text",
      "id": "heading_mobile",
      "label": "Mobile heading",
      "info": "Optional. Replaces the heading on mobile."
    },
    {
      "type": "richtext",
      "id": "text_mobile",
      "label": "Text under the heading (mobile only)",
      "info": "Optional. Hidden on desktop."
    },
    {
      "type": "paragraph",
      "content": "Add one Store block per marketplace. A store without its own link uses Theme settings → Zenith → Marketplaces (Lazada, Shopee) or Theme settings → Social media (TikTok, Facebook, Instagram)."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Brighten linked cards on hover",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns",
      "info": "Cards per row, up to 5. More cards wrap to the next row.",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "card_layout",
      "label": "Card layout",
      "default": "inline",
      "options": [
        { "value": "inline", "label": "Icon, handle and stat in one row" },
        { "value": "stacked", "label": "Icon beside handle over stat" }
      ]
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card content alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "info": "0 = cards fill the columns. Above 0, cards keep this width (at most Columns per row, extra cards wrap) and the row is centred, or left when the heading is left-aligned. Desktop only.",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_min_height",
      "label": "Card height",
      "info": "Minimum height. Cards grow to fit the icon + 16px (and wrapped text), so values below that show no change.",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 74
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Card side padding",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "glyph_gap",
      "label": "Space after icon",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Space between handle and stat",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "info": "Also fills the cut-outs of the store icons.",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#363636"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "glyph_color",
      "label": "Icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Handle color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "handle_opacity",
      "label": "Handle opacity",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "color",
      "id": "stat_color",
      "label": "Stat color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 41
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Handle size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Stat size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Handle and stat line height",
      "info": "Spacing of lines when a handle or page name wraps",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 130
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "heading_alignment_mobile",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "card_layout_mobile",
      "label": "Card layout",
      "default": "stacked",
      "options": [
        { "value": "inline", "label": "Icon, handle and stat in one row" },
        { "value": "stacked", "label": "Icon beside handle over stat" }
      ]
    },
    {
      "type": "select",
      "id": "card_alignment_mobile",
      "label": "Card content alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "range",
      "id": "card_min_height_mobile",
      "label": "Card height",
      "info": "Minimum height. Cards grow to fit the icon + 16px and the handle and stat lines (about 65px on a 375px phone with the defaults).",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between cards",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_padding_mobile",
      "label": "Card side padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
