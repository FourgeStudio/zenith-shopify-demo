      "label": "Image width (beside text)",
      "min": 80,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 152
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "icon_position",
