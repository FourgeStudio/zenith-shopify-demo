      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "info": "Shown when no image is selected",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "refresh",
              "label": "Money back"
            },
            {
              "value": "cash",
              "label": "Cash"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "certified",
              "label": "Certified"
            },
            {
              "value": "leaf",
              "label": "Natural"
            },
            {
              "value": "sun",
              "label": "Climate"
            },
            {
              "value": "droplet",
              "label": "Droplet"
            },
            {
              "value": "lock",
              "label": "Secure"
            },
            {
              "value": "box",
