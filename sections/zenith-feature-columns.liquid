{{ 'zenith-feature-columns.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_payment_icons -%}{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}{%- endif -%}
{%- capture extra -%}
  --z-cols: {{ section.settings.columns_desktop }};
  --z-cols-m: {{ section.settings.columns_mobile }};
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-features color-{{ section.settings.color_scheme }} gradient zenith-features--media-{{ section.settings.media_position }} zenith-features--{{ section.settings.image_ratio }} zenith-features--{{ section.settings.text_alignment }}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      size: section.settings.heading_size
    -%}

    <ul class="zenith-features__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="zenith-features__item" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="zenith-media zenith-features__media">
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '(min-width: 750px) 15vw, 40vw'
              }}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <div class="zenith-features__icon">{%- render 'zenith-icon', icon: block.settings.icon -%}</div>
          {%- else -%}
            <div class="zenith-media zenith-features__media">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
          <div class="zenith-features__text">
            {%- if block.settings.title != blank -%}
              <h3 class="zenith-features__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="zenith-features__body zenith-rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_payment_icons or section.settings.footer_image != blank or section.settings.footer_text != blank -%}
      <div class="zenith-features__footer">
        {%- if section.settings.footer_image != blank -%}
          {{
            section.settings.footer_image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 750px) 600px, 90vw', class: 'zenith-features__footer-image'
          }}
        {%- endif -%}
        {%- if section.settings.show_payment_icons -%}
          <ul class="list-payment zenith-features__payments" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.footer_text != blank -%}
          <div class="zenith-features__footer-text zenith-rte">{{ section.settings.footer_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Feature columns",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Zenith Guarantee" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "footer_image", "label": "Footer image", "info": "e.g. payment and courier logos (GCash, Maya, J&T)" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show store payment icons", "default": false },
    { "type": "richtext", "id": "footer_text", "label": "Footer text", "default": "<p>Secure checkout. Cash on delivery available nationwide.</p>" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    {
      "type": "select", "id": "media_position", "label": "Image position", "default": "left",
      "options": [ { "value": "top", "label": "Above text" }, { "value": "left", "label": "Beside text" } ]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image shape", "default": "portrait",
      "options": [ { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" } ]
    },
    {
      "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },

    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },

    { "type": "header", "content": "Typography" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "lg",
      "options": [ { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }, { "value": "xl", "label": "Extra large" } ]
    },

    { "type": "header", "content": "Mobile" },
    {
      "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "1",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ]
    },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "header", "content": "Content" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select", "id": "icon", "label": "Icon", "info": "Shown when no image is selected", "default": "none",
          "options": [
            { "value": "none", "label": "None" }, { "value": "shield", "label": "Shield" }, { "value": "refresh", "label": "Money back" },
            { "value": "cash", "label": "Cash" }, { "value": "truck", "label": "Delivery" }, { "value": "certified", "label": "Certified" },
            { "value": "leaf", "label": "Natural" }, { "value": "sun", "label": "Climate" }, { "value": "droplet", "label": "Droplet" },
            { "value": "lock", "label": "Secure" }, { "value": "box", "label": "Package" }, { "value": "chat", "label": "Chat" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this guarantee in one or two plain sentences.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith · Feature columns",
      "blocks": [
        { "type": "column", "settings": { "text": "<p>Our friendly team will text or call to confirm your order details, ensuring you're ready to go.</p>" } },
        { "type": "column", "settings": { "text": "<p>Every box includes a unique serial QR code. Scan it to verify your product is 100% authentic.</p>" } },
        { "type": "column", "settings": { "text": "<p>Discreet packaging, delivered straight to your door anywhere in the Philippines.</p>" } },
        { "type": "column", "settings": { "text": "<p>Pay only when the product is in your hands with Cash on Delivery.</p>" } }
      ]
    }
  ]
}
{% endschema %}
