{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-feature-columns.css' | asset_url | stylesheet_tag }}
{%- liquid
  # Global: columns, logos and footer from Theme settings → Zenith · Guarantee (zg_*; empty slots skipped). Custom: this section's blocks.
  assign use_global = false
  if section.settings.content_source == 'global'
    assign use_global = true
  endif
  if use_global
    assign col_max = 4
    assign logo_max = 8
    assign footer_image = settings.zg_footer_image
    assign show_payments = settings.zg_payment_icons
    assign footer_text = settings.zg_footer_text
  else
    assign col_max = section.blocks.size
    assign logo_max = section.blocks.size
    assign footer_image = section.settings.footer_image
    assign show_payments = section.settings.show_payment_icons
    assign footer_text = section.settings.footer_text
  endif
-%}
{%- if show_payments -%}{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}{%- endif -%}
{%- capture extra -%}
  --z-cols: {{ section.settings.columns_desktop }};
  --z-cols-m: {{ section.settings.columns_mobile }};
  --z-img: {{ section.settings.image_size }}px;
  --z-img-m: {{ section.settings.image_size_mobile }}px;
  --z-igap: {{ section.settings.icon_gap }}px;
  --z-igap-m: {{ section.settings.icon_gap_mobile }}px;
  --z-tlh: {{ section.settings.text_line_height }}%;
  --z-tlh-m: {{ section.settings.text_line_height_mobile }}%;
  --z-text-a: {{ section.settings.text_opacity | divided_by: 100.0 }};
  --z-ffs: {{ section.settings.footer_text_size }}px;
  --z-ffs-m: {{ section.settings.footer_text_size_mobile }}px;
  --z-fiw: {{ section.settings.footer_image_width }}px;
  --z-fiw-m: {{ section.settings.footer_image_width_mobile }}px;
  --z-fmw-m: {{ section.settings.footer_max_width_mobile }}px;
  --z-fsp: {{ section.settings.footer_spacing }}px;
  --z-fsp-m: {{ section.settings.footer_spacing_mobile }}px;
  --z-flh: {{ section.settings.logo_height }}px;
  --z-flh-m: {{ section.settings.logo_height_mobile }}px;
  --z-flmw: {{ section.settings.logo_max_width }}px;
  --z-flgap: {{ section.settings.logo_gap }}px;
  --z-flgap-m: {{ section.settings.logo_gap_mobile }}px;
  --z-flo: {{ section.settings.logo_opacity | divided_by: 100.0 }};
  {%- if section.settings.icon_color != blank %}
  --z-icon-color: {{ section.settings.icon_color }};
  {%- endif %}
  --z-istroke: {{ section.settings.icon_stroke_width | default: '1.5' }};
  --z-tsp: {{ section.settings.title_spacing }}px;
  --z-tsp-m: {{ section.settings.title_spacing_mobile }}px;
  --z-ftlh: {{ section.settings.title_line_height | default: 110 | divided_by: 100.0 }};
  --z-ftlh-m: {{ section.settings.title_line_height_mobile | default: 110 | divided_by: 100.0 }};
  {%- if section.settings.title_color != blank %}
  --z-ft-color: {{ section.settings.title_color }};
  {%- endif %}
  --z-cpy: {{ section.settings.card_padding_y }}px;
  --z-cpx: {{ section.settings.card_padding_x }}px;
  --z-cpy-m: {{ section.settings.card_padding_y_mobile }}px;
  --z-cpx-m: {{ section.settings.card_padding_x_mobile }}px;
  {%- if section.settings.text_max_width > 0 %}
  --z-tmw: {{ section.settings.text_max_width }}px;
  {%- endif %}
  {%- if section.settings.card_background != blank %}
  --z-card-bg: {{ section.settings.card_background }};
  {%- endif %}
  {%- if section.settings.card_border_color != blank %}
  --z-card-bd: {{ section.settings.card_border_color }};
  {%- endif %}
  --z-badge: {{ section.settings.badge_size }}px;
  --z-badge-m: {{ section.settings.badge_size_mobile }}px;
  --z-bfs: {{ section.settings.badge_font_size }}px;
  --z-bfs-m: {{ section.settings.badge_font_size_mobile }}px;
  {%- if section.settings.badge_background != blank %}
  --z-badge-bg: {{ section.settings.badge_background }};
  {%- endif %}
  {%- if section.settings.badge_color != blank %}
  --z-badge-color: {{ section.settings.badge_color }};
  {%- endif %}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}
{%- liquid
  # zenith: icon cards (About "What We Believe") — icon position, mobile alignment, card border
  assign features_mods = 'zenith-features--icon-' | append: section.settings.icon_position | append: ' zenith-features--micon-' | append: section.settings.icon_position_mobile
  if section.settings.text_alignment_mobile != 'desktop'
    assign features_mods = features_mods | append: ' zenith-features--m-' | append: section.settings.text_alignment_mobile
  endif
  if section.settings.card_border_color != blank
    assign features_mods = features_mods | append: ' zenith-features--bordered'
  endif
  # zenith: column title colour (Verify "Where We Are Located"); empty = text colour of the scheme
  if section.settings.title_color != blank
    assign features_mods = features_mods | append: ' zenith-features--title-color'
  endif
-%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-features color-{{ section.settings.color_scheme }} gradient zenith-features--media-{{ section.settings.media_position }} zenith-features--{{ section.settings.image_ratio }} zenith-features--{{ section.settings.text_alignment }} zenith-features--v-{{ section.settings.vertical_alignment }} zenith-features--mv-{{ section.settings.vertical_alignment_mobile }} {{ features_mods }}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      uppercase: section.settings.heading_uppercase
    -%}

    {%- liquid
      if section.settings.media_position == 'left'
        assign img_sizes = '(min-width: 750px) ' | append: section.settings.image_size | append: 'px, ' | append: section.settings.image_size_mobile | append: 'px'
      else
        assign img_sizes = '(min-width: 990px) 30vw, (min-width: 750px) 50vw, 100vw'
      endif
    -%}

    <ul class="zenith-features__grid" role="list">
      {%- for n in (1..col_max) -%}
        {%- liquid
          if use_global
            assign p = 'zg_col' | append: n | append: '_'
            assign k = p | append: 'image'
            assign col_image = settings[k]
            assign k = p | append: 'title'
            assign col_title = settings[k]
            assign k = p | append: 'text'
            assign col_text = settings[k]
            if col_image == blank and col_title == blank and col_text == blank
              continue
            endif
            assign k = p | append: 'icon'
            assign col_icon = settings[k]
            assign k = p | append: 'badge'
            assign col_badge = settings[k]
            assign col_attrs = ''
          else
            assign block = section.blocks[forloop.index0]
            if block.type != 'column'
              continue
            endif
            assign col_image = block.settings.image
            assign col_title = block.settings.title
            assign col_text = block.settings.text
            assign col_icon = block.settings.icon
            assign col_badge = block.settings.icon_text
            assign col_attrs = 'id="Block-' | append: block.id | append: '" ' | append: block.shopify_attributes
          endif
        -%}
        <li class="zenith-features__item" {{ col_attrs }}>
          {%- if section.settings.show_media -%}
            <div class="zenith-media zenith-features__media">
              {%- if col_image != blank -%}
                {{
                  col_image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', widths: '150, 300, 450, 600, 900', sizes: img_sizes
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="zenith-features__text">
            {%- if col_badge != blank -%}
              <span class="zenith-features__icon zenith-features__icon--badge">
                <span class="zenith-features__badge">{{ col_badge | escape }}</span>
              </span>
            {%- elsif col_icon != blank and col_icon != 'none' -%}
              <span class="zenith-features__icon">{%- render 'zenith-icon', icon: col_icon -%}</span>
            {%- endif -%}
            {%- if col_title != blank -%}
              <h3 class="zenith-features__title">{{ col_title | escape | replace: '[customers]', settings.customer_count }}</h3>
            {%- endif -%}
            {%- if col_text != blank -%}
              <div class="zenith-features__body zenith-rte">{{ col_text | replace: '[customers]', settings.customer_count }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- liquid
      assign has_logos = false
      if use_global
        for n in (1..logo_max)
          assign p = 'zg_logo' | append: n | append: '_'
          assign k_image = p | append: 'image'
          assign k_name = p | append: 'name'
          if settings[k_image] != blank or settings[k_name] != blank
            assign has_logos = true
            break
          endif
        endfor
      else
        for block in section.blocks
          if block.type == 'logo'
            assign has_logos = true
            break
          endif
        endfor
      endif
    -%}
    {%- if has_logos or show_payments or footer_image != blank or footer_text != blank -%}
      <div class="zenith-features__footer">
        {%- if footer_image != blank -%}
          {%- assign footer_sizes = '(min-width: 750px) ' | append: section.settings.footer_image_width | append: 'px, ' | append: section.settings.footer_image_width_mobile | append: 'px' -%}
          {{
            footer_image
            | image_url: width: 1400
            | image_tag: loading: 'lazy', widths: '350, 700, 1050, 1400', sizes: footer_sizes, class: 'zenith-features__footer-image'
          }}
        {%- endif -%}
        {%- if has_logos -%}
          {%- assign logo_sizes = section.settings.logo_max_width | append: 'px' -%}
          <ul class="zenith-features__logos zenith-features__logos--{{ section.settings.logo_style }}" role="list">
            {%- for n in (1..logo_max) -%}
              {%- liquid
                if use_global
                  assign p = 'zg_logo' | append: n | append: '_'
                  assign k = p | append: 'image'
                  assign logo_image = settings[k]
                  assign k = p | append: 'name'
                  assign logo_name = settings[k]
                  if logo_image == blank and logo_name == blank
                    continue
                  endif
                  assign k = p | append: 'link'
                  assign logo_link = settings[k]
                  assign k = p | append: 'scale'
                  assign logo_scale = settings[k]
                  assign logo_attrs = ''
                else
                  assign block = section.blocks[forloop.index0]
                  if block.type != 'logo'
                    continue
                  endif
                  assign logo_image = block.settings.logo
                  assign logo_name = block.settings.name
                  assign logo_link = block.settings.link
                  assign logo_scale = block.settings.logo_scale
                  assign logo_attrs = 'id="Block-' | append: block.id | append: '" ' | append: block.shopify_attributes
                endif
              -%}
              <li
                class="zenith-features__logo"
                style="--z-logo-scale: {{ logo_scale | default: 100 | divided_by: 100.0 }};"
                {{ logo_attrs }}
              >
                {%- if logo_link != blank -%}
                  <a href="{{ logo_link }}" class="zenith-features__logo-link" target="_blank" rel="noopener">
                {%- endif -%}
                {%- if logo_image != blank -%}
                  {%- assign logo_alt = logo_image.alt | default: logo_name -%}
                  {{
                    logo_image
                    | image_url: width: 400
                    | image_tag: loading: 'lazy', widths: '100, 200, 300, 400', sizes: logo_sizes, alt: logo_alt
                  }}
                {%- else -%}
                  <span class="zenith-features__logo-text">{{ logo_name | escape }}</span>
                {%- endif -%}
                {%- if logo_link != blank -%}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if show_payments -%}
          <ul class="list-payment zenith-features__payments" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if footer_text != blank -%}
          <div class="zenith-features__footer-text zenith-rte">{{ footer_text | replace: '[customers]', settings.customer_count }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endcapture -%}
{{- zenith_body | replace: '[customers]', settings.customer_count -}}

{% schema %}
{
  "name": "Zenith · Feature columns",
  "tag": "div",
  "class": "section",
  "max_blocks": 20,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "Columns and logos",
      "info": "Zenith Guarantee = the columns, logos and footer text in Theme settings → Zenith · Guarantee (edit once, same on every page). This section's columns = the blocks and footer settings below.",
      "default": "custom",
      "options": [
        {
          "value": "custom",
          "label": "This section's columns"
        },
        {
          "value": "global",
          "label": "Zenith Guarantee (Theme settings)"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Zenith Guarantee"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "footer_image",
      "label": "Footer image",
      "info": "All logos in one image. To upload logos one by one (each with its own size), use Add block → Footer logo."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show store payment icons",
      "default": false
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text",
      "default": "<p>Delivered by LBC, J&T, Gogo Express, Ninja Van, and Amare Group's own rider fleet.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_media",
      "label": "Show column images",
      "info": "Turn off for icon cards without images",
      "default": true
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "default": "left",
      "options": [
        {
          "value": "top",
          "label": "Above text"
        },
        {
          "value": "left",
          "label": "Beside text"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image width (beside text)",
      "min": 80,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 152
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "info": "Icon or number badge above the title, or beside title and text",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Above text"
        },
        {
          "value": "left",
          "label": "Beside text"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Text position next to image",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between columns",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between image and text",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_gap",
      "label": "Space between icon and text",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Space below column title",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_padding_y",
      "label": "Card padding (top and bottom)",
      "info": "Use with a card background or border",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_padding_x",
      "label": "Card padding (sides)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Column text max width",
      "info": "0 = full column width",
      "min": 0,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "footer_spacing",
      "label": "Space above footer",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "footer_image_width",
      "label": "Footer image width",
      "min": 120,
      "max": 720,
      "step": 8,
      "unit": "px",
      "default": 336
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Footer logo height",
      "info": "Tallest logo. Scale individual logos in their block settings.",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Footer logo max width",
      "min": 40,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Space between footer logos",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#EABE5F"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Column title color",
      "info": "Leave empty to use the color scheme's text color"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "info": "Leave empty for no card"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "info": "Leave empty for no border"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Number badge background",
      "default": "#4E3A05"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Number badge text",
      "default": "#EABE5F"
    },
    {
      "type": "range",
      "id": "text_opacity",
      "label": "Text and footer text opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Footer logo color",
      "default": "original",
      "options": [
        {
          "value": "original",
          "label": "Original"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "grayscale",
          "label": "Grayscale"
        }
      ]
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Footer logo opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
