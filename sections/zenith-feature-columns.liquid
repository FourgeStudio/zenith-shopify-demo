{{ 'zenith-feature-columns.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_payment_icons -%}{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}{%- endif -%}
{%- capture extra -%}
  --z-cols: {{ section.settings.columns_desktop }};
  --z-cols-m: {{ section.settings.columns_mobile }};
  --z-img: {{ section.settings.image_size }}px;
  --z-img-m: {{ section.settings.image_size_mobile }}px;
  --z-igap: {{ section.settings.icon_gap }}px;
  --z-igap-m: {{ section.settings.icon_gap_mobile }}px;
  --z-tlh: {{ section.settings.text_line_height }}%;
  --z-tlh-m: {{ section.settings.text_line_height_mobile }}%;
  --z-text-a: {{ section.settings.text_opacity | divided_by: 100.0 }};
  --z-ffs: {{ section.settings.footer_text_size }}px;
  --z-ffs-m: {{ section.settings.footer_text_size_mobile }}px;
  --z-fiw: {{ section.settings.footer_image_width }}px;
  --z-fiw-m: {{ section.settings.footer_image_width_mobile }}px;
  --z-fmw-m: {{ section.settings.footer_max_width_mobile }}px;
  --z-fsp: {{ section.settings.footer_spacing }}px;
  --z-fsp-m: {{ section.settings.footer_spacing_mobile }}px;
  {%- if section.settings.icon_color != blank %}
  --z-icon-color: {{ section.settings.icon_color }};
  {%- endif %}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-features color-{{ section.settings.color_scheme }} gradient zenith-features--media-{{ section.settings.media_position }} zenith-features--{{ section.settings.image_ratio }} zenith-features--{{ section.settings.text_alignment }} zenith-features--v-{{ section.settings.vertical_alignment }} zenith-features--mv-{{ section.settings.vertical_alignment_mobile }}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      uppercase: section.settings.heading_uppercase
    -%}

    {%- liquid
      if section.settings.media_position == 'left'
        assign img_sizes = '(min-width: 750px) ' | append: section.settings.image_size | append: 'px, ' | append: section.settings.image_size_mobile | append: 'px'
      else
        assign img_sizes = '(min-width: 990px) 30vw, (min-width: 750px) 50vw, 100vw'
      endif
    -%}

    <ul class="zenith-features__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="zenith-features__item" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="zenith-media zenith-features__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '150, 300, 450, 600, 900', sizes: img_sizes
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="zenith-features__text">
            {%- if block.settings.icon != 'none' -%}
              <span class="zenith-features__icon">{%- render 'zenith-icon', icon: block.settings.icon -%}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="zenith-features__title">{{ block.settings.title | escape | replace: '[customers]', settings.customer_count }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="zenith-features__body zenith-rte">{{ block.settings.text | replace: '[customers]', settings.customer_count }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_payment_icons or section.settings.footer_image != blank or section.settings.footer_text != blank -%}
      <div class="zenith-features__footer">
        {%- if section.settings.footer_image != blank -%}
          {%- assign footer_sizes = '(min-width: 750px) ' | append: section.settings.footer_image_width | append: 'px, ' | append: section.settings.footer_image_width_mobile | append: 'px' -%}
          {{
            section.settings.footer_image
            | image_url: width: 1400
            | image_tag: loading: 'lazy', widths: '350, 700, 1050, 1400', sizes: footer_sizes, class: 'zenith-features__footer-image'
          }}
        {%- endif -%}
        {%- if section.settings.show_payment_icons -%}
          <ul class="list-payment zenith-features__payments" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.footer_text != blank -%}
          <div class="zenith-features__footer-text zenith-rte">{{ section.settings.footer_text | replace: '[customers]', settings.customer_count }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
