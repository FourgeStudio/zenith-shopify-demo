{{ 'zenith-feature-columns.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_payment_icons -%}{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}{%- endif -%}
{%- capture extra -%}
  --z-cols: {{ section.settings.columns_desktop }};
  --z-cols-m: {{ section.settings.columns_mobile }};
  --z-img: {{ section.settings.image_size }}px;
  --z-img-m: {{ section.settings.image_size_mobile }}px;
  --z-igap: {{ section.settings.icon_gap }}px;
  --z-igap-m: {{ section.settings.icon_gap_mobile }}px;
  --z-tlh: {{ section.settings.text_line_height }}%;
  --z-tlh-m: {{ section.settings.text_line_height_mobile }}%;
  --z-text-a: {{ section.settings.text_opacity | divided_by: 100.0 }};
  --z-ffs: {{ section.settings.footer_text_size }}px;
  --z-ffs-m: {{ section.settings.footer_text_size_mobile }}px;
  --z-fiw: {{ section.settings.footer_image_width }}px;
  --z-fiw-m: {{ section.settings.footer_image_width_mobile }}px;
  --z-fmw-m: {{ section.settings.footer_max_width_mobile }}px;
  --z-fsp: {{ section.settings.footer_spacing }}px;
  --z-fsp-m: {{ section.settings.footer_spacing_mobile }}px;
  {%- if section.settings.icon_color != blank %}
  --z-icon-color: {{ section.settings.icon_color }};
  {%- endif %}
  --z-istroke: {{ section.settings.icon_stroke_width | default: '1.5' }};
  --z-tsp: {{ section.settings.title_spacing }}px;
  --z-tsp-m: {{ section.settings.title_spacing_mobile }}px;
  --z-cpy: {{ section.settings.card_padding_y }}px;
  --z-cpx: {{ section.settings.card_padding_x }}px;
  --z-cpy-m: {{ section.settings.card_padding_y_mobile }}px;
  --z-cpx-m: {{ section.settings.card_padding_x_mobile }}px;
  {%- if section.settings.text_max_width > 0 %}
  --z-tmw: {{ section.settings.text_max_width }}px;
  {%- endif %}
  {%- if section.settings.card_background != blank %}
  --z-card-bg: {{ section.settings.card_background }};
  {%- endif %}
  {%- if section.settings.card_border_color != blank %}
  --z-card-bd: {{ section.settings.card_border_color }};
  {%- endif %}
  --z-badge: {{ section.settings.badge_size }}px;
  --z-badge-m: {{ section.settings.badge_size_mobile }}px;
  --z-bfs: {{ section.settings.badge_font_size }}px;
  --z-bfs-m: {{ section.settings.badge_font_size_mobile }}px;
  {%- if section.settings.badge_background != blank %}
  --z-badge-bg: {{ section.settings.badge_background }};
  {%- endif %}
  {%- if section.settings.badge_color != blank %}
  --z-badge-color: {{ section.settings.badge_color }};
  {%- endif %}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}
{%- liquid
  # zenith: icon cards (About "What We Believe") — icon position, mobile alignment, card border
  assign features_mods = 'zenith-features--icon-' | append: section.settings.icon_position | append: ' zenith-features--micon-' | append: section.settings.icon_position_mobile
  if section.settings.text_alignment_mobile != 'desktop'
    assign features_mods = features_mods | append: ' zenith-features--m-' | append: section.settings.text_alignment_mobile
  endif
  if section.settings.card_border_color != blank
    assign features_mods = features_mods | append: ' zenith-features--bordered'
  endif
-%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-features color-{{ section.settings.color_scheme }} gradient zenith-features--media-{{ section.settings.media_position }} zenith-features--{{ section.settings.image_ratio }} zenith-features--{{ section.settings.text_alignment }} zenith-features--v-{{ section.settings.vertical_alignment }} zenith-features--mv-{{ section.settings.vertical_alignment_mobile }} {{ features_mods }}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      uppercase: section.settings.heading_uppercase
    -%}

    {%- liquid
      if section.settings.media_position == 'left'
        assign img_sizes = '(min-width: 750px) ' | append: section.settings.image_size | append: 'px, ' | append: section.settings.image_size_mobile | append: 'px'
      else
        assign img_sizes = '(min-width: 990px) 30vw, (min-width: 750px) 50vw, 100vw'
      endif
    -%}

    <ul class="zenith-features__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="zenith-features__item" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
          {%- if section.settings.show_media -%}
            <div class="zenith-media zenith-features__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', widths: '150, 300, 450, 600, 900', sizes: img_sizes
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="zenith-features__text">
            {%- if block.settings.icon_text != blank -%}
              <span class="zenith-features__icon zenith-features__icon--badge">
                <span class="zenith-features__badge">{{ block.settings.icon_text | escape }}</span>
              </span>
            {%- elsif block.settings.icon != 'none' -%}
              <span class="zenith-features__icon">{%- render 'zenith-icon', icon: block.settings.icon -%}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="zenith-features__title">{{ block.settings.title | escape | replace: '[customers]', settings.customer_count }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="zenith-features__body zenith-rte">{{ block.settings.text | replace: '[customers]', settings.customer_count }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_payment_icons or section.settings.footer_image != blank or section.settings.footer_text != blank -%}
      <div class="zenith-features__footer">
        {%- if section.settings.footer_image != blank -%}
          {%- assign footer_sizes = '(min-width: 750px) ' | append: section.settings.footer_image_width | append: 'px, ' | append: section.settings.footer_image_width_mobile | append: 'px' -%}
          {{
            section.settings.footer_image
            | image_url: width: 1400
            | image_tag: loading: 'lazy', widths: '350, 700, 1050, 1400', sizes: footer_sizes, class: 'zenith-features__footer-image'
          }}
        {%- endif -%}
        {%- if section.settings.show_payment_icons -%}
          <ul class="list-payment zenith-features__payments" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.footer_text != blank -%}
          <div class="zenith-features__footer-text zenith-rte">{{ section.settings.footer_text | replace: '[customers]', settings.customer_count }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Feature columns",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Zenith Guarantee"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "footer_image",
      "label": "Footer image",
      "info": "e.g. courier or payment logos in one image (GOGO, SPX, LBC, J&T, Ninja Van)"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show store payment icons",
      "default": false
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text",
      "default": "<p>Delivered by LBC, J&T, Gogo Express, Ninja Van, and Amare Group's own rider fleet.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_media",
      "label": "Show column images",
      "info": "Turn off for icon cards without images",
      "default": true
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "default": "left",
      "options": [
        {
          "value": "top",
          "label": "Above text"
        },
        {
          "value": "left",
          "label": "Beside text"
        }
