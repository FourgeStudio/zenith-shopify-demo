{%- comment -%}
  zenith: product page header (buy box). Replaces Dawn's main-product on alternate product templates.
  [customers] anywhere in this section shows Theme settings → Zenith → Customer count.
{%- endcomment -%}
{%- capture zenith_body -%}
{%- liquid
  assign s = section.settings
  assign mp_product = product
  assign form_id = 'ZenithMp-' | append: section.id

  assign gallery_media = mp_product.media | where: 'media_type', 'image'

  # Rating: Judge.me metafields when present, else the section's own numbers.
  assign rating_value = s.rating_value
  assign rating_count = s.rating_count
  if mp_product.metafields.reviews.rating.value != blank
    assign rating_value = mp_product.metafields.reviews.rating.value.rating
    assign rating_count = mp_product.metafields.reviews.rating_count.value
  endif
  assign rating_label = s.rating_label | replace: '[rating]', rating_value | replace: '[count]', rating_count

  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign row_blocks = section.blocks | where: 'type', 'row'
  assign review_blocks = section.blocks | where: 'type', 'review'

  # Review strip source: global slots rv1…rv20 (Theme settings → Zenith · Results reviews) or this section's blocks.
  assign review_total = 0
  if s.reviews_source == 'global'
    for n in (1..20)
      assign p = 'rv' | append: n | append: '_'
      assign k_image = p | append: 'image'
      assign k_quote = p | append: 'quote'
      assign k_author = p | append: 'author'
      if settings[k_image] != blank or settings[k_quote] != blank or settings[k_author] != blank
        assign review_total = review_total | plus: 1
      endif
    endfor
  elsif s.reviews_source == 'blocks'
    assign review_total = review_blocks.size
  endif

  assign has_variants = false
  if mp_product != blank and mp_product.has_only_default_variant == false
    assign has_variants = true
  endif
  assign current_variant = mp_product.selected_or_first_available_variant
-%}
{{ 'zenith-main-product.css' | asset_url | stylesheet_tag }}
{{ 'zenith-faq.css' | asset_url | stylesheet_tag }}
{%- if s.payment_icons == 'shop' -%}
  {{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'zenith-faq.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'zenith-main-product.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- capture extra -%}
  --z-mp-top: {{ s.top_color }};
  --z-mp-fade: {{ s.fade_height }}px;
  --z-mp-media-bg: {{ s.media_background }};
  --z-mp-ratio: {{ s.gallery_ratio }};
  --z-mp-ratio-m: {{ s.gallery_ratio_mobile }};
  --z-mp-slw-m: {{ s.slide_width_mobile }};
  --z-mp-sgap-m: {{ s.slide_gap_mobile }}px;
  --z-mp-dot: {{ s.dot_size }}px;
  --z-mp-dot-m: {{ s.dot_size_mobile }}px;
  --z-mp-dotw: {{ s.dot_width }}px;
  --z-mp-dotw-m: {{ s.dot_width_mobile }}px;
  --z-mp-dotg: {{ s.dot_gap }}px;
  --z-mp-dotg-m: {{ s.dot_gap_mobile }}px;
  --z-mp-dotb: {{ s.dot_offset }}px;
  --z-mp-dotb-m: {{ s.dot_offset_mobile }}px;
  --z-mp-dot-c: {{ s.dot_color }};
  --z-mp-dot-ac: {{ s.dot_active_color }};
  --z-mp-thumbs: {{ s.thumb_count }};
  --z-mp-thumb-gap: {{ s.thumb_gap }}px;
  --z-mp-thumb-gap-m: {{ s.thumb_gap_mobile }}px;
  --z-mp-thumb-w-m: {{ s.thumb_width_mobile }}px;
  --z-mp-thumb-sp: {{ s.thumb_spacing }}px;
  --z-mp-thumb-sp-m: {{ s.thumb_spacing_mobile }}px;
  --z-mp-thumb-bd: {{ s.thumb_active_color }};
  --z-mp-rev-w: {{ s.review_card_width }}px;
  --z-mp-rev-w-m: {{ s.review_card_width_mobile }}px;
  --z-mp-rev-gap: {{ s.review_gap }}px;
  --z-mp-rev-sp: {{ s.review_spacing }}px;
  --z-mp-rev-sp-m: {{ s.review_spacing_mobile }}px;
  --z-mp-rev-photo: {{ s.review_photo_size }}px;
  --z-mp-rev-bg: {{ s.card_background }};
  --z-mp-rev-name: {{ s.review_name_color }};
  --z-mp-rev-nfs: {{ s.review_name_font_size }}px;
  --z-mp-rev-fs: {{ s.review_text_font_size }}px;
  --z-mp-rev-star: {{ s.review_star_size }}px;
  --z-mp-star: {{ s.star_size }}px;
  --z-mp-star-m: {{ s.star_size_mobile }}px;
  --z-mp-star-c: {{ s.star_color }};
  --z-mp-rfs: {{ s.rating_font_size }}px;
  --z-mp-rfs-m: {{ s.rating_font_size_mobile }}px;
  --z-mp-price-c: {{ s.price_color }};
  --z-mp-cmp-c: {{ s.compare_color }};
  --z-mp-cmp-fs: {{ s.compare_font_size }}px;
  --z-mp-cmp-fs-m: {{ s.compare_font_size_mobile }}px;
  --z-mp-chip-bg: {{ s.badge_background }};
  --z-mp-chip-fg: {{ s.badge_text_color }};
  --z-mp-chip-fs: {{ s.badge_font_size }}px;
  --z-mp-chip-fs-m: {{ s.badge_font_size_mobile }}px;
  --z-mp-chip-pad-m: {{ s.badge_padding_mobile }}px;
  --z-mp-chip-h: {{ s.badge_height }}px;
  --z-mp-chip-pad: {{ s.badge_padding }}px;
  --z-mp-chip-sp: {{ s.badge_spacing }}px;
  --z-mp-check: {{ s.check_size }}px;
  --z-mp-check-m: {{ s.check_size_mobile }}px;
  --z-mp-check-c: {{ s.check_color }};
  --z-mp-check-gap: {{ s.check_gap }}px;
  --z-mp-check-gap-m: {{ s.check_gap_mobile }}px;
  --z-mp-bar-bg: {{ s.bar_background }};
  --z-mp-fda-h: {{ s.fda_height }}px;
  --z-mp-fda-img: {{ s.fda_logo_height }}px;
  --z-mp-fda-fs: {{ s.fda_font_size }}px;
  --z-mp-fda-fs-m: {{ s.fda_font_size_mobile }}px;
  --z-mp-qty-w: {{ s.qty_width }}px;
  --z-mp-btn-h: {{ s.button_height }}px;
  --z-mp-form-gap: {{ s.form_gap }}px;
  --z-mp-pay-h: {{ s.payment_icon_height }}px;
  --z-mp-pay-gap: {{ s.payment_gap }}px;
  --z-mp-del-bg: {{ s.delivery_background }};
  --z-mp-del-pad: {{ s.delivery_padding }}px;
  --z-mp-del-icon: {{ s.delivery_icon_size }}px;
  --z-mp-del-tfs: {{ s.delivery_title_font_size }}px;
  --z-mp-del-tfs-m: {{ s.delivery_title_font_size_mobile }}px;
  --z-mp-del-sfs: {{ s.delivery_text_font_size }}px;
  --z-mp-del-sfs-m: {{ s.delivery_text_font_size_mobile }}px;
  --z-mp-trust-c: {{ s.trust_icon_color }};
  --z-mp-trust-fs: {{ s.trust_font_size }}px;
  --z-mp-trust-fs-m: {{ s.trust_font_size_mobile }}px;
  --z-mp-trust-icon: {{ s.trust_icon_size }}px;
  --z-mp-trust-gap: {{ s.trust_gap }}px;
  --z-mp-trust-rgap: {{ s.trust_row_gap }}px;
  --z-mp-row-tfs: {{ s.row_text_font_size }}px;
  --z-mp-row-tfs-m: {{ s.row_text_font_size_mobile }}px;
  --z-mp-row-icon: {{ s.row_icon_color }};
  --z-mp-row-div: {{ s.divider_opacity | divided_by: 100.0 }};
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section id="Zenith-{{ section.id }}" class="zenith-section zenith-mp color-{{ s.color_scheme }} gradient">
  {%- if mp_product != blank -%}
    <script type="application/ld+json">
      {{ mp_product | structured_data }}
    </script>
  {%- endif -%}

  <div class="page-width">
    <zenith-main-product class="zenith-mp__grid">
      {%- comment -%} ---------------- Gallery ---------------- {%- endcomment -%}
      <div class="zenith-mp__gallery">
        <zenith-carousel class="zenith-mp__carousel" data-slide-label="Image">
          <ul class="zenith-carousel__track zenith-mp__track" role="list">
            {%- if gallery_media.size > 0 -%}
              {%- for media in gallery_media -%}
                {%- assign media_alt = media.alt | default: mp_product.title -%}
                <li class="zenith-carousel__slide zenith-mp__slide">
                  <div class="zenith-media zenith-mp__media">
                    {%- if forloop.first -%}
                      {{
                        media.preview_image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'eager',
                          fetchpriority: 'high',
                          widths: '300, 400, 500, 600, 800, 1000, 1200',
                          sizes: '(min-width: 750px) 500px, 70vw',
                          alt: media_alt
                      }}
                    {%- else -%}
                      {{
                        media.preview_image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 400, 500, 600, 800, 1000, 1200',
                          sizes: '(min-width: 750px) 500px, 70vw',
                          alt: media_alt
                      }}
                    {%- endif -%}
                  </div>
                </li>
              {%- endfor -%}
            {%- else -%}
              <li class="zenith-carousel__slide zenith-mp__slide">
                <div class="zenith-media zenith-mp__media">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </li>
            {%- endif -%}
          </ul>
          {%- if s.show_dots -%}
            {%- render 'zenith-carousel-controls', show_dots: true, show_arrows: false, label: 'image' -%}
          {%- endif -%}
        </zenith-carousel>

        {%- if s.show_thumbnails and gallery_media.size > 1 -%}
          <ul class="zenith-mp__thumbs zenith-mp__bleed" role="list">
            {%- for media in gallery_media -%}
              <li class="zenith-mp__thumb-item">
                <button
                  type="button"
                  class="zenith-mp__thumb{% if forloop.first %} is-active{% endif %}"
                  data-thumb="{{ forloop.index0 }}"
                  aria-label="{{ 'products.product.media.gallery_viewer' | t }} {{ forloop.index }}"
                  {% if forloop.first %}
                    aria-current="true"
                  {% endif %}
                >
                  {{
                    media.preview_image
                    | image_url: width: 300
                    | image_tag:
                      loading: 'lazy',
                      widths: '80, 120, 160, 240, 300',
                      sizes: '80px',
                      alt: ''
                  }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if review_total > 0 -%}
          <ul class="zenith-mp__reviews zenith-mp__bleed" role="list">
            {%- for n in (1..20) -%}
              {%- liquid
                if s.reviews_source == 'global'
                  assign p = 'rv' | append: n | append: '_'
                  assign k = p | append: 'image'
                  assign rv_image = settings[k]
                  assign k = p | append: 'author'
                  assign rv_name = settings[k]
                  assign k = p | append: 'quote'
                  assign rv_text = settings[k]
                  assign k = p | append: 'rating'
                  assign rv_stars = settings[k]
                  assign rv_attrs = ''
                  if rv_image == blank and rv_name == blank and rv_text == blank
                    continue
                  endif
                else
                  assign rv_block = review_blocks[forloop.index0]
                  if rv_block == blank
                    break
                  endif
                  assign rv_image = rv_block.settings.image
                  assign rv_name = rv_block.settings.name
                  assign rv_text = rv_block.settings.text
                  assign rv_stars = rv_block.settings.stars
                  assign rv_attrs = 'id="Block-' | append: rv_block.id | append: '" ' | append: rv_block.shopify_attributes
                endif
              -%}
              <li class="zenith-mp__review" {{ rv_attrs }}>
                <div class="zenith-media zenith-mp__review-photo">
                  {%- if rv_image != blank -%}
                    {{
                      rv_image
                      | image_url: width: 200
                      | image_tag: loading: 'lazy', widths: '60, 100, 150, 200', sizes: '50px', alt: ''
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="zenith-mp__review-body">
                  <p class="zenith-mp__review-head">
                    {%- if rv_name != blank -%}
                      <span class="zenith-mp__review-name">{{ rv_name | escape }}</span>
                    {%- endif -%}
                    {%- if rv_stars != blank and rv_stars > 0 -%}
                      {%- render 'zenith-stars', rating: rv_stars -%}
                    {%- endif -%}
                  </p>
                  {%- if rv_text != blank -%}
                    <p class="zenith-mp__review-text">{{ rv_text | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} ---------------- Buy box ---------------- {%- endcomment -%}
      <div class="zenith-mp__buy">
        {%- if s.show_rating and rating_value != blank -%}
          <div class="zenith-mp__rating">
            {%- render 'zenith-stars', rating: rating_value -%}
            {%- if rating_label != blank -%}
              <span class="zenith-mp__rating-label">{{ rating_label | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <h1 class="zenith-mp__title">
          {%- if mp_product != blank -%}
            {{- mp_product.title | escape -}}
          {%- else -%}
            {{- s.placeholder_title | escape -}}
          {%- endif -%}
        </h1>

        {%- if s.subtitle != blank -%}
          <div class="zenith-mp__subtitle zenith-rte{% unless s.subtitle_desktop %} zenith-hide-desktop{% endunless %}{% unless s.subtitle_mobile %} zenith-hide-mobile{% endunless %}">
            {{- s.subtitle -}}
          </div>
        {%- endif -%}

        <div class="zenith-mp__price" data-price-wrap>
          <span class="zenith-mp__price-current" data-price>
            {%- if mp_product != blank -%}
              {{- mp_product.price | money -}}
            {%- else -%}
              {{- 179800 | money -}}
            {%- endif -%}
          </span>
          <s class="zenith-mp__price-compare{% unless mp_product.compare_at_price > mp_product.price %} zenith-mp__price-compare--hidden{% endunless %}" data-compare>
            {%- if mp_product.compare_at_price > mp_product.price -%}
              {{- mp_product.compare_at_price | money -}}
            {%- endif -%}
          </s>
          {%- if s.price_badge != blank -%}
            <span class="zenith-mp__chip">{{ s.price_badge | escape }}</span>
          {%- endif -%}
        </div>

        {%- if has_variants -%}
          <fieldset class="zenith-mp__variants" data-variants>
            <legend class="visually-hidden">{{ 'products.product.product_variants' | t }}</legend>
            {%- for variant in mp_product.variants -%}
              <input
                type="radio"
                class="zenith-mp__variant-input visually-hidden"
                id="Variant-{{ section.id }}-{{ variant.id }}"
                name="Variant-{{ section.id }}"
                value="{{ variant.id }}"
                data-price="{{ variant.price | money }}"
                data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                data-available="{{ variant.available }}"
                {% if variant.id == current_variant.id %}
                  checked
                {% endif %}
              >
              <label class="zenith-mp__variant" for="Variant-{{ section.id }}-{{ variant.id }}">
                {{- variant.title -}}
              </label>
            {%- endfor -%}
          </fieldset>
        {%- endif -%}

        {%- if benefit_blocks.size > 0 -%}
          <ul class="zenith-mp__checks" role="list">
            {%- for block in benefit_blocks -%}
              <li
                class="zenith-mp__check{% if block.settings.hide_on_desktop %} zenith-hide-desktop{% endif %}{% if block.settings.hide_on_mobile %} zenith-hide-mobile{% endif %}"
                id="Block-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {%- render 'zenith-icon', icon: 'check_filled', class: 'zenith-mp__check-icon' -%}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.show_fda -%}
          <div class="zenith-mp__fda">
            {%- if s.fda_image != blank -%}
              {%- assign fda_w = s.fda_logo_height | times: s.fda_image.aspect_ratio | ceil | times: 3 -%}
              {{
                s.fda_image
                | image_url: width: fda_w
                | image_tag:
                  loading: 'lazy',
                  widths: '80, 160, 240',
                  sizes: '80px',
                  class: 'zenith-mp__fda-logo',
                  alt: s.fda_label
              }}
            {%- endif -%}
            {%- if s.fda_label != blank -%}
              <span class="zenith-mp__fda-label">{{ s.fda_label | escape }}</span>
            {%- endif -%}
            {%- if s.fda_number != blank -%}
              <span class="zenith-mp__fda-number">{{ s.fda_number | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="zenith-mp__form">
          <div class="zenith-mp__qty">
            <button
              type="button"
              class="zenith-mp__qty-btn"
              data-qty-step="-1"
              aria-label="{{ 'products.product.quantity.decrease' | t: product: mp_product.title | escape }}"
            >
              {%- render 'zenith-icon', icon: 'minus' -%}
            </button>
            <input
              class="zenith-mp__qty-input"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              name="quantity"
              form="{{ form_id }}"
              id="Quantity-{{ section.id }}"
              value="{% if s.quantity_pad %}01{% else %}1{% endif %}"
              data-pad="{% if s.quantity_pad %}2{% else %}0{% endif %}"
              data-min="1"
              aria-label="{{ 'products.product.quantity.label' | t }}"
            >
            <button
              type="button"
              class="zenith-mp__qty-btn"
              data-qty-step="1"
              aria-label="{{ 'products.product.quantity.increase' | t: product: mp_product.title | escape }}"
            >
              {%- render 'zenith-icon', icon: 'plus' -%}
            </button>
          </div>

          {%- if mp_product != blank -%}
            {%- render 'zenith-add-to-cart',
              product: mp_product,
              form_id: form_id,
              label: s.button_label,
              style: s.button_style,
              icon: s.button_icon,
              class: 'zenith-mp__atc'
            -%}
          {%- else -%}
            <button type="button" class="button zenith-atc zenith-btn zenith-btn--{{ s.button_style }} zenith-mp__atc" disabled>
              <span>{{ s.button_label | escape }}</span>
              {%- if s.button_icon != 'none' -%}
                {%- render 'zenith-icon', icon: s.button_icon, class: 'zenith-btn__icon' -%}
              {%- endif -%}
            </button>
          {%- endif -%}
        </div>

        {%- if s.show_cod or s.payment_icons != 'none' -%}
          <div class="zenith-mp__payments">
            {%- if s.show_cod and s.cod_label != blank -%}
              <span class="zenith-mp__cod">
                {%- render 'zenith-icon', icon: s.cod_icon, class: 'zenith-mp__cod-icon' -%}
                {{ s.cod_label | escape }}
              </span>
            {%- endif -%}
            {%- if s.payment_icons == 'image' and s.payment_image != blank -%}
              {%- assign pay_w = s.payment_icon_height | times: s.payment_image.aspect_ratio | ceil | times: 3 -%}
              {{
                s.payment_image
                | image_url: width: pay_w
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 400, 600',
                  sizes: '200px',
                  class: 'zenith-mp__pay-image',
                  alt: 'sections.footer.payment' | t
              }}
            {%- elsif s.payment_icons == 'shop' and shop.enabled_payment_types.size > 0 -%}
              <ul class="zenith-mp__pay list-unstyled" role="list" aria-label="{{ 'sections.footer.payment' | t | escape }}">
                {%- for type in shop.enabled_payment_types -%}
                  <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.show_delivery and s.delivery_title != blank -%}
          <div class="zenith-mp__delivery">
            <p class="zenith-mp__delivery-title">
              {%- render 'zenith-icon', icon: s.delivery_icon, class: 'zenith-mp__delivery-icon' -%}
              <span>{{ s.delivery_title | escape }}</span>
            </p>
            {%- if s.delivery_text != blank -%}
              <p class="zenith-mp__delivery-text">{{ s.delivery_text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if trust_blocks.size > 0 -%}
          <ul class="zenith-mp__trust" role="list">
            {%- for block in trust_blocks -%}
              <li class="zenith-mp__trust-item" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- render 'zenith-icon', icon: block.settings.icon, class: 'zenith-mp__trust-icon' -%}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if row_blocks.size > 0 -%}
          <div class="zenith-mp__rows">
            {%- for block in row_blocks -%}
              {%- liquid
                assign row_body = block.settings.text
                if block.settings.content_source == 'description'
                  assign row_body = mp_product.description
                endif
                assign row_class = 'zenith-faq__item zenith-mp__row'
                if block.settings.hide_on_mobile
                  assign row_class = row_class | append: ' zenith-hide-mobile'
                endif
                if block.settings.hide_on_desktop
                  assign row_class = row_class | append: ' zenith-hide-desktop'
                endif
              -%}
              {%- if block.settings.title != blank -%}
                <details
                  class="{{ row_class }}"
                  id="Block-{{ block.id }}"
                  {% if block.settings.open %}
                    open
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  <summary class="zenith-faq__question zenith-mp__row-title">
                    <span>{{ block.settings.title | escape }}</span>
                    <span class="zenith-faq__icon zenith-mp__row-icon">
                      {%- render 'zenith-icon', icon: 'plus' -%}
                    </span>
                  </summary>
                  <div class="zenith-faq__answer zenith-rte">{{ row_body }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </zenith-main-product>
  </div>
</section>
{%- endcapture -%}
{{- zenith_body | replace: '[customers]', settings.customer_count -}}

{% schema %}
{
  "name": "Zenith · Product page",
  "tag": "div",
  "class": "section",
  "max_blocks": 40,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
