{%- comment -%}
  Zenith · Custom code — paste HTML / Liquid / an app's embed code (e.g. a Judge.me widget snippet) into any page.
  Each instance is its own section, so every template can hold different code.
  [customers] in the heading texts shows Theme settings → Zenith → Customer count.
{%- endcomment -%}
{%- capture zenith_body -%}
{%- liquid
  assign s = section.settings
  # No code → nothing on the storefront (not an empty padded band or a lone heading); the editor shows the placeholder
  assign code_out = s.code | strip
-%}
{%- if code_out != blank or request.design_mode -%}
{{ 'zenith-custom-code.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign root_class = 'zenith-section zenith-cc zenith-cc--' | append: s.width
  if s.hide_on_mobile
    assign root_class = root_class | append: ' zenith-hide-mobile'
  endif
  if s.hide_on_desktop
    assign root_class = root_class | append: ' zenith-hide-desktop'
  endif
-%}

{%- render 'zenith-section-style', section: section -%}

<section id="Zenith-{{ section.id }}" class="{{ root_class }} color-{{ s.color_scheme }} gradient">
  <div class="{% unless s.width == 'full' %}page-width{% endunless %}">
    {%- render 'zenith-section-heading',
      eyebrow: s.eyebrow,
      heading: s.heading,
      heading_mobile: s.heading_mobile,
      subheading: s.subheading,
      alignment: s.heading_alignment
    -%}

    {%- if code_out != blank -%}
      <div class="zenith-cc__code">{{ s.code }}</div>
    {%- elsif request.design_mode -%}
      <p class="zenith-cc__placeholder">Paste HTML, Liquid or an app's embed code in "Code". Only visible in the theme editor.</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{%- endcapture -%}
{{- zenith_body | replace: '[customers]', settings.customer_count -}}

{% schema %}
{
  "name": "Zenith · Custom code",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    {
      "type": "liquid",
      "id": "code",
      "label": "Code",
      "info": "HTML, Liquid, or an app's embed code (e.g. Judge.me widget code). Scripts run on the storefront — only paste code from sources you trust."
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "page",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "narrow", "label": "Narrow (max width below)" },
        { "value": "full", "label": "Full screen" }
      ]
    },
    { "type": "range", "id": "content_max_width", "visible_if": "{{ section.settings.width == 'narrow' }}", "label": "Max width (Narrow)", "min": 400, "max": 1400, "step": 20, "unit": "px", "default": 800 },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "range", "id": "heading_max_width", "label": "Heading max width", "min": 300, "max": 1200, "step": 20, "unit": "px", "default": 800 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "subheading_font_size", "label": "Subheading size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "header", "content": "Mobile" },
    { "type": "text", "id": "heading_mobile", "label": "Heading", "info": "Leave empty to use the desktop heading." },
    { "type": "range", "id": "heading_font_size_mobile", "label": "Heading size", "min": 16, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "subheading_font_size_mobile", "label": "Subheading size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_spacing_mobile", "label": "Space below heading", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "heading_spacing", "label": "Space below heading", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [
    { "name": "Zenith · Custom code" }
  ]
}
{% endschema %}
