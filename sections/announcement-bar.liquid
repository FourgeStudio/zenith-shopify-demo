{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- comment -%} zenith: design styling (gradient bg, Geist text, fixed height) — static rules in zenith-header.css {%- endcomment -%}
{{ 'zenith-header.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #Zenith-{{ section.id }} {
    {%- if section.settings.zenith_background_gradient != blank %}
    --zab-bg: {{ section.settings.zenith_background_gradient }};
    {%- endif %}
    --zab-h: {{ section.settings.zenith_height }}px;
    --zab-h-m: {{ section.settings.zenith_height_mobile }}px;
    --zab-fs: {{ section.settings.zenith_font_size }}px;
    --zab-fs-m: {{ section.settings.zenith_font_size_mobile }}px;
    --zab-weight: {{ section.settings.zenith_font_weight }};
    --zab-font: var(--font-{{ section.settings.zenith_font }}-family);
    --zab-transform: {% if section.settings.zenith_uppercase %}uppercase{% else %}none{% endif %};
    --zab-gap: {{ section.settings.zenith_gap | default: 24 }}px;
    --zab-gap-m: {{ section.settings.zenith_gap_mobile | default: 16 }}px;
  }
{%- endstyle -%}

<div
  id="Zenith-{{ section.id }}"
  class="utility-bar zenith-announcement color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- liquid
      # zenith: messages in one row with separators, or a scrolling marquee (slideshow = Dawn's own behaviour below)
      assign ann_mode = section.settings.zenith_display | default: 'row'
      assign ann_overflow = section.settings.zenith_overflow | default: 'rotate'
      assign ann_passes = 1
      if ann_mode == 'marquee' or ann_overflow == 'marquee'
        assign ann_passes = 2
      endif
      assign ann_bleed = true
      if language_country_selector or section.settings.show_social and social_icons
        assign ann_bleed = false
      endif
    -%}
    {%- if section.blocks.size > 0 and ann_mode != 'slideshow' -%}
      <script src="{{ 'zenith-announcements.js' | asset_url }}" defer="defer"></script>
      <zenith-announcements
        class="zenith-ann zenith-ann--{{ ann_mode }} zenith-ann--sep-{{ section.settings.zenith_separator }} zenith-ann--fit-{{ ann_overflow }}{% if ann_bleed %} zenith-ann--bleed{% endif %}"
        data-mode="{{ ann_mode }}"
        data-overflow="{{ ann_overflow }}"
        data-speed="{{ section.settings.change_slides_speed }}"
        data-marquee-speed="{{ section.settings.zenith_marquee_speed | default: 40 }}"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
      >
        <div class="zenith-ann__viewport">
          <div class="zenith-ann__track">
            {%- for pass in (1..ann_passes) -%}
              <ul
                class="zenith-ann__list{% if pass > 1 %} zenith-ann__list--copy{% endif %}"
                role="list"
                {% if pass > 1 %}
                  aria-hidden="true"
                {% endif %}
              >
                {%- for block in section.blocks -%}
                  {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign ann_text = block.settings.text | replace: '[customers]', settings.customer_count | escape -%}
                  <li
                    class="zenith-ann__item"
                    {% if pass == 1 %}
                      {{ block.shopify_attributes }}
                    {% endif %}
                  >
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link | escape }}"
                        class="zenith-ann__link"
                        {% if pass > 1 %}
                          tabindex="-1"
                        {% endif %}
                      >
                        {{- ann_text -}}
                      </a>
                    {%- else -%}
                      <span>{{ ann_text }}</span>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endfor -%}
          </div>
        </div>
      </zenith-announcements>
    {%- elsif section.blocks.size == 1 -%}
      <div
        class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        {{ section.blocks.first.shopify_attributes }}
      >
        {%- if section.blocks.first.settings.text != blank -%}
          {%- if section.blocks.first.settings.link != blank -%}
            <a
              href="{{ section.blocks.first.settings.link | escape }}"
              class="announcement-bar__link link link--text focus-inset animate-arrow"
            >
          {%- endif -%}
          <p class="announcement-bar__message h5">
            <span>{{ section.blocks.first.settings.text | replace: '[customers]', settings.customer_count | escape }}</span>
            {%- if section.blocks.first.settings.link != blank -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if section.blocks.first.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- elsif section.blocks.size > 1 -%}
      <slideshow-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
      >
        <div class="announcement-bar-slider slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div
            class="grid grid--1-col slider slider--everywhere"
            id="Slider-{{ section.id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="{{ section.settings.auto_rotate }}"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- for block in section.blocks -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
              >
                <div
                  class="announcement-bar__announcement"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                >
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link | escape }}"
                        class="announcement-bar__link link link--text focus-inset animate-arrow"
                      >
                    {%- endif -%}
                    <p class="announcement-bar__message h5">
                      <span>{{ block.settings.text | replace: '[customers]', settings.customer_count | escape }}</span>
                      {%- if block.settings.link != blank -%}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      {%- endif -%}
                    </p>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endcapture -%}
{{- zenith_body | replace: '[customers]', settings.customer_count -}}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },    
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "color_background",
      "id": "zenith_background_gradient",
      "label": "Background gradient",
      "info": "Overrides the color scheme background. Clear to use the scheme.",
      "default": "linear-gradient(90deg, rgba(234, 190, 95, 1) 0%, rgba(197, 147, 14, 1) 100%)"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": false,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "zenith_height",
      "label": "Bar height",
      "min": 24,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "zenith_display",
      "label": "Messages",
      "info": "Add a block per message.",
      "default": "row",
      "options": [
        {
          "value": "row",
          "label": "All in one row"
        },
        {
          "value": "marquee",
          "label": "Scrolling marquee"
        },
        {
          "value": "slideshow",
          "label": "One at a time with arrows"
        }
      ]
    },
    {
      "type": "select",
      "id": "zenith_separator",
      "label": "Separator between messages",
      "default": "dot",
      "options": [
        {
          "value": "dot",
          "label": "Dot •"
        },
        {
          "value": "line",
          "label": "Line |"
        },
        {
          "value": "none",
          "label": "Space only"
        }
      ]
    },
    {
      "type": "range",
      "id": "zenith_gap",
      "label": "Space between messages",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "zenith_overflow",
      "label": "When the row doesn't fit",
      "info": "\"All in one row\" on narrow screens (e.g. phones). One at a time uses \"Change slides every\".",
      "default": "rotate",
      "options": [
        {
          "value": "rotate",
          "label": "Show one at a time"
        },
        {
          "value": "marquee",
          "label": "Scroll as a marquee"
        },
        {
          "value": "wrap",
          "label": "Wrap onto more lines"
        }
      ]
    },
    {
      "type": "range",
      "id": "zenith_marquee_speed",
      "label": "Marquee speed",
      "info": "Pixels per second. Higher is faster.",
      "min": 10,
      "max": 150,
      "step": 5,
      "default": 40
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "zenith_font",
      "label": "Font",
      "default": "body",
      "options": [
        {
          "value": "body",
          "label": "Body (Geist)"
        },
        {
          "value": "heading",
          "label": "Heading (condensed)"
        }
      ]
    },
    {
      "type": "select",
      "id": "zenith_font_weight",
      "label": "Font weight",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "zenith_font_size",
      "label": "Text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "zenith_uppercase",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "zenith_height_mobile",
      "label": "Bar height",
      "min": 24,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 33
    },
    {
      "type": "range",
      "id": "zenith_font_size_mobile",
      "label": "Text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "zenith_gap_mobile",
      "label": "Space between messages",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "paragraph",
         "content": "t:sections.announcement-bar.settings.paragraph.content"
    },             
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Zenith money-back guarantee.",
          "info": "[customers] is replaced with Theme settings > Zenith > Customer count.",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
