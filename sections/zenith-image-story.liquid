{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-image-story.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
  --z-story-title-color: {{ section.settings.column_title_color }};
  --z-story-text-a: {{ section.settings.text_opacity | divided_by: 100.0 }};
  --z-story-colsp: {{ section.settings.columns_spacing }}px;
  --z-story-colsp-m: {{ section.settings.columns_spacing_mobile }}px;
  --z-story-colgap: {{ section.settings.columns_gap }}px;
  --z-story-colgap-m: {{ section.settings.columns_gap_mobile }}px;
  --z-story-coltsp: {{ section.settings.column_title_spacing }}px;
  --z-story-cols-m: {{ section.settings.columns_mobile }};
  --z-story-hlh: {{ section.settings.heading_line_height | divided_by: 100.0 }};
  --z-story-hlh-m: {{ section.settings.heading_line_height_mobile | divided_by: 100.0 }};
  --z-story-fade-m: {{ section.settings.image_fade_mobile }}%;
  --z-story-ovl-m: {{ section.settings.content_overlap_mobile }}px;
  --z-story-cmw-m: {{ section.settings.content_max_width_mobile }}px;
  {%- if section.settings.heading_color != blank %}
  --z-story-hc: {{ section.settings.heading_color }};
  {%- endif %}
  {%- if section.settings.column_icon_color != blank %}
  --z-story-icon-c: {{ section.settings.column_icon_color }};
  {%- endif %}
  {%- if section.settings.column_text_opacity > 0 %}
  --z-story-coltext-a: {{ section.settings.column_text_opacity | divided_by: 100.0 }};
  {%- endif %}
  {%- if section.settings.text_max_width < 1000 %}
  --z-story-tmw: {{ section.settings.text_max_width }}px;
  {%- endif %}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_top = false
  if section.settings.heading_position_mobile == 'above'
    if section.settings.heading != blank or section.settings.eyebrow != blank
      assign heading_top = true
    endif
  endif

  assign story_classes = 'zenith-story--' | append: section.settings.image_ratio
  assign story_classes = story_classes | append: ' zenith-story--m-' | append: section.settings.image_ratio_mobile
  assign story_classes = story_classes | append: ' zenith-story--align-' | append: section.settings.content_align
  if section.settings.image_position == 'right'
    assign story_classes = story_classes | append: ' zenith-story--image-right'
  endif
  if section.settings.image_full_bleed_mobile
    assign story_classes = story_classes | append: ' zenith-story--m-bleed'
  endif
  if section.settings.image_fade_mobile > 0
    assign story_classes = story_classes | append: ' zenith-story--m-fade'
  endif
  if section.settings.content_overlap_mobile > 0
    assign story_classes = story_classes | append: ' zenith-story--m-overlap'
  endif
  if section.settings.heading_color != blank
    assign story_classes = story_classes | append: ' zenith-story--heading-color'
  endif
  if section.settings.hide_heading_desktop
    assign story_classes = story_classes | append: ' zenith-story--heading-hide-d'
  endif
  if section.settings.columns_layout == 'list'
    assign story_classes = story_classes | append: ' zenith-story--list'
  endif

  assign image_sizes = '(min-width: 990px) calc((100vw - 10rem) / 2), (min-width: 750px) calc(100vw - 10rem), calc(100vw - 3rem)'
  if section.settings.image_full_bleed_mobile
    assign image_sizes = '(min-width: 990px) calc((100vw - 10rem) / 2), 100vw'
  endif
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
-%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-story color-{{ section.settings.color_scheme }} gradient {{ story_classes }}"
>
  <div class="page-width">
    <div class="zenith-story__grid">
      {%- if heading_top -%}
        {%- render 'zenith-section-heading',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          subheading: blank,
          alignment: 'left',
          tag: heading_tag,
          uppercase: section.settings.heading_uppercase,
          class: 'zenith-story__heading zenith-story__heading--top'
        -%}
      {%- endif -%}

      <div class="zenith-media zenith-story__media">
        {%- if section.settings.image != blank or section.settings.image_mobile != blank -%}
          {%- render 'zenith-responsive-image',
            image: section.settings.image,
            mobile_image: section.settings.image_mobile,
            widths: '400, 550, 750, 1100, 1600',
            sizes: image_sizes,
            loading: image_loading,
            fetchpriority: image_priority
          -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
      </div>

      <div class="zenith-story__content">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 800
            | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', sizes: '(min-width: 750px) 240px, 200px', class: 'zenith-story__logo'
          }}
        {%- elsif section.settings.use_brand_logo -%}
          {%- if section.settings.brand_logo_style == 'wordmark' -%}
            <img
              src="{{ 'header-logo.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              width="223"
              height="60"
              loading="lazy"
              class="zenith-story__logo"
            >
          {%- else -%}
            <img
              src="{{ 'footer-logo.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              width="204"
              height="80"
              loading="lazy"
              class="zenith-story__logo"
            >
          {%- endif -%}
        {%- endif -%}

        {%- unless heading_top and section.settings.hide_heading_desktop -%}
          {%- liquid
            assign heading_class = 'zenith-story__heading'
            if heading_top
              assign heading_class = 'zenith-story__heading zenith-story__heading--below'
            endif
          -%}
          {%- render 'zenith-section-heading',
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading,
            subheading: blank,
            alignment: 'left',
            tag: heading_tag,
            uppercase: section.settings.heading_uppercase,
            class: heading_class
          -%}
        {%- endunless -%}

        {%- liquid
          # Shared copy: Theme settings → Zenith · Brand story, when the section opts in.
          assign story_text = section.settings.text
          if section.settings.shared_text
            assign story_text = settings.zbs_text
          endif
        -%}
        {%- if story_text != blank -%}
          <div class="zenith-story__text zenith-rte">
            {{- story_text | replace: '[customers]', settings.customer_count -}}
          </div>
        {%- endif -%}

        {%- if section.settings.shared_columns -%}
          <div class="zenith-story__columns">
            {%- for i in (1..2) -%}
              {%- liquid
                assign col_title_key = 'zbs_col' | append: i | append: '_title'
                assign col_text_key = 'zbs_col' | append: i | append: '_text'
                assign col_title = settings[col_title_key]
                assign col_text = settings[col_text_key]
              -%}
              {%- if col_title != blank or col_text != blank -%}
                <div class="zenith-story__column">
                  <div class="zenith-story__column-body">
                    {%- if col_title != blank -%}
                      <h3 class="zenith-story__column-title">
                        {{- col_title | escape | replace: '[customers]', settings.customer_count -}}
                      </h3>
                    {%- endif -%}
                    {%- if col_text != blank -%}
                      <div class="zenith-story__column-text zenith-rte">
                        {{- col_text | replace: '[customers]', settings.customer_count -}}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- elsif section.blocks.size > 0 -%}
          <div class="zenith-story__columns">
            {%- for block in section.blocks -%}
              {%- assign column_icon = block.settings.icon | default: 'none' -%}
              <div
                class="zenith-story__column{% if column_icon != 'none' %} zenith-story__column--icon{% endif %}"
                id="Block-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {%- if column_icon != 'none' -%}
                  <span class="zenith-story__column-icon">{% render 'zenith-icon', icon: column_icon %}</span>
                {%- endif -%}
                <div class="zenith-story__column-body">
                  {%- if block.settings.title != blank -%}
                    <h3 class="zenith-story__column-title">
                      {{- block.settings.title | escape | replace: '[customers]', settings.customer_count -}}
                    </h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="zenith-story__column-text zenith-rte">
                      {{- block.settings.text | replace: '[customers]', settings.customer_count -}}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="zenith-story__actions">
            {%- if section.settings.button_label_mobile != blank -%}
              {%- render 'zenith-button',
                label: section.settings.button_label,
                link: section.settings.button_link,
                style: section.settings.button_style,
                class: 'zenith-hide-mobile'
              -%}
              {%- render 'zenith-button',
                label: section.settings.button_label_mobile,
                link: section.settings.button_link,
                style: section.settings.button_style,
                class: 'zenith-hide-desktop'
              -%}
            {%- else -%}
              {%- render 'zenith-button',
                label: section.settings.button_label,
                link: section.settings.button_link,
                style: section.settings.button_style
              -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Brand story",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. A different crop for phones; empty = the image above."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional. White wordmark on transparent background works best."
    },
    {
      "type": "checkbox",
      "id": "use_brand_logo",
      "label": "Use theme logo when no logo is selected",
      "default": true
    },
    {
      "type": "select",
      "id": "brand_logo_style",
      "visible_if": "{{ section.settings.use_brand_logo }}",
      "label": "Theme logo version",
      "default": "tagline",
      "options": [
        { "value": "tagline", "label": "Wordmark with tagline" },
        { "value": "wordmark", "label": "Wordmark only" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "shared_text",
      "label": "Use shared story text",
      "default": false,
      "info": "Text comes from Theme settings → Zenith · Brand story, the same on every page that ticks this. The Text field below is then ignored."
    },
    {
      "type": "checkbox",
      "id": "shared_columns",
      "label": "Use shared Mission / Vision",
      "default": false,
      "info": "Columns come from Theme settings → Zenith · Brand story instead of this section's column blocks."
    },
    {
      "type": "richtext",
      "id": "text",
      "visible_if": "{{ section.settings.shared_text == false }}",
      "label": "Text",
      "info": "[customers] shows the customer count from Theme settings → Zenith.",
      "default": "<p>Filipino men over 35 have been underserved for too long. Forced to choose between overly complicated routines or generic imported products not built for the climate, Zenith was built to fix that.</p><p>The brand wasn't created to be just another skincare line focused on aesthetics or flashy packaging. Instead, Zenith is committed to building high-performance personal care gear designed for real conditions, real needs, and real lives.</p><p>No hype and no shortcuts. Just straightforward, highly effective products that solve real, everyday problems for men who just want things that actually work.</p><p>Fast forward to today, and [customers] men have made Zenith a part of their daily routine. But looking back on this growth, this milestone isn't really about the company or its logos. It is a testament to the customers who truly built the brand.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Desktop image shape",
      "default": "adapt",
      "options": [
        { "value": "adapt", "label": "Match content height" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ]
    },
    {
      "type": "range",
      "id": "media_min_height",
      "visible_if": "{{ section.settings.image_ratio == 'adapt' }}",
      "label": "Desktop image min height",
      "min": 240,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 720,
      "info": "Used when image shape is \"Match content height\""
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Desktop content vertical alignment",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Desktop content top/bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between image and content",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between logo, text and button",
      "min": 4,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "info": "Limits the width of the heading, text and button. 1000 = no limit.",
      "min": 240,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Text max width (desktop)",
      "info": "Limits only the paragraph text, so the heading can run wider. 1000 = no limit.",
      "min": 240,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "checkbox",
      "id": "hide_heading_desktop",
      "label": "Hide heading on desktop",
      "info": "Heading shows only when image and text are stacked (mobile and tablet).",
      "default": false
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "select",
      "id": "columns_layout",
      "label": "Text columns layout",
      "info": "List = one item per row with its icon beside the text.",
      "default": "columns",
      "options": [
        { "value": "columns", "label": "Columns (2 per row on desktop)" },
        { "value": "list", "label": "List (icon beside text)" }
      ]
    },
    {
      "type": "range",
      "id": "columns_spacing",
      "label": "Space above text columns",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Space between text columns",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "column_title_spacing",
      "label": "Space below column title",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave empty to use the color scheme text color."
    },
    {
      "type": "color",
      "id": "column_title_color",
      "label": "Column title color",
      "default": "#EABE5F"
    },
    {
      "type": "color",
      "id": "column_icon_color",
      "label": "Column icon color",
      "default": "#EABE5F"
    },
    {
      "type": "range",
      "id": "text_opacity",
      "label": "Body text opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "column_text_opacity",
      "label": "Column text opacity",
      "info": "0 = same as body text.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "gold",
      "options": [
        { "value": "gold", "label": "Gold gradient" },
        { "value": "dark", "label": "Dark" },
        { "value": "outline", "label": "Outline" },
        { "value": "light", "label": "Light" },
        { "value": "scheme", "label": "Color scheme button" }
      ]
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Image overlay",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "bottom", "label": "Gradient from bottom" },
        { "value": "top", "label": "Gradient from top" },
        { "value": "left", "label": "Gradient from left" },
        { "value": "right", "label": "Gradient from right" }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "visible_if": "{{ section.settings.overlay_style != 'none' }}",
      "label": "Overlay color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "visible_if": "{{ section.settings.overlay_style != 'none' }}",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "visible_if": "{{ section.settings.overlay_style != 'none' and section.settings.overlay_style != 'solid' }}",
      "label": "Gradient length",
      "info": "How far the gradient reaches across the image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "info": "Use H1 only for the first heading of a page (not on the home page).",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height",
      "min": 90,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 110
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Column title size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Column icon size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button text size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Image shape",
      "info": "Also used on tablet, where image and text stack.",
      "default": "landscape",
      "options": [
        { "value": "landscape", "label": "Landscape 3:2" },
        { "value": "classic", "label": "Landscape 4:3" },
        { "value": "wide", "label": "Wide 16:9" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait 4:5" },
        { "value": "fixed", "label": "Fixed height" }
      ]
    },
    {
      "type": "range",
      "id": "media_height_mobile",
