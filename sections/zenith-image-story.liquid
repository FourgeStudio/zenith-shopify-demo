{{ 'zenith-image-story.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
  --z-story-title-color: {{ section.settings.column_title_color }};
  --z-story-text-a: {{ section.settings.text_opacity | divided_by: 100.0 }};
  --z-story-colsp: {{ section.settings.columns_spacing }}px;
  --z-story-colsp-m: {{ section.settings.columns_spacing_mobile }}px;
  --z-story-colgap: {{ section.settings.columns_gap }}px;
  --z-story-colgap-m: {{ section.settings.columns_gap_mobile }}px;
  --z-story-coltsp: {{ section.settings.column_title_spacing }}px;
  --z-story-cols-m: {{ section.settings.columns_mobile }};
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-story color-{{ section.settings.color_scheme }} gradient{% if section.settings.image_position == 'right' %} zenith-story--image-right{% endif %} zenith-story--{{ section.settings.image_ratio }} zenith-story--m-{{ section.settings.image_ratio_mobile }} zenith-story--align-{{ section.settings.content_align }}"
>
  <div class="page-width">
    <div class="zenith-story__grid">
      <div class="zenith-media zenith-story__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400, 550, 750, 1100, 1600',
              sizes: '(min-width: 990px) calc((100vw - 10rem) / 2), (min-width: 750px) calc(100vw - 10rem), calc(100vw - 3rem)'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
      </div>

      <div class="zenith-story__content">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 800
            | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', sizes: '(min-width: 750px) 240px, 200px', class: 'zenith-story__logo'
          }}
        {%- elsif section.settings.use_brand_logo -%}
          <img
            src="{{ 'footer-logo.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="204"
            height="80"
            loading="lazy"
            class="zenith-story__logo"
          >
        {%- endif -%}

        {%- render 'zenith-section-heading',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          subheading: blank,
          alignment: 'left',
          uppercase: section.settings.heading_uppercase,
          class: 'zenith-story__heading'
        -%}

        {%- if section.settings.text != blank -%}
          <div class="zenith-story__text zenith-rte">
            {{- section.settings.text | replace: '[customers]', settings.customer_count -}}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="zenith-story__columns">
            {%- for block in section.blocks -%}
              <div class="zenith-story__column" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <h3 class="zenith-story__column-title">
                    {{- block.settings.title | escape | replace: '[customers]', settings.customer_count -}}
                  </h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="zenith-story__column-text zenith-rte">
                    {{- block.settings.text | replace: '[customers]', settings.customer_count -}}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="zenith-story__actions">
            {%- render 'zenith-button',
              label: section.settings.button_label,
              link: section.settings.button_link,
              style: section.settings.button_style
            -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Brand story",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional. White wordmark on transparent background works best."
    },
    {
      "type": "checkbox",
      "id": "use_brand_logo",
      "label": "Use theme logo when no logo is selected",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "[customers] shows the customer count from Theme settings → Zenith.",
      "default": "<p>Filipino men over 35 have been underserved for too long. Forced to choose between overly complicated routines or generic imported products not built for the climate, Zenith was built to fix that.</p><p>The brand wasn't created to be just another skincare line focused on aesthetics or flashy packaging. Instead, Zenith is committed to building high-performance personal care gear designed for real conditions, real needs, and real lives.</p><p>No hype and no shortcuts. Just straightforward, highly effective products that solve real, everyday problems for men who just want things that actually work.</p><p>Fast forward to today, and [customers] men have made Zenith a part of their daily routine. But looking back on this growth, this milestone isn't really about the company or its logos. It is a testament to the customers who truly built the brand.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Desktop image shape",
      "default": "adapt",
      "options": [
        { "value": "adapt", "label": "Match content height" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ]
    },
    {
      "type": "range",
      "id": "media_min_height",
      "label": "Desktop image min height",
      "min": 240,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 720,
      "info": "Used when image shape is \"Match content height\""
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Desktop content vertical alignment",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Desktop content top/bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between image and content",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between logo, text and button",
      "min": 4,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "columns_spacing",
      "label": "Space above text columns",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Space between text columns",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "column_title_spacing",
      "label": "Space below column title",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "column_title_color",
      "label": "Column title color",
      "default": "#EABE5F"
    },
    {
      "type": "range",
      "id": "text_opacity",
      "label": "Body text opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "gold",
      "options": [
        { "value": "gold", "label": "Gold gradient" },
        { "value": "dark", "label": "Dark" },
        { "value": "outline", "label": "Outline" },
        { "value": "light", "label": "Light" },
        { "value": "scheme", "label": "Color scheme button" }
      ]
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Image overlay",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "bottom", "label": "Gradient from bottom" },
        { "value": "top", "label": "Gradient from top" },
        { "value": "left", "label": "Gradient from left" },
        { "value": "right", "label": "Gradient from right" }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Gradient length",
      "info": "How far the gradient reaches across the image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Column title size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button text size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Image shape",
      "info": "Also used on tablet, where image and text stack.",
      "default": "landscape",
      "options": [
        { "value": "landscape", "label": "Landscape 3:2" },
        { "value": "classic", "label": "Landscape 4:3" },
        { "value": "wide", "label": "Wide 16:9" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait 4:5" }
      ]
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Column title size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "label": "Button text size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between image and content",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "label": "Space between logo, text and button",
      "min": 4,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "columns_spacing_mobile",
      "label": "Space above text columns",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Text columns per row",
      "default": "1",
      "options": [
        { "value": "1", "label": "1 (stacked)" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "range",
      "id": "columns_gap_mobile",
      "label": "Space between text columns",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
