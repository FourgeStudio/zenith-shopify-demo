  ],
  "blocks": [
    {
      "type": "column",
      "name": "Text column",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mission"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>To build premium, high-performance self-care for mature Filipino men, and give them easy access to it.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith · Brand story",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "Mission",
            "text": "<p>To build premium, high-performance self-care for mature Filipino men, and give them easy access to it.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Vision",
            "text": "<p>To empower mature Filipino men to always feel in their prime.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
