{{ 'zenith-image-story.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-story color-{{ section.settings.color_scheme }} gradient{% if section.settings.image_position == 'right' %} zenith-story--image-right{% endif %} zenith-story--{{ section.settings.image_ratio }}"
>
  <div class="page-width">
    <div class="zenith-story__grid">
      <div class="zenith-media zenith-story__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: loading: 'lazy', widths: '550, 750, 1100, 1600', sizes: '(min-width: 750px) 50vw, 100vw'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
      </div>

      <div class="zenith-story__content">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 600
            | image_tag: loading: 'lazy', widths: '200, 400, 600', sizes: '240px', class: 'zenith-story__logo'
          }}
        {%- elsif section.settings.use_brand_logo -%}
          <img src="{{ 'footer-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="204" height="80" loading="lazy" class="zenith-story__logo">
        {%- endif -%}

        {%- render 'zenith-section-heading',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          subheading: blank,
          alignment: 'left',
          uppercase: section.settings.heading_uppercase,
          class: 'zenith-story__heading'
        -%}

        {%- if section.settings.text != blank -%}
          <div class="zenith-story__text zenith-rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="zenith-story__columns">
            {%- for block in section.blocks -%}
              <div class="zenith-story__column" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <h3 class="zenith-story__column-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="zenith-rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
            class="button button--secondary"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Brand story",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional"
    },
    {
      "type": "checkbox",
      "id": "use_brand_logo",
      "label": "Use theme logo when no logo is selected",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Zenith has over 100,000 men who have trusted us for their long-term grooming. We started because mature Filipino men were underserved: products built for younger men, for other climates, or loaded with hype.</p><p>We build honest, high-performance essentials that work in Philippine heat and humidity, and we stand behind every one of them.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "adapt",
      "options": [
        {
          "value": "adapt",
          "label": "Fill content height"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between image and content",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between content items",
      "min": 4,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "media_min_height",
      "label": "Image min height",
      "min": 240,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 480,
      "info": "Used when Image shape is \"Fill content height\""
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Image overlay",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "bottom",
          "label": "Gradient from bottom"
        },
        {
          "value": "top",
          "label": "Gradient from top"
        },
        {
          "value": "left",
          "label": "Gradient from left"
        },
        {
          "value": "right",
          "label": "Gradient from right"
        }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Gradient length",
      "info": "How far the gradient reaches across the image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Column title size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Column title size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between image and content",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "label": "Space between content items",
      "min": 4,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Text column",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mission"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>To build premium, high-performance self-care for mature Filipino men, and give them easy access to it.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith · Brand story",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "Mission",
            "text": "<p>To build premium, high-performance self-care for mature Filipino men, and give them easy access to it.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Vision",
            "text": "<p>To empower mature Filipino men to always feel in their prime.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
