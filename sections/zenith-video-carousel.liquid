{{ 'zenith-video-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'zenith-video.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cols = section.settings.slides_desktop
  assign gap_count = section.settings.slides_desktop | minus: 1
  if section.settings.show_peek
    assign cols = cols | plus: 0.35
    assign gap_count = gap_count | plus: 1
  endif
-%}
{%- capture extra -%}
  --z-slide: calc((100% - {{ gap_count }} * var(--z-gap, 24px)) / {{ cols }});
  --z-slide-m: {{ section.settings.mobile_slide_width }}%;
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-videos zenith-videos--{{ section.settings.video_ratio }} color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      uppercase: section.settings.heading_uppercase
    -%}

    <zenith-carousel data-autoplay="{{ section.settings.autoplay }}" data-slide-label="Video">
      <ul class="zenith-carousel__track" role="list">
        {%- for block in section.blocks -%}
          <li class="zenith-carousel__slide" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
            <article class="zenith-video-card color-{{ section.settings.card_color_scheme }} gradient">
              <zenith-video class="zenith-media zenith-video-card__media">
                {%- if block.settings.video != blank -%}
                  {{
                    block.settings.video
                    | video_tag:
                      image_size: '720x',
                      preload: 'none',
                      playsinline: true,
                      class: 'zenith-video-card__video'
                  }}
                  <button type="button" class="zenith-video-card__play" data-video-toggle aria-pressed="false" aria-label="Play video{% if block.settings.author != blank %} from {{ block.settings.author | escape }}{% endif %}">
                    {%- render 'zenith-icon', icon: 'play' -%}
                  </button>
                {%- elsif block.settings.poster != blank -%}
                  {{
                    block.settings.poster
                    | image_url: width: 720
                    | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 750px) 25vw, 75vw'
                  }}
                  <span class="zenith-video-card__play" aria-hidden="true">{%- render 'zenith-icon', icon: 'play' -%}</span>
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  <span class="zenith-video-card__play" aria-hidden="true">{%- render 'zenith-icon', icon: 'play' -%}</span>
                {%- endif -%}
                {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
              </zenith-video>

              <div class="zenith-video-card__body">
                {%- if block.settings.quote != blank -%}
                  <blockquote class="zenith-video-card__quote">{{ block.settings.quote | escape | newline_to_br }}</blockquote>
                {%- endif -%}
                {%- if block.settings.author != blank -%}
                  <p class="zenith-video-card__author">
                    {{ block.settings.author | escape }}
                    {%- if block.settings.author_meta != blank -%}
                      <span>{{ block.settings.author_meta | escape }}</span>
                    {%- endif -%}
                  </p>
                {%- endif -%}

                {%- assign p = block.settings.product -%}
                {%- if p != blank -%}
                  <a href="{{ p.url }}" class="zenith-video-card__product">
                    <span class="zenith-media zenith-video-card__product-media">
                      {%- if p.featured_media -%}
                        {{ p.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                      {%- endif -%}
                    </span>
                    <span class="zenith-video-card__product-info">
                      <span class="zenith-video-card__product-title">{{ p.title | escape }}</span>
                      <span class="zenith-video-card__product-price">{{ p.price | money }}</span>
                    </span>
                  </a>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>

      {%- render 'zenith-carousel-controls',
        show_dots: section.settings.show_dots,
        show_arrows: section.settings.show_arrows,
        label: 'video'
      -%}
    </zenith-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Video carousel",
  "tag": "div",
  "class": "section",
  "max_blocks": 16,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinically Proven. The Complete Regimen."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Hear from the men who use Zenith every day.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Videos per view on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_peek",
      "label": "Show part of the next video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Auto-advance",
      "info": "Seconds between slides. 0 turns it off.",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "video_ratio",
      "label": "Video shape",
      "default": "9-16",
      "options": [
        {
          "value": "9-16",
          "label": "Vertical 9:16"
        },
        {
          "value": "4-5",
          "label": "Portrait 4:5"
        },
        {
          "value": "1-1",
          "label": "Square"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-4"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Image overlay",
      "default": "bottom",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "bottom",
          "label": "Gradient from bottom"
        },
        {
          "value": "top",
          "label": "Gradient from top"
        },
        {
          "value": "left",
          "label": "Gradient from left"
        },
        {
          "value": "right",
          "label": "Gradient from right"
        }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Gradient length",
      "info": "How far the gradient reaches across the image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
