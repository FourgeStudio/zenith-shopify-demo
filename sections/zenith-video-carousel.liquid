{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-video-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'zenith-video.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cols = section.settings.slides_desktop
  assign gap_count = section.settings.slides_desktop | minus: 1
  assign play_alpha = section.settings.play_opacity | divided_by: 100.0
-%}
{%- capture extra -%}
  --z-slide: calc((100cqi - {{ gap_count }} * var(--z-gap, 24px)) / {{ cols }});
  --z-slide-m: calc({{ section.settings.mobile_slide_width }} * 1cqi);
  --z-hgap: {{ section.settings.heading_gap }}px;
  --z-hgap-m: {{ section.settings.heading_gap_mobile }}px;
  --z-ctrl-sp: {{ section.settings.controls_spacing }}px;
  --z-card-border: {{ section.settings.card_border_color }};
  --z-title-color: {{ section.settings.title_color }};
  --z-play: {{ section.settings.play_size }}px;
  --z-play-y: {{ section.settings.play_position }}%;
  --z-play-y-m: {{ section.settings.play_position_mobile }}%;
  --z-play-bg: {{ section.settings.play_color | color_modify: 'alpha', play_alpha }};
  --z-play-icon: {{ section.settings.play_icon_color }};
  --z-thumb: {{ section.settings.thumb_size }}px;
  --z-thumb-m: {{ section.settings.thumb_size_mobile }}px;
  --z-body-h: {{ section.settings.body_min_height }}px;
  --z-body-h-m: {{ section.settings.body_min_height_mobile }}px;
  --z-handle-fs: {{ section.settings.handle_font_size }}px;
  --z-handle-fs-m: {{ section.settings.handle_font_size_mobile }}px;
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- liquid
  assign heading = section.settings.heading | escape | replace: '[customers]', settings.customer_count
  assign heading_mobile = section.settings.heading_mobile | escape | replace: '[customers]', settings.customer_count | newline_to_br

  assign card_scheme = section.settings.card_color_scheme
  assign overlay_style = section.settings.overlay_style
  assign play_label = section.settings.play_label
  assign show_play = section.settings.show_play_without_video

  # Product filter: only videos whose featured product is in the list (",handle,handle,")
  assign filter_on = false
  assign filter_key = ''
  case section.settings.product_filter
    when 'selected'
      if section.settings.filter_products != blank
        assign filter_on = true
        assign filter_key = section.settings.filter_products | map: 'handle' | join: ','
      endif
    when 'page'
      # Product page: that product. Collection page: the products of the collection being viewed.
      if product != blank
        assign filter_on = true
        assign filter_key = product.handle
      elsif collection != blank
        assign filter_on = true
        assign filter_key = collection.products | map: 'handle' | join: ','
      endif
  endcase
  assign filter_key = ',' | append: filter_key | append: ','
  assign card_count = 0
-%}

{%- capture cards -%}
  {%- if section.settings.content_source == 'custom' -%}
    {%- for block in section.blocks -%}
      {%- liquid
        if filter_on
          if block.settings.product == blank
            continue
          endif
          assign needle = ',' | append: block.settings.product.handle | append: ','
          unless filter_key contains needle
            continue
          endunless
        endif
        assign card_count = card_count | plus: 1
      -%}
      {%- capture attrs %}id="Block-{{ block.id }}" {{ block.shopify_attributes }}{% endcapture -%}
      {%- render 'zenith-video-card',
        video: block.settings.video,
        youtube_url: block.settings.youtube_url,
        poster: block.settings.poster,
        quote: block.settings.quote,
        title: block.settings.title,
        link: block.settings.link,
        author: block.settings.author,
        product: block.settings.product,
        thumbnail: block.settings.thumbnail,
        attrs: attrs,
        card_scheme: card_scheme,
        overlay_style: overlay_style,
        play_label: play_label,
        show_play_without_video: show_play
      -%}
    {%- endfor -%}
  {%- else -%}
    {%- comment -%} Global: Theme settings → Zenith · Video testimonials, slots 1–20; empty slots are skipped {%- endcomment -%}
    {%- for i in (1..20) -%}
      {%- liquid
        assign p = 'vt' | append: i | append: '_'
        assign k_video = p | append: 'video'
        assign k_youtube = p | append: 'youtube'
        assign k_cover = p | append: 'cover'
        assign k_quote = p | append: 'quote'
        assign k_title = p | append: 'title'
        assign k_link = p | append: 'link'
        assign k_author = p | append: 'author'
        assign k_product = p | append: 'product'
        assign k_thumb = p | append: 'thumb'
        if settings[k_video] == blank and settings[k_youtube] == blank and settings[k_cover] == blank and settings[k_quote] == blank
          continue
        endif
        if filter_on
          assign slot_product = settings[k_product]
          if slot_product == blank
            continue
          endif
          assign needle = ',' | append: slot_product.handle | append: ','
          unless filter_key contains needle
            continue
          endunless
        endif
        assign card_count = card_count | plus: 1
      -%}
      {%- capture attrs %}id="VideoSlot-{{ i }}-{{ section.id }}"{% endcapture -%}
      {%- render 'zenith-video-card',
        video: settings[k_video],
        youtube_url: settings[k_youtube],
        poster: settings[k_cover],
        quote: settings[k_quote],
        title: settings[k_title],
        link: settings[k_link],
        author: settings[k_author],
        product: settings[k_product],
        thumbnail: settings[k_thumb],
        attrs: attrs,
        card_scheme: card_scheme,
        overlay_style: overlay_style,
        play_label: play_label,
        show_play_without_video: show_play
      -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- comment -%} No matching videos (e.g. a product page without videos): the section isn't shown; the editor gets a note. {%- endcomment -%}
{%- if card_count > 0 or request.design_mode -%}
<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-videos zenith-videos--{{ section.settings.video_ratio }} zenith-videos--q-{{ section.settings.quote_align }} zenith-videos--qm-{{ section.settings.quote_align_mobile }}{% if section.settings.show_peek %} zenith-videos--bleed{% endif %}{% if section.settings.center_when_fits %} zenith-videos--center{% endif %} color-{{ section.settings.color_scheme }} gradient{% if section.index > 2 %} zenith-defer{% endif %}"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or heading != blank or section.settings.subheading != blank -%}
      <div class="zenith-heading zenith-heading--{{ section.settings.heading_alignment }} zenith-heading--m-{{ section.settings.heading_alignment_mobile }}{% if section.settings.heading_uppercase %} zenith-heading--uppercase{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="zenith-eyebrow">
            {{- section.settings.eyebrow | escape | replace: '[customers]', settings.customer_count -}}
          </p>
        {%- endif -%}
        {%- if heading_mobile != blank -%}
          <h2 class="zenith-heading__title zenith-hide-mobile">{{ heading }}</h2>
          <h2 class="zenith-heading__title zenith-hide-desktop">{{ heading_mobile }}</h2>
        {%- elsif heading != blank -%}
          <h2 class="zenith-heading__title">{{ heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="zenith-subheading{% if section.settings.subheading_mobile_only %} zenith-hide-desktop{% endif %}">
            {{- section.settings.subheading | replace: '[customers]', settings.customer_count -}}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if card_count == 0 -%}
      <p class="zenith-videos__empty">No videos match this section's product filter, so it's hidden on the live store.</p>
    {%- else -%}
      {%- liquid
        # Global videos open at the global start card (Theme settings → Zenith · Video testimonials) so every page matches.
        assign vc_start = section.settings.start_slide | default: 1
        if section.settings.content_source != 'custom'
          assign vc_start = settings.vt_start_slide | default: vc_start
        endif
      -%}
      <zenith-carousel data-autoplay="{{ section.settings.autoplay }}" data-slide-label="Video" data-start="{{ vc_start }}">
        <ul class="zenith-carousel__track" role="list">
          {{- cards -}}
        </ul>

        {%- render 'zenith-carousel-controls',
          show_dots: section.settings.show_dots,
          show_arrows: section.settings.show_arrows,
          label: 'video'
        -%}
      </zenith-carousel>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Video carousel",
  "tag": "div",
  "class": "section",
  "max_blocks": 16,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "Videos",
      "info": "Global = the videos in Theme settings → Zenith · Video testimonials (edit once, same on every page). This section's cards = the Video testimonial blocks below.",
      "default": "global",
      "options": [
        {
          "value": "global",
          "label": "Global (Theme settings)"
        },
        {
          "value": "custom",
          "label": "This section's cards"
        }
      ]
    },
    {
      "type": "select",
      "id": "product_filter",
      "label": "Show videos for",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All products"
        },
        {
          "value": "selected",
          "label": "Only the products below"
        },
        {
          "value": "page",
          "label": "The product or collection on this page"
        }
      ],
      "info": "Uses each video's Featured product. \"The product or collection on this page\": on a product page that product, on a collection page the products in that collection; elsewhere all videos show. With no matching videos the section is hidden."
    },
    {
      "type": "product_list",
      "id": "filter_products",
      "label": "Products",
      "info": "Used with \"Only the products below\"",
      "limit": 20
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinically Proven. The Complete Regimen."
    },
    {
      "type": "textarea",
      "id": "heading_mobile",
      "label": "Mobile heading",
      "info": "Leave blank to use the heading above. Line breaks are kept.",
      "default": "A Complete Routine,\nBuilt for Men."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Hear from the men who use Zenith every day.</p>"
    },
    {
      "type": "checkbox",
      "id": "subheading_mobile_only",
      "label": "Show subheading on mobile only",
      "default": false
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Play button label",
      "info": "Read by screen readers",
      "default": "Play video"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "center_when_fits",
      "label": "Center the cards when they all fit",
      "info": "No arrows or dots then. When they don't fit on the screen (more cards, or a smaller screen), it's a carousel.",
      "default": true
    },
    {
      "type": "range",
      "id": "start_slide",
      "label": "Start at video",
      "info": "The carousel opens scrolled to this card (1 = first). With Videos = Global this comes from Theme settings → Zenith · Video testimonials instead.",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 1
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Videos per view on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_peek",
      "label": "Show part of the next video",
      "info": "Lets the carousel run to the right edge of the screen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Auto-advance",
      "info": "Seconds between slides. 0 turns it off.",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space between heading lines",
      "info": "Gap between eyebrow, heading and subheading",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "controls_spacing",
      "label": "Space above dots and arrows",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "video_ratio",
      "label": "Video shape",
      "default": "13-18",
      "options": [
        {
          "value": "9-16",
          "label": "Vertical 9:16"
        },
        {
