{{ 'zenith-video-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zenith-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'zenith-video.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cols = section.settings.slides_desktop
  assign gap_count = section.settings.slides_desktop | minus: 1
  assign play_alpha = section.settings.play_opacity | divided_by: 100.0
-%}
{%- capture extra -%}
  --z-slide: calc((100cqi - {{ gap_count }} * var(--z-gap, 24px)) / {{ cols }});
  --z-slide-m: calc({{ section.settings.mobile_slide_width }} * 1cqi);
  --z-hgap: {{ section.settings.heading_gap }}px;
  --z-hgap-m: {{ section.settings.heading_gap_mobile }}px;
  --z-ctrl-sp: {{ section.settings.controls_spacing }}px;
  --z-card-border: {{ section.settings.card_border_color }};
  --z-title-color: {{ section.settings.title_color }};
  --z-play: {{ section.settings.play_size }}px;
  --z-play-y: {{ section.settings.play_position }}%;
  --z-play-y-m: {{ section.settings.play_position_mobile }}%;
  --z-play-bg: {{ section.settings.play_color | color_modify: 'alpha', play_alpha }};
  --z-play-icon: {{ section.settings.play_icon_color }};
  --z-thumb: {{ section.settings.thumb_size }}px;
  --z-thumb-m: {{ section.settings.thumb_size_mobile }}px;
  --z-body-h: {{ section.settings.body_min_height }}px;
  --z-body-h-m: {{ section.settings.body_min_height_mobile }}px;
  --z-handle-fs: {{ section.settings.handle_font_size }}px;
  --z-handle-fs-m: {{ section.settings.handle_font_size_mobile }}px;
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- liquid
  assign heading = section.settings.heading | escape | replace: '[customers]', settings.customer_count
  assign heading_mobile = section.settings.heading_mobile | escape | replace: '[customers]', settings.customer_count | newline_to_br
-%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-videos zenith-videos--{{ section.settings.video_ratio }} zenith-videos--q-{{ section.settings.quote_align }} zenith-videos--qm-{{ section.settings.quote_align_mobile }}{% if section.settings.show_peek %} zenith-videos--bleed{% endif %} color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or heading != blank or section.settings.subheading != blank -%}
      <div class="zenith-heading zenith-heading--{{ section.settings.heading_alignment }} zenith-heading--m-{{ section.settings.heading_alignment_mobile }}{% if section.settings.heading_uppercase %} zenith-heading--uppercase{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="zenith-eyebrow">
            {{- section.settings.eyebrow | escape | replace: '[customers]', settings.customer_count -}}
          </p>
        {%- endif -%}
        {%- if heading_mobile != blank -%}
          <h2 class="zenith-heading__title zenith-hide-mobile">{{ heading }}</h2>
          <h2 class="zenith-heading__title zenith-hide-desktop">{{ heading_mobile }}</h2>
        {%- elsif heading != blank -%}
          <h2 class="zenith-heading__title">{{ heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="zenith-subheading">
            {{- section.settings.subheading | replace: '[customers]', settings.customer_count -}}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <zenith-carousel data-autoplay="{{ section.settings.autoplay }}" data-slide-label="Video">
      <ul class="zenith-carousel__track" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_product = block.settings.product
            assign thumb = block.settings.thumbnail
            if thumb == blank and card_product != blank
              assign thumb = card_product.featured_image
            endif
            assign title_link = block.settings.link
            if title_link == blank and card_product != blank
              assign title_link = card_product.url
            endif
            assign handle = block.settings.author | escape
          -%}
          <li class="zenith-carousel__slide" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
            <article class="zenith-video-card color-{{ section.settings.card_color_scheme }}">
              <zenith-video class="zenith-media zenith-video-card__media">
                {%- if block.settings.video != blank -%}
                  {{
                    block.settings.video
                    | video_tag:
                      image_size: '720x',
                      preload: 'none',
                      playsinline: true,
                      class: 'zenith-video-card__video'
                  }}
                  {%- if block.settings.poster != blank -%}
                    {{
                      block.settings.poster
                      | image_url: width: 720
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720',
                        sizes: '(min-width: 750px) 25vw, 85vw',
                        class: 'zenith-video-card__poster',
                        alt: ''
                    }}
                  {%- endif -%}
                {%- elsif block.settings.poster != blank -%}
                  {{
                    block.settings.poster
                    | image_url: width: 720
                    | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 750px) 25vw, 85vw'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
                {%- if block.settings.video != blank -%}
                  <button
                    type="button"
                    class="zenith-video-card__play"
                    data-video-toggle
                    aria-pressed="false"
                    aria-label="{{ section.settings.play_label | escape }}{% if handle != blank %} – {{ handle }}{% endif %}"
                  >
                    <svg viewBox="0 0 24 32" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M0 0v32l24-16z"/>
                    </svg>
                  </button>
                {%- elsif section.settings.show_play_without_video -%}
                  <span class="zenith-video-card__play" aria-hidden="true">
                    <svg viewBox="0 0 24 32" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M0 0v32l24-16z"/>
                    </svg>
                  </span>
                {%- endif -%}
              </zenith-video>

              <div class="zenith-video-card__body">
                <div class="zenith-video-card__quote-wrap">
                  {%- if block.settings.quote != blank -%}
                    <blockquote class="zenith-video-card__quote">
                      {{- block.settings.quote | escape | replace: '[customers]', settings.customer_count | newline_to_br -}}
                    </blockquote>
                  {%- endif -%}
                </div>

                {%- if thumb != blank or block.settings.title != blank or handle != blank -%}
                  <div class="zenith-video-card__meta">
                    {%- if thumb != blank -%}
                      <span class="zenith-video-card__thumb">
                        {{
                          thumb
                          | image_url: width: 160
                          | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '56px', alt: ''
                        }}
                      </span>
                    {%- endif -%}
                    <div class="zenith-video-card__info">
                      {%- if block.settings.title != blank -%}
                        {%- if title_link != blank -%}
                          <a href="{{ title_link }}" class="zenith-video-card__title">
                            {{- block.settings.title | escape -}}
                          </a>
                        {%- else -%}
                          <p class="zenith-video-card__title">{{ block.settings.title | escape }}</p>
                        {%- endif -%}
                      {%- endif -%}
                      {%- if handle != blank -%}
                        <p class="zenith-video-card__handle">{{ handle }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>

      {%- render 'zenith-carousel-controls',
        show_dots: section.settings.show_dots,
        show_arrows: section.settings.show_arrows,
        label: 'video'
      -%}
    </zenith-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Video carousel",
  "tag": "div",
  "class": "section",
  "max_blocks": 16,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
