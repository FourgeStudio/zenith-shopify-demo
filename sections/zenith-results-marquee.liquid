{{ 'zenith-results-marquee.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  --z-card-w: {{ section.settings.card_width }}px;
  --z-card-w-m: {{ section.settings.mobile_card_width }}px;
  --z-speed: {{ section.settings.speed }}s;
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- assign row_count = section.settings.rows | plus: 0 -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-results color-{{ section.settings.color_scheme }} gradient zenith-results--{{ section.settings.aspect_ratio }}{% if section.settings.pause_on_hover %} zenith-results--pause{% endif %}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      uppercase: section.settings.heading_uppercase
    -%}
  </div>

  <div class="zenith-results__rows">
    {%- for r in (1..row_count) -%}
      {%- liquid
        assign row_key = r | append: ''
        assign item_count = 0
        for block in section.blocks
          if row_count == 1 or block.settings.row == row_key
            assign item_count = item_count | plus: 1
          endif
        endfor
        assign reverse = false
        if r == 2 and section.settings.alternate_direction
          assign reverse = true
        endif
      -%}
      <div class="zenith-results__row{% if reverse %} zenith-results__row--reverse{% endif %}">
        <div class="zenith-results__track">
          {%- for pass in (1..4) -%}
            <ul class="zenith-results__group" role="list"{% if pass > 1 %} aria-hidden="true"{% endif %}>
              {%- if item_count > 0 -%}
                {%- for block in section.blocks -%}
                  {%- unless row_count == 1 or block.settings.row == row_key -%}{%- continue -%}{%- endunless -%}
                  <li class="zenith-results__card"{% if pass == 1 %} id="Block-{{ block.id }}" {{ block.shopify_attributes }}{% endif %}>
                    <div class="zenith-media zenith-results__media">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 600
                          | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '(min-width: 750px) 240px, 160px'
                        }}
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                      {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
                    </div>
                    {%- if block.settings.caption != blank -%}
                      <p class="zenith-results__caption">{{ block.settings.caption | escape }}</p>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..8) -%}
                  <li class="zenith-results__card">
                    <div class="zenith-media zenith-results__media">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- render 'zenith-overlay', style: section.settings.overlay_style -%}</div>
                    <p class="zenith-results__caption">Add a result in the theme editor</p>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.link_label != blank -%}
    <div class="page-width zenith-results__footer">
      <a
        {% if section.settings.link != blank %}href="{{ section.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
        class="link underlined-link"
      >
        {{- section.settings.link_label | escape -}}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Zenith · Results marquee",
  "tag": "div",
  "class": "section",
  "max_blocks": 40,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Verified customer results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Men. Real Results."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>See the difference a proper regimen makes. From uneven skin to thinner hair, every transformation here comes from verified Zenith customers putting in the consistent work.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "See more results"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "rows",
      "label": "Rows",
      "default": "2",
      "info": "With 2 rows, pick each result's row in its block settings",
      "options": [
        {
          "value": "1",
          "label": "1 row"
        },
        {
          "value": "2",
          "label": "2 rows"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 140,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Card shape",
      "default": "portrait",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "tall",
          "label": "Tall 3:4"
        }
      ]
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration",
      "info": "Seconds for one full loop. Higher is slower.",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "alternate_direction",
      "label": "Scroll second row in reverse",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Image overlay",
      "default": "bottom",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "bottom",
          "label": "Gradient from bottom"
        },
        {
          "value": "top",
          "label": "Gradient from top"
        },
        {
          "value": "left",
          "label": "Gradient from left"
        },
        {
          "value": "right",
          "label": "Gradient from right"
        }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Gradient length",
      "info": "How far the gradient reaches across the image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
