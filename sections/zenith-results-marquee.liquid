{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-results-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zenith-results-marquee.js' | asset_url }}" defer="defer"></script>
{%- capture extra -%}
  --z-card-w: {{ section.settings.card_width }}px;
  --z-card-w-m: {{ section.settings.mobile_card_width }}px;
  --z-card-h: {{ section.settings.card_height }}px;
  --z-card-h-m: {{ section.settings.card_height_mobile }}px;
  --z-speed: {{ section.settings.speed }}s;
  --z-speed-m: {{ section.settings.speed_mobile | default: section.settings.speed }}s;
  --z-hgap: {{ section.settings.heading_gap }}px;
  --z-hgap-m: {{ section.settings.heading_gap_mobile }}px;
  --z-thumb: {{ section.settings.thumb_size }}px;
  --z-thumb-m: {{ section.settings.thumb_size_mobile }}px;
  --z-thumb-r: {{ section.settings.thumb_radius }}px;
  --z-rv-pad: {{ section.settings.review_padding }}px;
  --z-rv-pad-m: {{ section.settings.review_padding_mobile }}px;
  --z-rv-lines: {{ section.settings.quote_lines }};
  --z-star: {{ section.settings.star_size }}px;
  --z-star-m: {{ section.settings.star_size_mobile }}px;
  --z-avatar: {{ section.settings.avatar_size }}px;
  --z-avatar-m: {{ section.settings.avatar_size_mobile }}px;
  --z-qfs: {{ section.settings.quote_font_size }}px;
  --z-qfs-m: {{ section.settings.quote_font_size_mobile }}px;
  --z-nfs: {{ section.settings.name_font_size }}px;
  --z-nfs-m: {{ section.settings.name_font_size_mobile }}px;
  --z-dfs: {{ section.settings.detail_font_size }}px;
  --z-dfs-m: {{ section.settings.detail_font_size_mobile }}px;
  --z-caption-color: {{ section.settings.caption_color }};
  --z-thumb-bg: {{ section.settings.thumb_bg_color }};
  --z-rv-bg: {{ section.settings.review_bg_color }};
  --z-rv-quote: {{ section.settings.quote_color }};
  --z-rv-name: {{ section.settings.name_color }};
  --z-rv-detail: {{ section.settings.detail_color }};
  --z-rv-star: {{ section.settings.star_color }};
  --z-rv-badge: {{ section.settings.badge_color }};
  --z-disc-color: {{ section.settings.disclaimer_color }};
  --z-disc-fs: {{ section.settings.disclaimer_font_size }}px;
  --z-disc-fs-m: {{ section.settings.disclaimer_font_size_mobile }}px;
  --z-disc-sp: {{ section.settings.disclaimer_spacing }}px;
  --z-disc-sp-m: {{ section.settings.disclaimer_spacing_mobile }}px;
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- liquid
  assign row_count = section.settings.rows | plus: 0
  assign heading = section.settings.heading | escape | replace: '[customers]', settings.customer_count
  assign heading_mobile = section.settings.heading_mobile | escape | replace: '[customers]', settings.customer_count | newline_to_br
  assign prefix = section.settings.product_prefix | escape
  assign verified_label = section.settings.verified_label | escape
  assign photo_w = section.settings.card_width | times: section.settings.media_width | divided_by: 100
  assign photo_w_m = section.settings.mobile_card_width | times: section.settings.media_width_mobile | divided_by: 100
  assign photo_sizes = '(min-width: 750px) ' | append: photo_w | append: 'px, ' | append: photo_w_m | append: 'px'

  # Global: Theme settings → Zenith · Results reviews, slots rv1–rv30 (empty slots skipped). Custom: this section's blocks.
  assign use_global = false
  if section.settings.content_source == 'global'
    assign use_global = true
  endif
  assign total_count = 0
  # Card order: keys "PPPP-NN" (position, slot/block number), sorted as text. Slots with no Position get 9999,
  # so positioned slots come first (lowest first) and the rest keep slot order. Blocks keep editor (drag) order.
  assign order_keys = ''
  if use_global
    assign item_max = 30
    assign empty_note = 'Add reviews in Theme settings → Zenith · Results reviews'
    for n in (1..item_max)
      assign p = 'rv' | append: n | append: '_'
      assign k_image = p | append: 'image'
      assign k_quote = p | append: 'quote'
      assign k_author = p | append: 'author'
      if settings[k_image] != blank or settings[k_quote] != blank or settings[k_author] != blank
        assign total_count = total_count | plus: 1
        assign k_pos = p | append: 'position'
        assign pos = settings[k_pos] | plus: 0 | floor
        if pos < 1 or pos > 9998
          assign pos = 9999
        endif
        assign pos_key = pos | prepend: '0000' | slice: -4, 4
        assign n_key = n | prepend: '00' | slice: -2, 2
        assign order_keys = order_keys | append: pos_key | append: '-' | append: n_key | append: ','
      endif
    endfor
  else
    assign item_max = section.blocks.size
    assign total_count = item_max
    assign empty_note = 'Add a review in the theme editor'
    for n in (1..item_max)
      assign n_key = n | prepend: '00' | slice: -2, 2
      assign order_keys = order_keys | append: '9999-' | append: n_key | append: ','
    endfor
  endif
  assign card_order = order_keys | split: ',' | sort
-%}

{%- if total_count > 0 or request.design_mode -%}
<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-results color-{{ section.settings.color_scheme }} gradient{% if section.settings.pause_on_hover %} zenith-results--pause{% endif %}{% if section.index > 2 %} zenith-defer{% endif %}"
>
  {%- if section.settings.eyebrow != blank or heading != blank or section.settings.subheading != blank -%}
    <div class="page-width">
      <div class="zenith-heading zenith-heading--{{ section.settings.heading_alignment }} zenith-heading--m-{{ section.settings.heading_alignment_mobile }}{% if section.settings.heading_uppercase %} zenith-heading--uppercase{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="zenith-eyebrow">
            {{- section.settings.eyebrow | escape | replace: '[customers]', settings.customer_count -}}
          </p>
        {%- endif -%}
        {%- if heading_mobile != blank -%}
          <h2 class="zenith-heading__title zenith-hide-mobile">{{ heading }}</h2>
          <h2 class="zenith-heading__title zenith-hide-desktop">{{ heading_mobile }}</h2>
        {%- elsif heading != blank -%}
          <h2 class="zenith-heading__title">{{ heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="zenith-subheading">
            {{- section.settings.subheading | replace: '[customers]', settings.customer_count -}}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="zenith-results__rows">
    {%- for r in (1..row_count) -%}
      {%- liquid
        assign row_key = r | append: ''
        assign item_count = 0
        assign row_cards = ''
      -%}
      {%- for order_key in card_order -%}
        {%- liquid
          if order_key == blank
            continue
          endif
          assign n = order_key | split: '-' | last | plus: 0
          if use_global
            assign p = 'rv' | append: n | append: '_'
            assign k = p | append: 'image'
            assign c_photo = settings[k]
            assign k = p | append: 'quote'
            assign c_quote = settings[k]
            assign k = p | append: 'author'
            assign c_author = settings[k]
            if c_photo == blank and c_quote == blank and c_author == blank
              continue
            endif
            assign k = p | append: 'row'
            assign c_row = settings[k]
            assign k = p | append: 'product'
            assign c_product = settings[k]
            assign k = p | append: 'thumb'
            assign c_thumb = settings[k]
            assign k = p | append: 'rating'
            assign c_rating = settings[k]
            assign k = p | append: 'verified'
            assign c_verified = settings[k]
            assign k = p | append: 'avatar'
            assign c_avatar = settings[k]
            assign k = p | append: 'detail'
            assign c_detail = settings[k]
            assign k = p | append: 'card_type'
            assign c_card_type = settings[k]
            assign k = p | append: 'show_prefix'
            assign c_show_prefix = settings[k]
            assign k = p | append: 'show_product'
            assign c_show_product = settings[k]
            assign k = p | append: 'show_detail_product'
            assign c_show_detail_product = settings[k]
            assign c_attrs = ''
          else
            assign block_index = n | minus: 1
            assign block = section.blocks[block_index]
            assign c_card_type = block.settings.card_type
            assign c_show_prefix = block.settings.show_prefix
            assign c_show_product = block.settings.show_product
            assign c_show_detail_product = block.settings.show_detail_product
            assign c_photo = block.settings.image
            assign c_quote = block.settings.quote
            assign c_author = block.settings.author
            assign c_row = block.settings.row
            assign c_product = block.settings.product
            assign c_thumb = block.settings.thumbnail
            assign c_rating = block.settings.rating
            assign c_verified = block.settings.verified
            assign c_avatar = block.settings.avatar
            assign c_detail = block.settings.author_detail
            assign c_attrs = 'id="Block-' | append: block.id | append: '" ' | append: block.shopify_attributes
          endif
          unless row_count == 1 or c_row == row_key
            continue
          endunless
          assign item_count = item_count | plus: 1
        -%}
        {%- capture row_cards -%}
          {{- row_cards -}}
          {%- render 'zenith-results-card',
            photo: c_photo,
            review_product: c_product,
            thumbnail: c_thumb,
            rating: c_rating,
            quote: c_quote,
            author: c_author,
            verified: c_verified,
            avatar: c_avatar,
            author_detail: c_detail,
            card_type: c_card_type,
            show_prefix: c_show_prefix,
            show_product: c_show_product,
            show_detail_product: c_show_detail_product,
            show_avatar: section.settings.show_avatar,
            attrs: c_attrs,
            clone: false,
            prefix: prefix,
            verified_label: verified_label,
            photo_sizes: photo_sizes,
            overlay_style: section.settings.overlay_style
          -%}
        {%- endcapture -%}
      {%- endfor -%}
      {%- liquid
        if item_count == 0 and request.design_mode == false
          continue
        endif
        assign reverse = false
        if r == 2 and section.settings.alternate_direction
          assign reverse = true
        endif
      -%}
      {%- comment -%} One pass of cards; zenith-results-marquee.js clones it near the viewport and only then starts the loop (.is-ready) {%- endcomment -%}
      <div class="zenith-results__row{% if reverse %} zenith-results__row--reverse{% endif %}">
        <div class="zenith-results__track">
          <ul class="zenith-results__group" role="list">
            {%- if item_count > 0 -%}
              {{ row_cards }}
            {%- else -%}
              {%- for i in (1..4) -%}
                <li class="zenith-results__card">
                  <div class="zenith-media zenith-results__media">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
                  </div>
                  <figure class="zenith-results__review">
                    <div class="zenith-results__body">
                      <blockquote class="zenith-results__quote">{{ empty_note }}</blockquote>
                    </div>
                  </figure>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="page-width zenith-results__footer">
    {%- comment -%} Pause/play for the moving rows (WCAG 2.2.2); shown by the JS once the loop runs {%- endcomment -%}
    {%- render 'zenith-pause-button', class: 'zenith-results__pause', label: 'Pause reviews' -%}
    {%- if section.settings.disclaimer != blank -%}
      <p class="zenith-results__disclaimer">
        {{- section.settings.disclaimer | escape | replace: '[customers]', settings.customer_count -}}
      </p>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a
        {% if section.settings.link != blank %}
          href="{{ section.settings.link | escape }}"
        {% else %}
          role="link" aria-disabled="true"
        {% endif %}
        class="link underlined-link zenith-results__link"
      >
        {{- section.settings.link_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Results marquee",
  "tag": "div",
  "class": "section",
  "max_blocks": 40,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "Reviews",
      "info": "Global = the reviews in Theme settings → Zenith · Results reviews (edit once, same on every page). This section's reviews = the Review blocks below.",
      "default": "global",
      "options": [
        {
          "value": "global",
          "label": "Global (Theme settings)"
        },
        {
          "value": "custom",
          "label": "This section's reviews"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "[customers] shows the customer count from Theme settings → Zenith",
      "default": "Used by [customers] Filipino men"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Men. Real Results."
    },
    {
      "type": "textarea",
      "id": "heading_mobile",
      "label": "Mobile heading",
      "info": "Leave blank to use the heading above. Line breaks are kept.",
      "default": "Built for Filipino men over 35"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>See the difference a proper regimen makes.</p><p>From clearer skin to thicker hair, every transformation here comes from verified Zenith customers putting in the consistent work.</p>"
    },
    {
      "type": "text",
      "id": "product_prefix",
      "label": "Word before the product name",
      "info": "Shown on the photo above the product's name when a review has a product",
      "default": "Used"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified badge text",
      "info": "Read by screen readers and shown when hovering the badge",
      "default": "Verified buyer"
    },
    {
      "type": "checkbox",
      "id": "show_avatar",
      "label": "Show reviewer photo next to the name",
      "default": false
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Individual results may vary.*"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "Optional link below the disclaimer"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "rows",
      "label": "Rows",
      "default": "2",
      "info": "With 2 rows, pick each review's row in its block settings",
      "options": [
        {
          "value": "1",
          "label": "1 row"
        },
        {
          "value": "2",
          "label": "2 rows"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "info": "Photo and review together",
      "min": 320,
      "max": 720,
      "step": 10,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height",
      "info": "Cards grow taller when a review needs more room",
      "min": 160,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Photo width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "quote_lines",
      "label": "Max review lines",
      "info": "Longer reviews end with …",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration",
      "info": "Seconds for one full loop. Higher is slower.",
      "min": 10,
      "max": 240,
      "step": 5,
      "unit": "s",
      "default": 120
    },
    {
      "type": "range",
      "id": "speed_mobile",
      "label": "Scroll duration on mobile",
      "info": "Seconds for one full loop on phones. Higher is slower.",
      "min": 10,
      "max": 400,
      "step": 10,
      "unit": "s",
      "default": 240
    },
    {
      "type": "checkbox",
      "id": "alternate_direction",
      "label": "Scroll second row in reverse",
      "visible_if": "{{ section.settings.rows == '2' }}",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space between heading lines",
      "info": "Gap between eyebrow, heading and subheading",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Photo caption padding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "review_padding",
      "label": "Review padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "thumb_size",
      "label": "Product thumbnail size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "thumb_radius",
      "label": "Product thumbnail corners",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Reviewer photo size",
      "visible_if": "{{ section.settings.show_avatar }}",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "disclaimer_spacing",
      "label": "Space above disclaimer",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "review_bg_color",
      "label": "Review background",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Review text",
      "default": "#BCBCBC"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Reviewer name",
      "default": "#BCBCBC"
    },
    {
      "type": "color",
      "id": "detail_color",
      "label": "Text under the name",
      "default": "#B8B8B8"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars",
      "default": "#C5930E"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Verified badge",
      "default": "#C5930E"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Photo overlay",
      "default": "bottom",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "bottom",
          "label": "Gradient from bottom"
        },
        {
          "value": "top",
          "label": "Gradient from top"
        },
        {
          "value": "left",
          "label": "Gradient from left"
        },
        {
          "value": "right",
          "label": "Gradient from right"
        }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "visible_if": "{{ section.settings.overlay_style != 'none' }}",
      "default": "#294850"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "visible_if": "{{ section.settings.overlay_style != 'none' }}",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Gradient length",
      "visible_if": "{{ section.settings.overlay_style != 'none' and section.settings.overlay_style != 'solid' }}",
      "info": "How far the gradient reaches across the photo",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Photo caption color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "thumb_bg_color",
      "label": "Thumbnail background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "disclaimer_color",
      "label": "Disclaimer color",
      "default": "#A88946"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
