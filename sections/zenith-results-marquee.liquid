{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-results-marquee.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  --z-card-w: {{ section.settings.card_width }}px;
  --z-card-w-m: {{ section.settings.mobile_card_width }}px;
  --z-card-h: {{ section.settings.card_height }}px;
  --z-card-h-m: {{ section.settings.card_height_mobile }}px;
  --z-speed: {{ section.settings.speed }}s;
  --z-hgap: {{ section.settings.heading_gap }}px;
  --z-hgap-m: {{ section.settings.heading_gap_mobile }}px;
  --z-thumb: {{ section.settings.thumb_size }}px;
  --z-thumb-m: {{ section.settings.thumb_size_mobile }}px;
  --z-thumb-r: {{ section.settings.thumb_radius }}px;
  --z-rv-pad: {{ section.settings.review_padding }}px;
  --z-rv-pad-m: {{ section.settings.review_padding_mobile }}px;
  --z-rv-lines: {{ section.settings.quote_lines }};
  --z-star: {{ section.settings.star_size }}px;
  --z-star-m: {{ section.settings.star_size_mobile }}px;
  --z-avatar: {{ section.settings.avatar_size }}px;
  --z-avatar-m: {{ section.settings.avatar_size_mobile }}px;
  --z-qfs: {{ section.settings.quote_font_size }}px;
  --z-qfs-m: {{ section.settings.quote_font_size_mobile }}px;
  --z-nfs: {{ section.settings.name_font_size }}px;
  --z-nfs-m: {{ section.settings.name_font_size_mobile }}px;
  --z-dfs: {{ section.settings.detail_font_size }}px;
  --z-dfs-m: {{ section.settings.detail_font_size_mobile }}px;
  --z-caption-color: {{ section.settings.caption_color }};
  --z-thumb-bg: {{ section.settings.thumb_bg_color }};
  --z-rv-bg: {{ section.settings.review_bg_color }};
  --z-rv-quote: {{ section.settings.quote_color }};
  --z-rv-name: {{ section.settings.name_color }};
  --z-rv-detail: {{ section.settings.detail_color }};
  --z-rv-star: {{ section.settings.star_color }};
  --z-rv-badge: {{ section.settings.badge_color }};
  --z-disc-color: {{ section.settings.disclaimer_color }};
  --z-disc-fs: {{ section.settings.disclaimer_font_size }}px;
  --z-disc-fs-m: {{ section.settings.disclaimer_font_size_mobile }}px;
  --z-disc-sp: {{ section.settings.disclaimer_spacing }}px;
  --z-disc-sp-m: {{ section.settings.disclaimer_spacing_mobile }}px;
  {%- render 'zenith-overlay-vars', settings: section.settings -%}
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- liquid
  assign row_count = section.settings.rows | plus: 0
  assign heading = section.settings.heading | escape | replace: '[customers]', settings.customer_count
  assign heading_mobile = section.settings.heading_mobile | escape | replace: '[customers]', settings.customer_count | newline_to_br
  assign prefix = section.settings.product_prefix | escape
  assign verified_label = section.settings.verified_label | escape
  assign photo_w = section.settings.card_width | times: section.settings.media_width | divided_by: 100
  assign photo_w_m = section.settings.mobile_card_width | times: section.settings.media_width_mobile | divided_by: 100
  assign photo_sizes = '(min-width: 750px) ' | append: photo_w | append: 'px, ' | append: photo_w_m | append: 'px'
-%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-results color-{{ section.settings.color_scheme }} gradient{% if section.settings.pause_on_hover %} zenith-results--pause{% endif %}"
>
  {%- if section.settings.eyebrow != blank or heading != blank or section.settings.subheading != blank -%}
    <div class="page-width">
      <div class="zenith-heading zenith-heading--{{ section.settings.heading_alignment }} zenith-heading--m-{{ section.settings.heading_alignment_mobile }}{% if section.settings.heading_uppercase %} zenith-heading--uppercase{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="zenith-eyebrow">
            {{- section.settings.eyebrow | escape | replace: '[customers]', settings.customer_count -}}
          </p>
        {%- endif -%}
        {%- if heading_mobile != blank -%}
          <h2 class="zenith-heading__title zenith-hide-mobile">{{ heading }}</h2>
          <h2 class="zenith-heading__title zenith-hide-desktop">{{ heading_mobile }}</h2>
        {%- elsif heading != blank -%}
          <h2 class="zenith-heading__title">{{ heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="zenith-subheading">
            {{- section.settings.subheading | replace: '[customers]', settings.customer_count -}}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="zenith-results__rows">
    {%- for r in (1..row_count) -%}
      {%- liquid
        assign row_key = r | append: ''
        assign item_count = 0
        for block in section.blocks
          if row_count == 1 or block.settings.row == row_key
            assign item_count = item_count | plus: 1
          endif
        endfor
        assign reverse = false
        if r == 2 and section.settings.alternate_direction
          assign reverse = true
        endif
      -%}
      <div class="zenith-results__row{% if reverse %} zenith-results__row--reverse{% endif %}">
        <div class="zenith-results__track">
          {%- for pass in (1..4) -%}
            <ul
              class="zenith-results__group"
              role="list"
              {% if pass > 1 %}
                aria-hidden="true"
              {% endif %}
            >
              {%- if item_count > 0 -%}
                {%- for block in section.blocks -%}
                  {%- unless row_count == 1 or block.settings.row == row_key -%}{%- continue -%}{%- endunless -%}
                  {%- liquid
                    assign photo = block.settings.image
                    assign result_product = block.settings.product
                    assign thumb = block.settings.thumbnail
                    if thumb == blank and result_product != blank
                      assign thumb = result_product.featured_image
                    endif
                    assign author = block.settings.author | escape
                    assign photo_alt = photo.alt | default: block.settings.author | escape
                    assign rating = block.settings.rating | plus: 0
                    assign detail = block.settings.author_detail | default: result_product.title | escape
                    assign avatar = block.settings.avatar | default: photo

                    assign quote = block.settings.quote | strip
                    assign quote_text = quote | escape | newline_to_br
                    assign q_first = quote | slice: 0
                    if quote != blank and q_first != '"' and q_first != '“'
                      assign quote_text = '“' | append: quote_text | append: '”'
                    endif
                  -%}
                  <li
                    class="zenith-results__card"
                    {% if pass == 1 %}
                      id="Block-{{ block.id }}" {{ block.shopify_attributes }}
                    {% endif %}
                  >
                    <div class="zenith-media zenith-results__media">
                      {%- if photo != blank -%}
                        {{
                          photo
                          | image_url: width: 720
                          | image_tag:
                            loading: 'lazy',
                            widths: '180, 240, 360, 480, 720',
                            sizes: photo_sizes,
                            alt: photo_alt
                        }}
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                      {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
                      {%- if result_product != blank -%}
                        <a
                          href="{{ result_product.url }}"
                          class="zenith-results__meta"
                          {% if pass > 1 %}
                            tabindex="-1"
                          {% endif %}
                        >
                          {%- if thumb != blank -%}
                            <span class="zenith-results__thumb">
                              {{
                                thumb
                                | image_url: width: 160
                                | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '40px', alt: ''
                              }}
                            </span>
                          {%- endif -%}
                          <span class="zenith-results__used">
                            {%- if prefix != blank -%}
                              <span>{{ prefix }}</span>
                            {%- endif -%}
                            <span class="zenith-results__product">{{ result_product.title | escape }}</span>
                          </span>
                        </a>
                      {%- endif -%}
                    </div>

                    <figure class="zenith-results__review">
                      <div class="zenith-results__body">
                        {%- if rating > 0 -%}
                          <div class="zenith-results__stars" role="img" aria-label="{{ rating }} out of 5 stars">
                            {%- for i in (1..5) -%}
                              <span class="zenith-results__star{% if i > rating %} zenith-results__star--off{% endif %}">
                                {%- render 'zenith-icon', icon: 'star' -%}
                              </span>
                            {%- endfor -%}
                          </div>
                        {%- endif -%}
                        {%- if quote != blank -%}
                          <blockquote class="zenith-results__quote">{{ quote_text }}</blockquote>
                        {%- endif -%}
                      </div>
                      {%- if author != blank or detail != blank -%}
                        <figcaption class="zenith-results__author">
                          {%- if avatar != blank -%}
                            <span class="zenith-results__avatar">
                              {{
                                avatar
                                | image_url: width: 128
                                | image_tag: loading: 'lazy', widths: '48, 64, 96, 128', sizes: '40px', alt: ''
                              }}
                            </span>
                          {%- elsif author != blank -%}
                            <span class="zenith-results__avatar zenith-results__avatar--initial" aria-hidden="true">
                              {{- author | slice: 0 | upcase -}}
                            </span>
                          {%- endif -%}
                          {%- if author != blank -%}
                            <span class="zenith-results__name">
                              <span>{{ author }}</span>
                              {%- if block.settings.verified -%}
                                <span class="zenith-results__badge" title="{{ verified_label }}">
                                  {%- render 'zenith-icon', icon: 'verified_seal' -%}
                                  <span class="visually-hidden">{{ verified_label }}</span>
                                </span>
                              {%- endif -%}
                            </span>
                          {%- endif -%}
                          {%- if detail != blank -%}
                            <span class="zenith-results__detail">{{ detail }}</span>
                          {%- endif -%}
                        </figcaption>
                      {%- endif -%}
                    </figure>
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..4) -%}
                  <li class="zenith-results__card">
                    <div class="zenith-media zenith-results__media">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- render 'zenith-overlay', style: section.settings.overlay_style -%}
                    </div>
                    <figure class="zenith-results__review">
                      <div class="zenith-results__body">
                        <blockquote class="zenith-results__quote">Add a review in the theme editor</blockquote>
                      </div>
                    </figure>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.disclaimer != blank or section.settings.link_label != blank -%}
    <div class="page-width zenith-results__footer">
      {%- if section.settings.disclaimer != blank -%}
        <p class="zenith-results__disclaimer">
          {{- section.settings.disclaimer | escape | replace: '[customers]', settings.customer_count -}}
        </p>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a
          {% if section.settings.link != blank %}
            href="{{ section.settings.link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="link underlined-link zenith-results__link"
        >
          {{- section.settings.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>
{%- endcapture -%}
{{- zenith_body | replace: '[customers]', settings.customer_count -}}

{% schema %}
{
  "name": "Zenith · Results marquee",
  "tag": "div",
  "class": "section",
  "max_blocks": 40,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "[customers] shows the customer count from Theme settings → Zenith",
      "default": "Used by [customers] Filipino men"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Men. Real Results."
    },
    {
      "type": "textarea",
      "id": "heading_mobile",
      "label": "Mobile heading",
      "info": "Leave blank to use the heading above. Line breaks are kept.",
      "default": "Built for Filipino men over 35"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>See the difference a proper regimen makes.</p><p>From clearer skin to thicker hair, every transformation here comes from verified Zenith customers putting in the consistent work.</p>"
    },
    {
      "type": "text",
      "id": "product_prefix",
      "label": "Word before the product name",
      "info": "Shown on the photo above the product's name when a review has a product",
      "default": "Used"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified badge text",
      "info": "Read by screen readers and shown when hovering the badge",
      "default": "Verified buyer"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Individual results may vary.*"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "Optional link below the disclaimer"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "rows",
      "label": "Rows",
      "default": "2",
      "info": "With 2 rows, pick each review's row in its block settings",
      "options": [
        {
          "value": "1",
          "label": "1 row"
        },
        {
          "value": "2",
          "label": "2 rows"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "info": "Photo and review together",
      "min": 320,
      "max": 720,
      "step": 10,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height",
      "info": "Cards grow taller when a review needs more room",
      "min": 160,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Photo width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "quote_lines",
      "label": "Max review lines",
      "info": "Longer reviews end with …",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration",
      "info": "Seconds for one full loop. Higher is slower.",
      "min": 10,
      "max": 240,
      "step": 5,
      "unit": "s",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "alternate_direction",
      "label": "Scroll second row in reverse",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space between heading lines",
      "info": "Gap between eyebrow, heading and subheading",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Photo caption padding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "review_padding",
      "label": "Review padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "thumb_size",
      "label": "Product thumbnail size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "thumb_radius",
      "label": "Product thumbnail corners",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Reviewer photo size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "disclaimer_spacing",
      "label": "Space above disclaimer",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "review_bg_color",
      "label": "Review background",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Review text",
      "default": "#BCBCBC"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Reviewer name",
      "default": "#BCBCBC"
    },
    {
      "type": "color",
      "id": "detail_color",
      "label": "Text under the name",
      "default": "#B8B8B8"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars",
      "default": "#C5930E"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Verified badge",
      "default": "#C5930E"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Photo overlay",
      "default": "bottom",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "bottom",
          "label": "Gradient from bottom"
        },
        {
          "value": "top",
          "label": "Gradient from top"
        },
        {
          "value": "left",
          "label": "Gradient from left"
        },
        {
          "value": "right",
          "label": "Gradient from right"
        }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#294850"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Gradient length",
      "info": "How far the gradient reaches across the photo",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Photo caption color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "thumb_bg_color",
      "label": "Thumbnail background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "disclaimer_color",
      "label": "Disclaimer color",
      "default": "#A88946"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Photo caption size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "quote_font_size",
      "label": "Review text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "name_font_size",
      "label": "Reviewer name size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "detail_font_size",
      "label": "Text under the name size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "disclaimer_font_size",
      "label": "Disclaimer size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "heading_alignment_mobile",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
