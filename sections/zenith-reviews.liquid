{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{%- comment -%}
  Hosts the Judge.me app block. Storefront: renders nothing until an app block is added.
  Theme editor: shows a styled preview so the empty section looks intentional.
{%- endcomment -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
{{ 'zenith-reviews.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign card_border = section.settings.card_border_color
  if card_border == blank
    assign card_border = section.settings.card_color
  endif
-%}
{%- capture extra -%}
  --z-cols: {{ section.settings.columns_desktop }};
  --z-cols-m: {{ section.settings.columns_mobile }};
  --z-radius: {{ section.settings.card_radius }}px;
  --z-sub-a: {{ section.settings.subheading_opacity | divided_by: 100.0 }};
  --z-sub-a-m: {{ section.settings.subheading_opacity_mobile | divided_by: 100.0 }};
  --z-sub-sp: {{ section.settings.subheading_spacing }}px;
  --z-jdgm-card: {{ section.settings.card_color }};
  --z-jdgm-card-border: {{ card_border }};
  --z-jdgm-star: {{ section.settings.star_color }};
  --z-jdgm-accent: {{ section.settings.accent_color }};
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- liquid
  assign subheading = section.settings.subheading
  if section.settings.subheading_mobile != blank
    capture subheading
      if section.settings.subheading != blank
        echo '<div class="zenith-hide-mobile">' | append: section.settings.subheading | append: '</div>'
      endif
      echo '<div class="zenith-hide-desktop">' | append: section.settings.subheading_mobile | append: '</div>'
    endcapture
  endif

  assign modifiers = ''
  if section.settings.jdgm_masonry
    assign modifiers = modifiers | append: ' zenith-reviews--masonry'
  endif
  if section.settings.button_style != 'scheme'
    assign modifiers = modifiers | append: ' zenith-reviews--brand-btn zenith-reviews--btn-' | append: section.settings.button_style
  endif
-%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-reviews zenith-reviews--jdgm{{ modifiers }} color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      heading_mobile: section.settings.heading_mobile,
      subheading: subheading,
      alignment: section.settings.heading_alignment,
      uppercase: section.settings.heading_uppercase
    -%}

    {%- if section.blocks.size > 0 -%}
      <div class="zenith-reviews__apps">
        {%- for block in section.blocks -%}
          <div id="Block-{{ block.id }}" class="zenith-reviews__app" {{ block.shopify_attributes }}>
            {%- render block -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%} Editor-only preview of the card style the Judge.me widget will get. {%- endcomment -%}
      <div class="zenith-reviews__empty">
        <p class="zenith-reviews__empty-note">
          Add the Judge.me reviews widget: Add block → Apps → Judge.me. This preview is only visible in the theme editor.
        </p>
        <div class="zenith-reviews__skeleton" aria-hidden="true">
          {%- for i in (1..8) -%}
            {%- liquid
              assign mod = i | modulo: 4
              assign has_photo = false
              if mod == 1 or mod == 0
                assign has_photo = true
              endif
            -%}
            <div class="zenith-reviews__skeleton-card">
              {%- if has_photo -%}
                <span class="zenith-reviews__skeleton-photo"></span>
              {%- endif -%}
              <div class="zenith-reviews__skeleton-stars">
                {%- for s in (1..5) -%}
                  {%- render 'zenith-icon', icon: 'star' -%}
                {%- endfor -%}
              </div>
              <span class="zenith-reviews__skeleton-line"></span>
              <span class="zenith-reviews__skeleton-line"></span>
              <span class="zenith-reviews__skeleton-line zenith-reviews__skeleton-line--short"></span>
              <div class="zenith-reviews__skeleton-author">
                <span class="zenith-reviews__skeleton-avatar"></span>
                <span class="zenith-reviews__skeleton-meta">
                  <span class="zenith-reviews__skeleton-line zenith-reviews__skeleton-line--name"></span>
                  <span class="zenith-reviews__skeleton-line zenith-reviews__skeleton-line--meta"></span>
                </span>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{%- endcapture -%}
{%- render 'zenith-tokens', body: zenith_body -%}

{% schema %}
{
  "name": "Zenith · Reviews",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "paragraph",
      "content": "Add the Judge.me reviews widget with \"Add block\" → Apps. Until an app block is added the section is hidden on the storefront and shows a preview in the editor."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "[customers] Filipino Men Trust Zenith Products",
      "info": "[customers] = Theme settings → Zenith → Customer count"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Men in Manila using the cream. Unedited and verified.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "label": "Space between heading and subheading",
      "info": "Desktop. Mobile uses 12px.",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "jdgm_masonry",
      "label": "Masonry review cards",
      "info": "Lays Judge.me review cards out in columns (overrides the app's own card layout). Turn off to use the app layout.",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "visible_if": "{{ section.settings.jdgm_masonry }}",
      "label": "Columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "visible_if": "{{ section.settings.jdgm_masonry }}",
      "label": "Card spacing",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Card padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "info": "Review cards keep 16px corners while Theme settings → Zenith → Dark Judge.me review style is on.",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "paragraph",
      "content": "While Theme settings → Zenith → Dark Judge.me review style is on, that style sets the review cards' background and border, the stars inside the widget and the buttons' colors. Turn it off to use the card, border, star and button settings below."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Review card background",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Review card border",
      "info": "Leave empty for no border"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Judge.me button style",
      "info": "\"Write a review\" and review form buttons",
      "default": "outline",
      "options": [
        {
          "value": "gold",
          "label": "Gold"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "scheme",
          "label": "App default"
        }
      ]
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars and page numbers",
      "default": "#D6B356"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Rating bars, badges and button border",
      "default": "#C59300"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "subheading_opacity",
      "label": "Subheading opacity",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Review text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Review star size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_font_size",
      "visible_if": "{{ section.settings.button_style != 'scheme' }}",
      "label": "Button text size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "text",
      "id": "heading_mobile",
      "label": "Heading",
      "info": "Leave empty to use the desktop heading. [customers] = Theme settings → Zenith → Customer count."
    },
    {
      "type": "richtext",
      "id": "subheading_mobile",
      "label": "Subheading",
      "info": "Leave empty to use the desktop subheading"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_opacity_mobile",
      "label": "Subheading opacity",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "heading_spacing_mobile",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "visible_if": "{{ section.settings.jdgm_masonry }}",
      "label": "Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "visible_if": "{{ section.settings.jdgm_masonry }}",
      "label": "Card spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "label": "Card padding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Review text size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "visible_if": "{{ section.settings.button_style != 'scheme' }}",
      "label": "Button text size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Zenith · Reviews"
    }
  ]
}
{% endschema %}
