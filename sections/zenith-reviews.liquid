{{ 'zenith-reviews.css' | asset_url | stylesheet_tag }}
{%- render 'zenith-section-style', section: section -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-reviews color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      size: section.settings.heading_size
    -%}

    {%- if section.blocks.size > 0 -%}
      <div class="zenith-reviews__apps">
        {%- for block in section.blocks -%}
          <div id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
            {%- render block -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="zenith-reviews__placeholder">
        {%- if section.settings.image != blank -%}
          {%- assign desktop_class = '' -%}
          {%- if section.settings.mobile_image != blank -%}
            {%- assign desktop_class = 'zenith-hide-mobile' -%}
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400', sizes: '(min-width: 1400px) 1400px, 100vw', class: desktop_class
          }}
          {%- if section.settings.mobile_image != blank -%}
            {{
              section.settings.mobile_image
              | image_url: width: 1500
              | image_tag: loading: 'lazy', widths: '375, 750, 1100, 1500', sizes: '100vw', class: 'zenith-hide-desktop'
            }}
          {%- endif -%}
        {%- else -%}
          <div class="zenith-media zenith-reviews__placeholder-media">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Zenith · Reviews",
  "tag": "div",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "paragraph", "content": "Add the Judge.me widget with \"Add block\". Until then the image below is shown." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "100,000+ Filipino Men Trust Zenith Products" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Real men using the cream. Unedited and verified.</p>" },
    { "type": "image_picker", "id": "image", "label": "Placeholder image", "info": "Shown when no app block is added" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile placeholder image", "info": "Optional" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },

    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },

    { "type": "header", "content": "Typography" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "lg",
      "options": [ { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }, { "value": "xl", "label": "Extra large" } ]
    },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [ { "type": "@app" } ],
  "presets": [ { "name": "Zenith · Reviews" } ]
}
{% endschema %}
