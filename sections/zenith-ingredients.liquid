{%- comment -%} zenith: [customers] anywhere in this section shows Theme settings → Zenith → Customer count {%- endcomment -%}
{%- capture zenith_body -%}
{{ 'zenith-faq.css' | asset_url | stylesheet_tag }}
{{ 'zenith-ingredients.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zenith-faq.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign media_ratio = '1 / 1'
  case section.settings.media_ratio_mobile
    when 'portrait'
      assign media_ratio = '4 / 5'
    when 'landscape'
      assign media_ratio = '3 / 2'
    when 'wide'
      assign media_ratio = '16 / 9'
  endcase
-%}
{%- capture extra -%}
  --z-ing-card: {{ section.settings.card_background }};
  --z-ing-sub: {{ section.settings.subheading_opacity | divided_by: 100.0 }};
  --z-ing-sub-m: {{ section.settings.subheading_opacity_mobile | divided_by: 100.0 }};
  --z-ing-thumb: {{ section.settings.thumb_size }}px;
  --z-ing-thumb-m: {{ section.settings.thumb_size_mobile }}px;
  --z-ing-thumb-gap: {{ section.settings.thumb_gap }}px;
  --z-ing-atop: {{ section.settings.answer_spacing }}px;
  --z-ing-atop-m: {{ section.settings.answer_spacing_mobile }}px;
  --z-ing-lpad: {{ section.settings.list_padding }}px;
  --z-ing-lpad-m: {{ section.settings.list_padding_mobile }}px;
  --z-ing-lgap: {{ section.settings.list_content_gap }}px;
  --z-ing-lgap-m: {{ section.settings.list_content_gap_mobile }}px;
  --z-ing-ltfs: {{ section.settings.list_title_font_size }}px;
  --z-ing-ltfs-m: {{ section.settings.list_title_font_size_mobile }}px;
  --z-ing-lbfs: {{ section.settings.list_text_font_size }}px;
  --z-ing-lbfs-m: {{ section.settings.list_text_font_size_mobile }}px;
  --z-ing-cardgap: {{ section.settings.card_gap }}px;
  --z-ing-cardgap-m: {{ section.settings.card_gap_mobile }}px;
  --z-ing-ar-m: {{ media_ratio }};
  --z-faq-icon: {{ section.settings.icon_color }};
  --z-faq-ans: {{ section.settings.text_opacity | divided_by: 100.0 }};
  --z-faq-div: {{ section.settings.divider_opacity | divided_by: 100.0 }};
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<section
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-ingredients zenith-ingredients--m-{{ section.settings.heading_alignment_mobile }} zenith-ingredients--media-{{ section.settings.image_position }}{% if section.settings.image_first_mobile %} zenith-ingredients--m-media-first{% endif %} color-{{ section.settings.color_scheme }} gradient{% if section.index > 2 %} zenith-defer{% endif %}"
>
  <div class="page-width">
    {%- render 'zenith-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      alignment: section.settings.heading_alignment,
      uppercase: section.settings.heading_uppercase
    -%}

    <div class="zenith-ingredients__grid">
      <div class="zenith-ingredients__col">
        {%- if section.blocks.size > 0 -%}
          <div class="zenith-ingredients__card">
            {%- for block in section.blocks -%}
              <details
                class="zenith-faq__item zenith-ingredients__item"
                id="Block-{{ block.id }}-{{ section.id }}"
                {% if forloop.first and section.settings.open_first %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="zenith-faq__question zenith-ingredients__summary">
                  <span class="zenith-ingredients__lead">
                    <span class="zenith-ingredients__thumb zenith-media">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 240
                          | image_tag:
                            loading: 'lazy',
                            widths: '60, 104, 160, 240',
                            sizes: '60px',
                            alt: block.settings.image.alt
                        }}
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </span>
                    <span class="zenith-ingredients__title">
                      {%- if block.settings.title_mobile != blank -%}
                        <span class="zenith-hide-mobile">{{ block.settings.title | escape }}</span>
                        <span class="zenith-hide-desktop">{{ block.settings.title_mobile | escape }}</span>
                      {%- else -%}
                        {{- block.settings.title | escape -}}
                      {%- endif -%}
                    </span>
                  </span>
                  <span class="zenith-faq__icon zenith-ingredients__icon" aria-hidden="true">
                    {%- render 'zenith-icon', icon: 'plus' -%}
                  </span>
                </summary>
                <div class="zenith-faq__answer zenith-ingredients__answer zenith-rte">
                  {%- if block.settings.text_mobile != blank -%}
                    <div class="zenith-hide-mobile">{{ block.settings.text }}</div>
                    <div class="zenith-hide-desktop">{{ block.settings.text_mobile }}</div>
                  {%- else -%}
                    {{- block.settings.text -}}
                  {%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_list and section.settings.list_title != blank -%}
          <div class="zenith-ingredients__card zenith-ingredients__card--list">
            <details class="zenith-faq__item zenith-ingredients__item zenith-ingredients__item--list" id="IngredientList-{{ section.id }}">
              <summary class="zenith-faq__question zenith-ingredients__summary zenith-ingredients__summary--list">
                <span class="zenith-ingredients__title zenith-ingredients__title--list">
                  {{- section.settings.list_title | escape -}}
                </span>
                <span class="zenith-faq__icon zenith-ingredients__icon" aria-hidden="true">
                  {%- render 'zenith-icon', icon: 'plus' -%}
                </span>
              </summary>
              <div class="zenith-faq__answer zenith-ingredients__answer zenith-ingredients__answer--list zenith-rte">
                {{ section.settings.list_text }}
              </div>
            </details>
          </div>
        {%- endif -%}
      </div>

      <div class="zenith-ingredients__col zenith-ingredients__col--media">
        <div class="zenith-ingredients__media zenith-media">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1400',
                sizes: '(min-width: 990px) 48vw, (min-width: 750px) 48vw, 100vw',
                alt: section.settings.image.alt
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
{%- endcapture -%}
{{- zenith_body | replace: '[customers]', settings.customer_count -}}

