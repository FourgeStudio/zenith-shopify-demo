{{ 'zenith-logo-strip.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  --z-logo-h: {{ section.settings.logo_height }}px;
  --z-logo-h-m: {{ section.settings.logo_height_mobile }}px;
  --z-logo-opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
  --z-label-opacity: {{ section.settings.heading_opacity | divided_by: 100.0 }};
  --z-speed: {{ section.settings.speed }}s;
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

{%- liquid
  assign desktop_marquee = false
  if section.settings.layout == 'marquee'
    assign desktop_marquee = true
  endif
  assign mobile_marquee = false
  if section.settings.mobile_layout == 'marquee'
    assign mobile_marquee = true
  endif
  assign passes = 1
  if desktop_marquee or mobile_marquee
    assign passes = 4
  endif
-%}

<div
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-logos color-{{ section.settings.color_scheme }} gradient zenith-logos--{{ section.settings.logo_style }} zenith-logos--d-{{ section.settings.layout }} zenith-logos--m-{{ section.settings.mobile_layout }} zenith-logos--align-{{ section.settings.logo_align }}{% if section.settings.heading_uppercase %} zenith-logos--upper{% endif %}"
>
  {%- if section.settings.heading != blank -%}
    <div class="page-width">
      <p class="zenith-logos__heading">{{ section.settings.heading | escape }}</p>
    </div>
  {%- endif -%}

  <div class="zenith-logos__viewport">
    <div class="zenith-logos__track">
      {%- for pass in (1..passes) -%}
        <ul
          class="zenith-logos__list{% if pass > 1 %} zenith-logos__list--copy{% endif %}"
          role="list"
          {% if pass > 1 %}
            aria-hidden="true"
          {% endif %}
        >
          {%- for block in section.blocks -%}
            <li
              class="zenith-logos__item"
              style="--z-logo-scale: {{ block.settings.logo_scale | divided_by: 100.0 }};"
              {% if pass == 1 %}
                id="Block-{{ block.id }}" {{ block.shopify_attributes }}
              {% endif %}
            >
              {%- if block.settings.link != blank -%}
                <a
                  href="{{ block.settings.link }}"
                  class="zenith-logos__link"
                  target="_blank"
                  rel="noopener"
                  {% if pass > 1 %}
                    tabindex="-1"
                  {% endif %}
                >
              {%- endif -%}
              {%- if block.settings.logo != blank -%}
                {%- liquid
                  if pass > 1
                    assign logo_alt = ''
                  else
                    assign logo_alt = block.settings.logo.alt | default: block.settings.name
                  endif
                -%}
                {{
                  block.settings.logo
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', widths: '150, 300, 400', sizes: '200px', alt: logo_alt
                }}
              {%- else -%}
                <span class="zenith-logos__placeholder">{{ block.settings.name | default: 'Logo' | escape }}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Zenith · Logo strip",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Label",
      "default": "As seen on"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "default": "row",
      "options": [
        {
          "value": "row",
          "label": "Centered row"
        },
        {
          "value": "marquee",
          "label": "Scrolling marquee"
        }
      ]
    },
    {
      "type": "select",
      "id": "logo_align",
      "label": "Logo vertical alignment",
      "default": "bottom",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "info": "Tallest logo. Scale individual logos in their block settings.",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo max width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between logos",
      "min": 8,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between label and logos",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Marquee duration",
      "info": "Seconds for one full loop. Higher is slower.",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 30
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Logo color",
      "default": "white",
      "options": [
        {
          "value": "original",
          "label": "Original"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "grayscale",
          "label": "Grayscale"
        }
      ]
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_opacity",
      "label": "Label opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Label size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase label",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "marquee",
      "options": [
        {
          "value": "wrap",
          "label": "Wrap rows"
        },
        {
          "value": "scroll",
          "label": "Swipe row"
        },
        {
          "value": "marquee",
          "label": "Scrolling marquee"
        }
      ]
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between logos",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "label": "Space between label and logos",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Label size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "SVG or transparent PNG, cropped tight to the artwork"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Used as alt text",
          "default": "Publication"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "range",
          "id": "logo_scale",
          "label": "Logo size",
          "info": "Percent of the section's logo height. Use to balance logos of different shapes.",
          "min": 30,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 100
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith · Logo strip",
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "name": "Philippine Daily Inquirer",
            "logo_scale": 70
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "GMA"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "The Philippine Star",
            "logo_scale": 95
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "SunStar",
            "logo_scale": 65
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "Manila Standard",
            "logo_scale": 70
          }
        }
      ]
    }
  ]
}
{% endschema %}
