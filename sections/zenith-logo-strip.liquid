{{ 'zenith-logo-strip.css' | asset_url | stylesheet_tag }}
{%- capture extra -%}
  --z-logo-h: {{ section.settings.logo_height }}px;
  --z-logo-h-m: {{ section.settings.logo_height | times: 0.75 | round: 0 }}px;
{%- endcapture -%}
{%- render 'zenith-section-style', section: section, extra: extra -%}

<div
  id="Zenith-{{ section.id }}"
  class="zenith-section zenith-logos color-{{ section.settings.color_scheme }} gradient{% if section.settings.monochrome %} zenith-logos--mono{% endif %}"
>
  <div class="page-width zenith-logos__inner">
    {%- if section.settings.heading != blank -%}
      <p class="zenith-logos__heading">{{ section.settings.heading | escape }}</p>
    {%- endif -%}
    <ul class="zenith-logos__list zenith-logos__list--m-{{ section.settings.mobile_layout }}" role="list">
      {%- for block in section.blocks -%}
        <li class="zenith-logos__item" id="Block-{{ block.id }}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{%- endif -%}
          {%- if block.settings.logo != blank -%}
            {{
              block.settings.logo
              | image_url: width: 400
              | image_tag: loading: 'lazy', widths: '150, 300, 400', sizes: '200px', alt: block.settings.name
            }}
          {%- else -%}
            <span class="zenith-logos__placeholder">{{ block.settings.name | default: 'Logo' | escape }}</span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Zenith · Logo strip",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen on" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 16, "max": 80, "step": 2, "unit": "px", "default": 28 },

    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "monochrome", "label": "Show logos in monochrome", "default": true },

    { "type": "header", "content": "Mobile" },
    {
      "type": "select", "id": "mobile_layout", "label": "Mobile layout", "default": "wrap",
      "options": [ { "value": "wrap", "label": "Wrap rows" }, { "value": "scroll", "label": "Swipe row" } ]
    },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "header", "content": "Content" },
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "SVG or transparent PNG" },
        { "type": "text", "id": "name", "label": "Name", "info": "Used as alt text", "default": "Publication" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith · Logo strip",
      "blocks": [
        { "type": "logo", "settings": { "name": "Inquirer" } },
        { "type": "logo", "settings": { "name": "GMA" } },
        { "type": "logo", "settings": { "name": "Esquire" } },
        { "type": "logo", "settings": { "name": "SunStar" } },
        { "type": "logo", "settings": { "name": "Manila Bulletin" } }
      ]
    }
  ]
}
{% endschema %}
