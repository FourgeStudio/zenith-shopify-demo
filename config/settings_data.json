    "zg_col2_text": "<p>Every box has its own QR code. Scan it when it arrives to check it is a real Zenith product.</p>",
    "zg_col3_image": "shopify://shop_images/home-guarantee-courier-handing-parcel-1-desktop.webp",
    "zg_col3_icon": "badge_check_round",
    "zg_col3_text": "<p>Pay when it is in your hands, with nationwide Cash on Delivery.</p>",
    "zg_payment_icons": false,
    "zg_footer_text": "<p>Delivered by LBC, J&T, Gogo Express, Ninja Van and Amare Group's own riders.</p>",
